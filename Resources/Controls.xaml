<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MM4LB.Controls.Templates"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <!-- Tinted Image -->
    <Style TargetType="controls:TintedImage">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:TintedImage">
                    <Grid/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Separator -->
    <Style TargetType="controls:SeparatorEx">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="LineBrush" Value="{ThemeResource TextSecondaryColor}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SeparatorEx">
                    <Grid>
                        <Rectangle x:Name="LineElement" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Tracker.Controls.Views"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:template="using:Tracker.Controls.Templates"
    xmlns:i="using:Microsoft.Xaml.Interactivity">
    <!-- Estilo para los botones de tema -->
    <Style x:Key="Button_Theme" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource AccentBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource TextBrush}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" Padding="{TemplateBinding Padding}" FontSize="{TemplateBinding FontSize}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"               VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Target="Chrome.Background" Value="{ThemeResource AccentBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Chrome.Background" Value="{ThemeResource AccentLightBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Chrome.Background" Value="{ThemeResource AccentLightBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Chrome.Opacity" Value="0.75"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Estilo para los botones por defecto -->
    <Style x:Key="Button_Default" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource AccentBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource TextBrush}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" Padding="{TemplateBinding Padding}" FontSize="{TemplateBinding FontSize}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"               VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Target="Chrome.Background" Value="{ThemeResource CardBackgroundBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Chrome.Background" Value="{ThemeResource CardBackgroundLightBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Chrome.Background" Value="{ThemeResource CardBackgroundLightBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Chrome.Opacity" Value="0.75"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Recursos base reutilizables para todos los tipos de botón -->
    <!-- Normal state: Estado base: botón disponible, sin hover, sin press. -->
    <SolidColorBrush x:Key="ButtonBrushBackground" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBrushBackgroundSubtle" Color="{ThemeResource CardBackgroundLightColorOpacity60}" />
    <SolidColorBrush x:Key="ButtonBrushBorder" Color="{ThemeResource CardBackgroundLightColorOpacity60}" />
    <SolidColorBrush x:Key="ButtonBrushForeground" Color="{ThemeResource TextSecondaryColor}" />
    <!-- PointerOver state: Estado hover: el puntero está encima del botón. -->
    <SolidColorBrush x:Key="ButtonBrushBackgroundPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBrushBackgroundSubtlePointerOver" Color="{ThemeResource CardBackgroundLightColor}" />
    <SolidColorBrush x:Key="ButtonBrushBorderPointerOver" Color="{ThemeResource CardBackgroundLightColor}" />
    <SolidColorBrush x:Key="ButtonBrushForegroundPointerOver" Color="{ThemeResource AccentLightColor}" />
    <!-- Pressed state: Estado pulsado: feedback inmediato al hacer click/tap. -->
    <SolidColorBrush x:Key="ButtonBrushBackgroundPressed" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBrushBackgroundSubtlePressed" Color="{ThemeResource CardBackgroundLightColor}" />
    <SolidColorBrush x:Key="ButtonBrushBorderPressed" Color="{ThemeResource CardBackgroundLightColor}" />
    <SolidColorBrush x:Key="ButtonBrushForegroundPressed" Color="{ThemeResource AccentColor}" />
    <!-- Checked state: Estado seleccionado/activo para ToggleButton-like controls -->
    <SolidColorBrush x:Key="ButtonBrushBackgroundChecked" Color="{ThemeResource AccentDarkColor}" />
    <SolidColorBrush x:Key="ButtonBrushBorderChecked" Color="{ThemeResource AccentDarkColor}" />
    <SolidColorBrush x:Key="ButtonBrushForegroundChecked" Color="{ThemeResource TextColor}" />
    <!-- Checked + PointerOver state: Estado seleccionado con hover. -->
    <SolidColorBrush x:Key="ButtonBrushBackgroundCheckedPointerOver" Color="{ThemeResource AccentLightColorOpacity60}" />
    <SolidColorBrush x:Key="ButtonBrushBorderCheckedPointerOver" Color="{ThemeResource AccentLightColor}" />
    <SolidColorBrush x:Key="ButtonBrushForegroundCheckedPointerOver" Color="{ThemeResource TextColor}" />
    <!-- Checked + Pressed state: Estado seleccionado mientras se pulsa. -->
    <SolidColorBrush x:Key="ButtonBrushBackgroundCheckedPressed" Color="{ThemeResource AccentLightColor}" />
    <SolidColorBrush x:Key="ButtonBrushBorderCheckedPressed" Color="{ThemeResource AccentLightColor}" />
    <SolidColorBrush x:Key="ButtonBrushForegroundCheckedPressed" Color="{ThemeResource TextColor}" />
    <!-- Disabled state: Estado deshabilitado para botones no seleccionados. -->
    <SolidColorBrush x:Key="ButtonBrushBackgroundDisabled" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBrushBackgroundSubtleDisabled" Color="{ThemeResource CardBackgroundLightColor}" Opacity="0.35" />
    <SolidColorBrush x:Key="ButtonBrushBorderDisabled" Color="{ThemeResource CardBackgroundLightColor}" />
    <SolidColorBrush x:Key="ButtonBrushForegroundDisabled" Color="{ThemeResource TextSecondaryColor}" Opacity="0.4" />
    <!-- Checked + Disabled state: Estado seleccionado pero deshabilitado. -->
    <SolidColorBrush x:Key="ButtonBrushBackgroundCheckedDisabled" Color="{ThemeResource AccentDarkColor}" Opacity="0.45" />
    <SolidColorBrush x:Key="ButtonBrushBorderCheckedDisabled" Color="{ThemeResource AccentDarkColor}" Opacity="0.45" />
    <SolidColorBrush x:Key="ButtonBrushForegroundCheckedDisabled" Color="{ThemeResource TextColor}" Opacity="0.45" />

    <!-- Estilo para los ToggleSplitButton / SplitButton -->
    <Style TargetType="ToggleSplitButton">
        <Setter Property="Height" Value="36"/>
    </Style>
    <!-- Normal state -->
    <StaticResource x:Key="SplitButtonBackground" ResourceKey="ButtonBrushBackgroundSubtle" />
    <StaticResource x:Key="SplitButtonBorderBrush" ResourceKey="ButtonBrushBorder" />
    <StaticResource x:Key="SplitButtonForeground" ResourceKey="ButtonBrushForeground" />
    <!-- PointerOver state -->
    <StaticResource x:Key="SplitButtonBackgroundPointerOver" ResourceKey="ButtonBrushBackgroundSubtlePointerOver" />
    <StaticResource x:Key="SplitButtonBorderBrushPointerOver" ResourceKey="ButtonBrushBorderPointerOver" />
    <StaticResource x:Key="SplitButtonForegroundPointerOver" ResourceKey="ButtonBrushForegroundPointerOver" />
    <!-- Pressed state -->
    <StaticResource x:Key="SplitButtonBackgroundPressed" ResourceKey="ButtonBrushBackgroundSubtlePressed" />
    <StaticResource x:Key="SplitButtonBorderBrushPressed" ResourceKey="ButtonBrushBorderPressed" />
    <StaticResource x:Key="SplitButtonForegroundPressed" ResourceKey="ButtonBrushForegroundPressed" />
    <!-- Disabled state -->
    <StaticResource x:Key="SplitButtonBackgroundDisabled" ResourceKey="ButtonBrushBackgroundSubtleDisabled" />
    <StaticResource x:Key="SplitButtonBorderBrushDisabled" ResourceKey="ButtonBrushBorderDisabled" />
    <StaticResource x:Key="SplitButtonForegroundDisabled" ResourceKey="ButtonBrushForegroundDisabled" />
    <!-- Checked state -->
    <StaticResource x:Key="SplitButtonBackgroundChecked" ResourceKey="ButtonBrushBackgroundChecked" />
    <StaticResource x:Key="SplitButtonBorderBrushChecked" ResourceKey="ButtonBrushBorderChecked" />
    <StaticResource x:Key="SplitButtonForegroundChecked" ResourceKey="ButtonBrushForegroundChecked" />
    <!-- Checked + PointerOver state -->
    <StaticResource x:Key="SplitButtonBackgroundCheckedPointerOver" ResourceKey="ButtonBrushBackgroundCheckedPointerOver" />
    <StaticResource x:Key="SplitButtonBorderBrushCheckedPointerOver" ResourceKey="ButtonBrushBorderCheckedPointerOver" />
    <StaticResource x:Key="SplitButtonForegroundCheckedPointerOver" ResourceKey="ButtonBrushForegroundCheckedPointerOver" />
    <!-- Checked + Pressed state -->
    <StaticResource x:Key="SplitButtonBackgroundCheckedPressed" ResourceKey="ButtonBrushBackgroundCheckedPressed" />
    <StaticResource x:Key="SplitButtonBorderBrushCheckedPressed" ResourceKey="ButtonBrushBorderCheckedPressed" />
    <StaticResource x:Key="SplitButtonForegroundCheckedPressed" ResourceKey="ButtonBrushForegroundCheckedPressed" />
    <!-- Checked + Disabled state -->
    <StaticResource x:Key="SplitButtonBackgroundCheckedDisabled" ResourceKey="ButtonBrushBackgroundCheckedDisabled" />
    <StaticResource x:Key="SplitButtonBorderBrushCheckedDisabled" ResourceKey="ButtonBrushBorderCheckedDisabled" />
    <StaticResource x:Key="SplitButtonForegroundCheckedDisabled" ResourceKey="ButtonBrushForegroundCheckedDisabled" />

    <!-- Estilo para los AppBarButton: mismo fondo (normal/pointer-over/pressed/disabled) que el AppBarToggleButton
         (variantes "Subtle"), para que ambos compartan apariencia de fondo. -->
    <!-- Normal state -->
    <StaticResource x:Key="AppBarButtonBackground" ResourceKey="ButtonBrushBackgroundSubtle" />
    <StaticResource x:Key="AppBarButtonBorderBrush" ResourceKey="ButtonBrushBorder" />
    <StaticResource x:Key="AppBarButtonForeground" ResourceKey="ButtonBrushForeground" />
    <!-- PointerOver state -->
    <StaticResource x:Key="AppBarButtonBackgroundPointerOver" ResourceKey="ButtonBrushBackgroundSubtlePointerOver" />
    <StaticResource x:Key="AppBarButtonBorderBrushPointerOver" ResourceKey="ButtonBrushBorderPointerOver" />
    <StaticResource x:Key="AppBarButtonForegroundPointerOver" ResourceKey="ButtonBrushForegroundPointerOver" />
    <!-- Pressed state -->
    <StaticResource x:Key="AppBarButtonBackgroundPressed" ResourceKey="ButtonBrushBackgroundSubtlePressed" />
    <StaticResource x:Key="AppBarButtonBorderBrushPressed" ResourceKey="ButtonBrushBorderPressed" />
    <StaticResource x:Key="AppBarButtonForegroundPressed" ResourceKey="ButtonBrushForegroundPressed" />
    <!-- Disabled state -->
    <StaticResource x:Key="AppBarButtonBackgroundDisabled" ResourceKey="ButtonBrushBackgroundSubtleDisabled" />
    <StaticResource x:Key="AppBarButtonBorderBrushDisabled" ResourceKey="ButtonBrushBorderDisabled" />
    <StaticResource x:Key="AppBarButtonForegroundDisabled" ResourceKey="ButtonBrushForegroundDisabled" />
    
    <!-- Estilo para los AppBarToggleButton -->
    <!-- Normal state -->
    <StaticResource x:Key="AppBarToggleButtonBackground" ResourceKey="ButtonBrushBackgroundSubtle" />
    <StaticResource x:Key="AppBarToggleButtonBorderBrush" ResourceKey="ButtonBrushBorder" />
    <StaticResource x:Key="AppBarToggleButtonForeground" ResourceKey="ButtonBrushForeground" />
    <!-- PointerOver state -->
    <StaticResource x:Key="AppBarToggleButtonBackgroundPointerOver" ResourceKey="ButtonBrushBackgroundSubtlePointerOver" />
    <StaticResource x:Key="AppBarToggleButtonBorderBrushPointerOver" ResourceKey="ButtonBrushBorderPointerOver" />
    <StaticResource x:Key="AppBarToggleButtonForegroundPointerOver" ResourceKey="ButtonBrushForegroundPointerOver" />
    <!-- Pressed state -->
    <StaticResource x:Key="AppBarToggleButtonBackgroundPressed" ResourceKey="ButtonBrushBackgroundSubtlePressed" />
    <StaticResource x:Key="AppBarToggleButtonBorderBrushPressed" ResourceKey="ButtonBrushBorderPressed" />
    <StaticResource x:Key="AppBarToggleButtonForegroundPressed" ResourceKey="ButtonBrushForegroundPressed" />
    <!-- Disabled state -->
    <StaticResource x:Key="AppBarToggleButtonBackgroundDisabled" ResourceKey="ButtonBrushBackgroundSubtleDisabled" />
    <StaticResource x:Key="AppBarToggleButtonBorderBrushDisabled" ResourceKey="ButtonBrushBorderDisabled" />
    <StaticResource x:Key="AppBarToggleButtonForegroundDisabled" ResourceKey="ButtonBrushForegroundDisabled" />
    <!-- Checked state -->
    <StaticResource x:Key="AppBarToggleButtonBackgroundChecked" ResourceKey="ButtonBrushBackgroundChecked" />
    <StaticResource x:Key="AppBarToggleButtonBorderBrushChecked" ResourceKey="ButtonBrushBorderChecked" />
    <StaticResource x:Key="AppBarToggleButtonForegroundChecked" ResourceKey="ButtonBrushForegroundChecked" />
    <!-- Checked + PointerOver state -->
    <StaticResource x:Key="AppBarToggleButtonBackgroundCheckedPointerOver" ResourceKey="ButtonBrushBackgroundCheckedPointerOver" />
    <StaticResource x:Key="AppBarToggleButtonBorderBrushCheckedPointerOver" ResourceKey="ButtonBrushBorderCheckedPointerOver" />
    <StaticResource x:Key="AppBarToggleButtonForegroundCheckedPointerOver" ResourceKey="ButtonBrushForegroundCheckedPointerOver" />
    <!-- Checked + Pressed state -->
    <StaticResource x:Key="AppBarToggleButtonBackgroundCheckedPressed" ResourceKey="ButtonBrushBackgroundCheckedPressed" />
    <StaticResource x:Key="AppBarToggleButtonBorderBrushCheckedPressed" ResourceKey="ButtonBrushBorderCheckedPressed" />
    <StaticResource x:Key="AppBarToggleButtonForegroundCheckedPressed" ResourceKey="ButtonBrushForegroundCheckedPressed" />
    <!-- Checked + Disabled state -->
    <StaticResource x:Key="AppBarToggleButtonBackgroundCheckedDisabled" ResourceKey="ButtonBrushBackgroundCheckedDisabled" />
    <StaticResource x:Key="AppBarToggleButtonBorderBrushCheckedDisabled" ResourceKey="ButtonBrushBorderCheckedDisabled" />
    <StaticResource x:Key="AppBarToggleButtonForegroundCheckedDisabled" ResourceKey="ButtonBrushForegroundCheckedDisabled" />

    <!-- Estilo para los ToggleButton -->
    <!-- Normal state -->
    <StaticResource x:Key="ToggleButtonBackground" ResourceKey="ButtonBrushBackgroundSubtle" />
    <StaticResource x:Key="ToggleButtonBorderBrush" ResourceKey="ButtonBrushBorder" />
    <StaticResource x:Key="ToggleButtonForeground" ResourceKey="ButtonBrushForeground" />
    <!-- PointerOver state -->
    <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="ButtonBrushBackgroundSubtlePointerOver" />
    <StaticResource x:Key="ToggleButtonBorderBrushPointerOver" ResourceKey="ButtonBrushBorderPointerOver" />
    <StaticResource x:Key="ToggleButtonForegroundPointerOver" ResourceKey="ButtonBrushForegroundPointerOver" />
    <!-- Pressed state -->
    <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="ButtonBrushBackgroundSubtlePressed" />
    <StaticResource x:Key="ToggleButtonBorderBrushPressed" ResourceKey="ButtonBrushBorderPressed" />
    <StaticResource x:Key="ToggleButtonForegroundPressed" ResourceKey="ButtonBrushForegroundPressed" />
    <!-- Disabled state -->
    <StaticResource x:Key="ToggleButtonBackgroundDisabled" ResourceKey="ButtonBrushBackgroundSubtleDisabled" />
    <StaticResource x:Key="ToggleButtonBorderBrushDisabled" ResourceKey="ButtonBrushBorderDisabled" />
    <StaticResource x:Key="ToggleButtonForegroundDisabled" ResourceKey="ButtonBrushForegroundDisabled" />
    <!-- Checked state -->
    <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="ButtonBrushBackgroundChecked" />
    <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="ButtonBrushBorderChecked" />
    <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="ButtonBrushForegroundChecked" />
    <!-- Checked + PointerOver state -->
    <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="ButtonBrushBackgroundCheckedPointerOver" />
    <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="ButtonBrushBorderCheckedPointerOver" />
    <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="ButtonBrushForegroundCheckedPointerOver" />
    <!-- Checked + Pressed state -->
    <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="ButtonBrushBackgroundCheckedPressed" />
    <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="ButtonBrushBorderCheckedPressed" />
    <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="ButtonBrushForegroundCheckedPressed" />
    <!-- Checked + Disabled state -->
    <StaticResource x:Key="ToggleButtonBackgroundCheckedDisabled" ResourceKey="ButtonBrushBackgroundCheckedDisabled" />
    <StaticResource x:Key="ToggleButtonBorderBrushCheckedDisabled" ResourceKey="ButtonBrushBorderCheckedDisabled" />
    <StaticResource x:Key="ToggleButtonForegroundCheckedDisabled" ResourceKey="ButtonBrushForegroundCheckedDisabled" />

    <!-- Estilo para los RadioButton: solo sobrecarga de colores (sin tocar la plantilla). El texto usa el color
         del tema; el aro y el punto interior usan accent. Funciona dentro del AppDialog porque éste mergea
         Theme.xaml (donde está este Buttons.xaml) en sus propios recursos. -->
    <!-- Texto de la etiqueta -->
    <SolidColorBrush x:Key="RadioButtonForeground" Color="{ThemeResource TextColor}" />
    <SolidColorBrush x:Key="RadioButtonForegroundPointerOver" Color="{ThemeResource TextColor}" />
    <SolidColorBrush x:Key="RadioButtonForegroundPressed" Color="{ThemeResource TextColor}" />
    <SolidColorBrush x:Key="RadioButtonForegroundDisabled" Color="{ThemeResource TextColor}" Opacity="0.4" />
    <!-- Fondo / borde del control: transparente -->
    <SolidColorBrush x:Key="RadioButtonBackground" Color="Transparent" />
    <SolidColorBrush x:Key="RadioButtonBackgroundPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="RadioButtonBackgroundPressed" Color="Transparent" />
    <SolidColorBrush x:Key="RadioButtonBackgroundDisabled" Color="Transparent" />
    <SolidColorBrush x:Key="RadioButtonBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="RadioButtonBorderBrushPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="RadioButtonBorderBrushPressed" Color="Transparent" />
    <SolidColorBrush x:Key="RadioButtonBorderBrushDisabled" Color="Transparent" />
    <!-- Aro exterior, NO seleccionado -->
    <SolidColorBrush x:Key="RadioButtonOuterEllipseStroke" Color="{ThemeResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseStrokePointerOver" Color="{ThemeResource AccentLightColor}" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseStrokePressed" Color="{ThemeResource AccentColor}" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseStrokeDisabled" Color="{ThemeResource TextSecondaryColor}" Opacity="0.4" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseFill" Color="Transparent" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseFillPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseFillPressed" Color="Transparent" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseFillDisabled" Color="Transparent" />
    <!-- Aro exterior, SELECCIONADO -->
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="{ThemeResource AccentColor}" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" Color="{ThemeResource AccentLightColor}" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePressed" Color="{ThemeResource AccentLightColor}" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokeDisabled" Color="{ThemeResource AccentColor}" Opacity="0.4" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="Transparent" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPressed" Color="Transparent" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillDisabled" Color="Transparent" />
    <!-- Punto interior (check glyph) -->
    <SolidColorBrush x:Key="RadioButtonCheckGlyphFill" Color="{ThemeResource AccentColor}" />
    <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPointerOver" Color="{ThemeResource AccentLightColor}" />
    <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPressed" Color="{ThemeResource AccentLightColor}" />
    <SolidColorBrush x:Key="RadioButtonCheckGlyphFillDisabled" Color="{ThemeResource AccentColor}" Opacity="0.4" />
    <SolidColorBrush x:Key="RadioButtonCheckGlyphStroke" Color="{ThemeResource AccentColor}" />
    <SolidColorBrush x:Key="RadioButtonCheckGlyphStrokeChecked" Color="{ThemeResource AccentColor}" />
    <SolidColorBrush x:Key="RadioButtonCheckGlyphStrokeCheckedPointerOver" Color="{ThemeResource AccentLightColor}" />
    <SolidColorBrush x:Key="RadioButtonCheckGlyphStrokeCheckedPressed" Color="{ThemeResource AccentLightColor}" />
    <SolidColorBrush x:Key="RadioButtonCheckGlyphStrokeCheckedDisabled" Color="{ThemeResource AccentColor}" Opacity="0.4" />
    <SolidColorBrush x:Key="RadioButtonCheckGlyphStrokePointerOver" Color="{ThemeResource AccentLightColor}" />
    <SolidColorBrush x:Key="RadioButtonCheckGlyphStrokePressed" Color="{ThemeResource AccentLightColor}" />
    <SolidColorBrush x:Key="RadioButtonCheckGlyphStrokeDisabled" Color="{ThemeResource AccentColor}" Opacity="0.4" />

    <!-- ToolbarButtonIcon: Estilo para los botones de iconos -->
    <Style x:Key="ToolbarButtonIconStyle" TargetType="template:ToolbarButtonIcon">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Width" Value="64"/>
        <Setter Property="Height" Value="64"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="template:ToolbarButtonIcon">
                    <Grid x:Name="Root" Background="Transparent">
                        <Grid x:Name="IconHost" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <Image x:Name="SingleIcon" Source="{TemplateBinding Icon}" Stretch="Uniform" Opacity="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToOpacityConverter}}"/>
                            <Image x:Name="CheckedIcon" Source="{TemplateBinding CheckedIcon}" Stretch="Uniform" Opacity="0"/>
                            <Image x:Name="UncheckedIcon" Source="{TemplateBinding UncheckedIcon}" Stretch="Uniform" Opacity="0"/>
                        </Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Unchecked">
                                    <VisualState.Setters>
                                        <Setter Target="CheckedIcon.Opacity" Value="0"/>
                                        <Setter Target="UncheckedIcon.Opacity" Value="1"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="CheckedIcon.Opacity" Value="1"/>
                                        <Setter Target="UncheckedIcon.Opacity" Value="0"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ToolbarButtonIconSmallStyle" TargetType="template:ToolbarButtonIcon" BasedOn="{StaticResource ToolbarButtonIconStyle}">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
    </Style>
    <Style x:Key="ToolbarButtonIconMediumStyle" TargetType="template:ToolbarButtonIcon" BasedOn="{StaticResource ToolbarButtonIconStyle}">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
    </Style>
    <Style x:Key="ToolbarButtonIconLargeStyle" TargetType="template:ToolbarButtonIcon" BasedOn="{StaticResource ToolbarButtonIconStyle}">
        <Setter Property="Width" Value="120"/>
        <Setter Property="Height" Value="120"/>
    </Style>

    <!-- Botón de icono (ayuda, etc.). Style global reutilizable: Style="{StaticResource Button_Icon}". -->
    <Style x:Key="Button_Icon" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource ButtonBrushForeground}"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid">
                        <Border x:Name="Chrome" Background="{StaticResource ButtonBrushBackgroundSubtle}" BorderBrush="{StaticResource ButtonBrushBorder}" BorderThickness="1" CornerRadius="4">
                            <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" Padding="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Chrome.Background" Value="{StaticResource ButtonBrushBackgroundSubtlePointerOver}"/>
                                        <Setter Target="Chrome.BorderBrush" Value="{StaticResource ButtonBrushBorderPointerOver}"/>
                                        <Setter Target="ContentPresenter.Foreground" Value="{StaticResource ButtonBrushForegroundPointerOver}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Chrome.Background" Value="{StaticResource ButtonBrushBackgroundSubtlePressed}"/>
                                        <Setter Target="Chrome.BorderBrush" Value="{StaticResource ButtonBrushBorderPressed}"/>
                                        <Setter Target="ContentPresenter.Foreground" Value="{StaticResource ButtonBrushForegroundPressed}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Chrome.Background" Value="{StaticResource ButtonBrushBackgroundSubtleDisabled}"/>
                                        <Setter Target="Chrome.BorderBrush" Value="{StaticResource ButtonBrushBorderDisabled}"/>
                                        <Setter Target="ContentPresenter.Foreground" Value="{StaticResource ButtonBrushForegroundDisabled}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
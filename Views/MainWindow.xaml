<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MM4LB.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MM4LB"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="using:MM4LB.Controls.Views"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:controls="using:MM4LB.Controls.Views" 
    xmlns:template="using:MM4LB.Controls.Templates" xmlns:sys="using:System"
    xmlns:wv="using:Microsoft.UI.Xaml.Controls"
    xmlns:loc="using:MM4LB.Markup"
    xmlns:help="using:MM4LB.Helpers"
    mc:Ignorable="d"
    Title="MM4LB">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="{ThemeResource BackgroundBrush}">
        <template:TintedImage x:Name="TintedImage" Source="{ThemeResource OverlayImageUri}" Blur="{ThemeResource OverlayImageBlur}" TintColor="{ThemeResource AccentColor}" TintOpacity="{ThemeResource TintOpacity}" TintSaturation="{ThemeResource TintSaturation}" TintBrightness="{ThemeResource TintBrightness}" BlendMode="Hue" Opacity="{ThemeResource OverlayImageOpacity}"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="60" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Content area -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="450" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left column -->
                <Grid Grid.Column="0">
                    <Rectangle Fill="{ThemeResource BackgroundLightBrush}" Opacity="0.75"/>
                    <Border BorderThickness="0 0 1 0" BorderBrush="{ThemeResource CardBackgroundLightBrush}">
                        <Grid x:Name="colPlatformsAndGames">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition x:Name="rowPlatformList" Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Top" Padding="12 12 0 0">
                                <Image x:Name="AppLogoImage" Source="{ThemeResource LogoImage}" HorizontalAlignment="Left" Height="48"/>
                            </StackPanel>

                            <template:SeparatorEx Grid.Row="1" Margin="0 0 0 16" VerticalAlignment="Bottom" Thickness="2" UseGradient="True" LineBrush="{ThemeResource AccentBrush}" />

                            <uc:ProductListControl Grid.Row="2" x:Name="plProducts" ViewModel="{Binding ProductListViewModel}"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Center column -->
                <Grid Grid.Column="1">
                    <Rectangle Fill="{ThemeResource AccentLightBrush}" Opacity="0.1"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="64" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--Menu: nombre del producto seleccionado, con longitud limitada y recorte con puntos suspensivos. -->
                        <Grid Grid.Row="0" Grid.RowSpan="2">
                            <StackPanel Orientation="Horizontal" Padding="16">
                                <TextBlock Text="{Binding SharedDataService.SelectedProduct.Name}" Foreground="{ThemeResource AccentLightBrush}" FontSize="28" FontWeight="Bold"
                                           MaxWidth="900" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Top"/>
                            </StackPanel>
                        </Grid>

                        <!-- Widgets area -->
                        <Grid Grid.Row="0" Grid.RowSpan="2">
                            <uc:WidgetPanelControl x:Name="WidgetPanel" Layout="{Binding LayoutSelectorViewModel.SelectedLayout}" SplittersVisible="{Binding LayoutSelectorViewModel.SplittersVisible, Mode=OneWay}" SplittersEnabled="{Binding LayoutSelectorViewModel.SplittersEnabled, Mode=TwoWay}" Margin="{Binding LayoutSelectorViewModel.WidgetPanelMargin}">
                                <uc:WidgetBaseControl x:Name="ucConsoleWidget" Title="{loc:Str Key=MainWindow_ActivityLogWidget_Title}" WidgetCornerRadius="{Binding LayoutSelectorViewModel.WidgetCornerRadius, Mode=OneWay}">
                                    <uc:ConsoleControl x:Name="ucConsoleControl" ViewModel="{Binding ConsoleViewModel}"></uc:ConsoleControl>
                                </uc:WidgetBaseControl>
                                <uc:WidgetBaseControl x:Name="ucWebViewWidget" TitlePrefix="{loc:Str Key=MainWindow_WebSearchWidget_Title}" Title="{Binding WebViewViewModel.CurrentUrl}" WidgetCornerRadius="{Binding LayoutSelectorViewModel.WidgetCornerRadius, Mode=OneWay}">
                                    <uc:WebViewControl x:Name="ucWebViewControl" ViewModel="{Binding WebViewViewModel}"></uc:WebViewControl>
                                </uc:WidgetBaseControl>
                                <uc:WidgetBaseControl x:Name="ucProductsOverviewWidget" Title="{loc:Str Key=MainWindow_ProductsOverviewWidget_Title}" WidgetCornerRadius="{Binding LayoutSelectorViewModel.WidgetCornerRadius, Mode=OneWay}">
                                    <uc:ProductsOverviewControl x:Name="ucProductsOverviewControl" ViewModel="{Binding ProductsOverviewViewModel}"></uc:ProductsOverviewControl>
                                </uc:WidgetBaseControl>
                                <uc:WidgetBaseControl x:Name="ucFavoritesWidget" Title="{loc:Str Key=MainWindow_FavoritesWidget_Title}" WidgetCornerRadius="{Binding LayoutSelectorViewModel.WidgetCornerRadius, Mode=OneWay}">
                                    <uc:FavoritesControl x:Name="ucFavoritesControl" ViewModel="{Binding FavoritesViewModel}"></uc:FavoritesControl>
                                </uc:WidgetBaseControl>
                            </uc:WidgetPanelControl>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Progress Bar -->
            <Grid Grid.Row="1" Height="3">
                <Border Background="{ThemeResource CardBackgroundLightBrush}"/>
                <ProgressBar Value="{x:Bind ViewModel.ProgressService.ProgressValue, Mode=OneWay}" IsIndeterminate="{x:Bind ViewModel.ProgressService.ProgressIsIndeterminate, Mode=OneWay}" Background="Transparent" Foreground="{ThemeResource AccentBrush}" MinHeight="3" Visibility="{x:Bind ViewModel.ProgressService.ProgressVisibility, Mode=OneWay}"/>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="2" Padding="0 4">
                <Border BorderThickness="0 1 0 0" BorderBrush="{ThemeResource CardBackgroundLightBrush}">
                    <Grid Padding="4 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Visor del evento del log: solo cuando la consola NO está como widget visible (SlotIndex == -1).
                             Encapsulado en su propio control (FrameworkElement) para poder usar x:Bind con converters y la
                             animación de transición. ViewModel se pasa por Binding (DataContext del root = MainWindowViewModel). -->
                        <uc:FooterEventViewerControl Grid.Column="0" ViewModel="{Binding ConsoleViewModel}" Visibility="{Binding ConsoleViewModel.IsFooterViewerVisible, Converter={StaticResource VisibleIfTrueConverter}}"/>

                        <!-- Barra de herramientas del footer (a la derecha): tiempo hasta la próxima actualización
                             automática (justo antes de la toolbar), leyenda del eje, login, refrescar, añadir. -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch" HorizontalAlignment="Right" Margin="8 0 0 0">
                            <uc:SplitFlapClock x:Name="NextUpdateClock" VerticalAlignment="Center" Margin="8 0 12 0"
                                               help:Help.Key="Footer_NextUpdate_Tooltip"/>
                            
                            <!-- Toggles con estilo de botón normal (Button_Icon): el estado se indica por color del icono
                                 (acento = activo / atenuado = inactivo), con dos iconos superpuestos. El tooltip de este
                                 botón usa loc directo (no gateado) para seguir siendo descubrible con los tooltips apagados. -->
                            <Button x:Name="TooltipsToggle" Style="{StaticResource Button_Icon}" BorderThickness="0" Padding="10 0" VerticalAlignment="Stretch"
                                    Click="OnToggleTooltipsClick" ToolTipService.ToolTip="{loc:Str Key=Footer_Tooltips_Tooltip}">
                                <Grid>
                                    <FontIcon FontSize="18" Glyph="&#xE897;" Foreground="{ThemeResource AccentBrush}" Visibility="{Binding SharedDataService.HelpTooltipsEnabled, Converter={StaticResource VisibleIfTrueConverter}}"/>
                                    <FontIcon FontSize="18" Glyph="&#xE897;" Foreground="{ThemeResource TextSecondaryBrush}" Visibility="{Binding SharedDataService.HelpTooltipsEnabled, Converter={StaticResource HiddenIfTrueConverter}}"/>
                                </Grid>
                            </Button>
                            <template:SeparatorEx VerticalAlignment="Stretch" HorizontalAlignment="Center" Thickness="2" Margin="4 10" Orientation="Vertical" UseGradient="True" LineBrush="{ThemeResource AccentBrush}"/>
                            <Button x:Name="AxisLabelsToggle" Style="{StaticResource Button_Icon}" BorderThickness="0" Padding="10 0" VerticalAlignment="Stretch"
                                    Click="OnToggleAxisLabelsClick" help:Help.Key="Footer_AxisLabels_Tooltip">
                                <Grid>
                                    <FontIcon FontSize="18" Glyph="&#xE787;" Foreground="{ThemeResource AccentBrush}" Visibility="{Binding SharedDataService.ShowChartAxisLabels, Converter={StaticResource VisibleIfTrueConverter}}"/>
                                    <FontIcon FontSize="18" Glyph="&#xE787;" Foreground="{ThemeResource TextSecondaryBrush}" Visibility="{Binding SharedDataService.ShowChartAxisLabels, Converter={StaticResource HiddenIfTrueConverter}}"/>
                                </Grid>
                            </Button>
                            <!-- Incluir envío en el precio (acento = activo). -->
                            <Button x:Name="IncludeShippingToggle" Style="{StaticResource Button_Icon}" BorderThickness="0" Padding="10 0" VerticalAlignment="Stretch"
                                    Click="OnToggleIncludeShippingClick" help:Help.Key="Footer_IncludeShipping_Tooltip">
                                <Grid>
                                    <FontIcon FontSize="18" Glyph="&#xE7B8;" Foreground="{ThemeResource AccentBrush}" Visibility="{Binding SharedDataService.IncludeShippingInPrice, Converter={StaticResource VisibleIfTrueConverter}}"/>
                                    <FontIcon FontSize="18" Glyph="&#xE7B8;" Foreground="{ThemeResource TextSecondaryBrush}" Visibility="{Binding SharedDataService.IncludeShippingInPrice, Converter={StaticResource HiddenIfTrueConverter}}"/>
                                </Grid>
                            </Button>
                            <!-- Mostrar/ocultar productos comprados (acento = mostrando). -->
                            <Button x:Name="ShowPurchasedToggle" Style="{StaticResource Button_Icon}" BorderThickness="0" Padding="10 0" VerticalAlignment="Stretch"
                                    Click="OnTogglePurchasedClick" help:Help.Key="Footer_ShowPurchased_Tooltip">
                                <Grid>
                                    <FontIcon FontSize="18" Glyph="&#xE7BF;" Foreground="{ThemeResource AccentBrush}" Visibility="{Binding SharedDataService.ShowPurchased, Converter={StaticResource VisibleIfTrueConverter}}"/>
                                    <FontIcon FontSize="18" Glyph="&#xE7BF;" Foreground="{ThemeResource TextSecondaryBrush}" Visibility="{Binding SharedDataService.ShowPurchased, Converter={StaticResource HiddenIfTrueConverter}}"/>
                                </Grid>
                            </Button>
                            <template:SeparatorEx VerticalAlignment="Stretch" HorizontalAlignment="Center" Thickness="2" Margin="4 10" Orientation="Vertical" UseGradient="True" LineBrush="{ThemeResource AccentBrush}"/>
                            <!-- Login/logout (no es toggle-control, pero el icono va en acento si hay sesión; lo fija el code-behind). -->
                            <Button x:Name="AmazonAuthButton" Style="{StaticResource Button_Icon}" BorderThickness="0" Padding="10 0" VerticalAlignment="Stretch" Click="OnAmazonAuthClick">
                                <FontIcon x:Name="AmazonAuthIcon" FontSize="18" Glyph="&#xE77B;" Foreground="{ThemeResource TextSecondaryBrush}"/>
                            </Button>
                            <template:SeparatorEx VerticalAlignment="Stretch" HorizontalAlignment="Center" Thickness="2" Margin="4 10" Orientation="Vertical" UseGradient="True" LineBrush="{ThemeResource AccentBrush}"/>
                            <!-- Acciones (no toggles): icono en color normal. -->
                            <!-- El tooltip (base + fecha del último refresco) lo gestiona el code-behind, gateado por el toggle de tooltips. -->
                            <Button x:Name="RefreshAllButton" Style="{StaticResource Button_Icon}" BorderThickness="0" Padding="10 0" VerticalAlignment="Stretch" Click="OnRefreshAllClick">
                                <FontIcon FontSize="18" Glyph="&#xE72C;" Foreground="{ThemeResource TextSecondaryBrush}"/>
                            </Button>
                            <template:SeparatorEx VerticalAlignment="Stretch" HorizontalAlignment="Center" Thickness="2" Margin="4 10" Orientation="Vertical" UseGradient="True" LineBrush="{ThemeResource AccentBrush}"/>
                            <Button x:Name="AddProductButton" Style="{StaticResource Button_Icon}" BorderThickness="0" Padding="10 0" VerticalAlignment="Stretch" Click="OnAddProductClick" help:Help.Key="Footer_AddProduct_Tooltip">
                                <FontIcon FontSize="18" Glyph="&#xE710;" Foreground="{ThemeResource TextSecondaryBrush}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Toolbar -->
        <Grid>
            <Border x:Name="ucToolbarHoverZone" Height="32" VerticalAlignment="Top" Margin="140 8" Background="Transparent"/>
            <uc:ToolbarControl x:Name="ucToolbar" TogglesDisabled="{Binding IsAnimating, Mode=OneWay}" SplittersEnabled="{Binding LayoutSelectorViewModel.SplittersEnabled, Mode=TwoWay}">
                <UserControl.RenderTransform>
                    <TranslateTransform x:Name="ucToolbarTransform" Y="-140"/>
                </UserControl.RenderTransform>
            </uc:ToolbarControl>
        </Grid>

        <!-- Marca de compilación (diagnóstico): overlay superpuesto arriba a la derecha, dibujado el ÚLTIMO para que
             no lo tape ninguna capa (widgets, toolbar, etc.). El texto lo fija MainWindow.xaml.cs con la fecha del
             ensamblado. IsHitTestVisible=False para no bloquear clics. -->
        <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0 10 440 0" Padding="10 4"
                Background="{ThemeResource CardBackgroundLightBrush}" CornerRadius="8" IsHitTestVisible="False">
            <TextBlock x:Name="BuildTimestampText" Foreground="{ThemeResource TextColor}" FontSize="14" Opacity="0.85"/>
        </Border>

        <!-- Navegador oculto para el scraping de precios (ProductParsingService): fuera de la vista (1x1, opacidad 0,
             sin hit-test). Se navega e inyecta JS por código; no participa en la UI. -->
        <wv:WebView2 x:Name="ScraperWebView" Width="1" Height="1" Opacity="0" IsHitTestVisible="False"
                     HorizontalAlignment="Left" VerticalAlignment="Top"/>
    </Grid>
</Window>
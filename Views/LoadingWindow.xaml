<Window
    x:Class="MM4LB.Views.LoadingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:controls="using:MM4LB.Controls.Views"
    xmlns:template="using:MM4LB.Controls.Templates"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <!-- Trazo del marco: degradado diagonal con los tres acentos del tema. Los GradientStop necesitan Color,
                 así que se usan los recursos de color (equivalen a AccentBrush / AccentLightBrush / AccentDarkBrush). -->
            <LinearGradientBrush x:Key="FrameStrokeBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{ThemeResource AccentColor}" Offset="0"/>
                <GradientStop Color="{ThemeResource AccentLightColor}" Offset="0.5"/>
                <GradientStop Color="{ThemeResource AccentDarkColor}" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Resources>

        <Image Source="{Binding ImageUri}" Visibility="{Binding UseTintedImage, Converter={StaticResource HiddenIfTrueConverter}}">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="1.017" ScaleY="1.017"/>
                    <TranslateTransform X="-12" Y="-3"/>
                </TransformGroup>
            </Image.RenderTransform>
        </Image>

        <template:TintedImage x:Name="TintedImage" Source="{Binding ImageUri}" TintColor="{ThemeResource AccentColor}" TintOpacity="{ThemeResource TintOpacity}" TintSaturation="{ThemeResource TintSaturation}" TintBrightness="{ThemeResource TintBrightness}" BlendMode="Hue" Visibility="{Binding UseTintedImage, Converter={StaticResource VisibleIfTrueConverter}}">
            <template:TintedImage.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="1.006" ScaleY="1.009"/>
                    <TranslateTransform X="-2" Y="0"/>
                </TransformGroup>
            </template:TintedImage.RenderTransform>
        </template:TintedImage>

        <!-- Marco de neón del splash (sustituye a las PNG con el borde quemado). La geometría se construye en el
             code-behind con el contorno EXACTO de la región (mismo MM4LB-Splash-Screen.bin que SetWindowRgn),
             transformado de coords de VENTANA física a coords de CLIENTE (DIP) con las métricas reales; la propia
             región recorta el sobrante del trazo, dejándolo a ras. Color = acento del tema. Se muestra según el ajuste
             BackgroundImageFramed (bool). -->
        <Canvas IsHitTestVisible="False" Visibility="{Binding ShowFrameBorder, Converter={StaticResource VisibleIfTrueConverter}}">
            <Path x:Name="FrameGlow" Stroke="{StaticResource FrameStrokeBrush}" StrokeThickness="16" Opacity="0.30" StrokeLineJoin="Round"/>
            <Path x:Name="FrameLine" Stroke="{StaticResource FrameStrokeBrush}" StrokeThickness="5" StrokeLineJoin="Round"/>
        </Canvas>

        <Grid HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,140" Width="940">
            <Border CornerRadius="6" Padding="0 1 0 0">
                <Border.Background>
                    <SolidColorBrush Color="{ThemeResource BackgroundLightColorOpacity80}"/>
                </Border.Background>
                <Border.BorderThickness>2 1 1 2</Border.BorderThickness>
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="{ThemeResource AccentDarkColorOpacity80}" Offset="0"/>
                        <GradientStop Color="{ThemeResource AccentColorOpacity80}" Offset="0.5"/>
                        <GradientStop Color="{ThemeResource AccentLightColorOpacity80}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center" Spacing="30" Padding="20,16">
                    <TextBlock Text="{Binding ProgressService.ProgressMessage, Mode=OneWay}" Foreground="{ThemeResource AccentBrush}" FontSize="24" FontWeight="Bold" TextTrimming="CharacterEllipsis" Translation="0,0,16" Margin="0,0,0,-20"/>
                    <Border CornerRadius="6" Padding="0 1 0 0">
                                <Border.Background>
                                    <SolidColorBrush Color="{ThemeResource AccentDarkColor}" Opacity="0.5"/>
                                </Border.Background>
                                <Border.BorderThickness>2 1 1 2</Border.BorderThickness>
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="{ThemeResource AccentDarkColorOpacity80}" Offset="0"/>
                                        <GradientStop Color="{ThemeResource AccentColorOpacity80}" Offset="0.5"/>
                                        <GradientStop Color="{ThemeResource AccentLightColorOpacity80}" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <Grid>
                                    <ProgressBar Value="{Binding ProgressService.ProgressValue, Mode=OneWay}" IsIndeterminate="{Binding ProgressService.ProgressIsIndeterminate, Mode=OneWay}" Minimum="0" Maximum="100" Background="Transparent" Foreground="{ThemeResource AccentBrush}" MinHeight="30"/>
                                </Grid>
                            </Border>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="FadeOverlay" Background="Black" Opacity="1" IsHitTestVisible="False"/>
    </Grid>
</Window>
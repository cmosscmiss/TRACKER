<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Tracker.Controls.Dialogs.SettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="using:Tracker.Controls.Views"
    xmlns:helpers="using:Tracker.Helpers"
    xmlns:loc="using:Tracker.Markup"
    mc:Ignorable="d">

    <!-- El diálogo se muestra en un Popup; los converters globales de App.xaml no siempre se alcanzan desde ahí, así
         que se declara localmente el que usa este contenido. -->
    <UserControl.Resources>
        <helpers:BooleanToVisibilityConverter x:Key="VisibleIfTrueConverter"/>
    </UserControl.Resources>

    <!-- Contenido de la ventana de configuración. -->
    <Grid Width="806" Height="460">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Columna izquierda: lista de categorías. -->
        <ListView x:Name="SectionsList" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection, Mode=TwoWay}" SelectionMode="Single">
            <ListView.ItemContainerStyle>
                <!-- Plantilla PROPIA en vez de los brushes con nombre (ListViewItemBackgroundSelected…) sobre la del
                     sistema: así el fondo y el color del texto se fijan juntos en cada estado, que es lo que hace
                     falta para el texto por contraste (el item seleccionado se pinta con el acento, ver
                     docs/Plan-Contraste-Texto.md). Con los brushes con nombre el fondo sí cambiaba, pero el contenido
                     seguía con el color de texto normal. Mismo patrón que ListViewItemDefaultStyle en
                     Resources/GenericControls.xaml. -->
                <Style TargetType="ListViewItem">
                    <Setter Property="Margin" Value="0 -6 0 0"/>
                    <Setter Property="Padding" Value="16 14"/>
                    <Setter Property="MinHeight" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <Border x:Name="RootGrid" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter x:Name="ContentHost" Foreground="{ThemeResource TextBrush}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal"/>
                                            <VisualState x:Name="PointerOver">
                                                <VisualState.Setters>
                                                    <Setter Target="RootGrid.Background" Value="{ThemeResource AccentLightBrush}"/>
                                                    <Setter Target="ContentHost.Foreground" Value="{ThemeResource TextOnAccentLightBrush}"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <VisualState.Setters>
                                                    <Setter Target="RootGrid.Background" Value="{ThemeResource AccentLightBrush}"/>
                                                    <Setter Target="ContentHost.Foreground" Value="{ThemeResource TextOnAccentLightBrush}"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Selected">
                                                <VisualState.Setters>
                                                    <Setter Target="RootGrid.Background" Value="{ThemeResource AccentBrush}"/>
                                                    <Setter Target="ContentHost.Foreground" Value="{ThemeResource TextOnAccentBrush}"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="PointerOverSelected">
                                                <VisualState.Setters>
                                                    <Setter Target="RootGrid.Background" Value="{ThemeResource AccentLightBrush}"/>
                                                    <Setter Target="ContentHost.Foreground" Value="{ThemeResource TextOnAccentLightBrush}"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="PressedSelected">
                                                <VisualState.Setters>
                                                    <Setter Target="RootGrid.Background" Value="{ThemeResource AccentLightBrush}"/>
                                                    <Setter Target="ContentHost.Foreground" Value="{ThemeResource TextOnAccentLightBrush}"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Title}" FontSize="15"/>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Columna derecha: cabecera de la categoría + página de opciones. -->
        <Border Grid.Column="1" Margin="-5 0 0 0" CornerRadius="0 4 4 4" BorderThickness="2" BorderBrush="{ThemeResource AccentBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="1" Padding="16" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <uc:GeneralSettingsControl Visibility="{Binding IsGeneral, Converter={StaticResource VisibleIfTrueConverter}}"/>
                        <uc:ThemeSettingsControl Visibility="{Binding IsTheme, Converter={StaticResource VisibleIfTrueConverter}}"/>
                        <uc:AboutSettingsControl Visibility="{Binding IsAbout, Converter={StaticResource VisibleIfTrueConverter}}"/>
                        <TextBlock Text="{loc:Str Key=DialogsSettingsControl_Placeholder_Text}" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" Visibility="{Binding IsPlaceholder, Converter={StaticResource VisibleIfTrueConverter}}"/>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MM4LB.Controls.Dialogs.SettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="using:MM4LB.Controls.Views"
    xmlns:helpers="using:MM4LB.Helpers"
    xmlns:loc="using:MM4LB.Markup"
    mc:Ignorable="d">

    <!-- El diálogo se muestra en un Popup; los converters globales de App.xaml no siempre se alcanzan desde ahí, así
         que se declara localmente el que usa este contenido. -->
    <UserControl.Resources>
        <helpers:BooleanToVisibilityConverter x:Key="VisibleIfTrueConverter"/>
    </UserControl.Resources>

    <!-- Contenido de la ventana de configuración (dentro del AppDialog, que aporta cabecera con logo y botones
         OK/Apply/Cancel). 2 columnas: categorías (izq) + opciones de la categoría (der). -->
    <Grid Width="806" Height="460" ColumnDefinitions="190, *">

        <!-- Columna izquierda: lista de categorías. Los ítems reproducen el aspecto de las OPCIONES de un ComboBox
             (hover = AccentLight, seleccionado = Accent, texto = Text), reusando los mismos colores que ComboBoxItem*
             mediante override de los brushes de ListViewItem en el ámbito de este ListView. Se oculta el "pill" de
             selección para que el seleccionado sea un relleno completo, como en el desplegable. -->
        <Border Grid.Column="0" CornerRadius="4" Background="{ThemeResource CardBackgroundBrush}">
            <ListView ItemsSource="{Binding Sections}"
                      SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                      Background="Transparent" SelectionMode="Single">
                <ListView.Resources>
                    <SolidColorBrush x:Key="ListViewItemBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="{ThemeResource AccentLightColor}"/>
                    <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="{ThemeResource AccentLightColor}"/>
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{ThemeResource AccentColor}"/>
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{ThemeResource AccentLightColor}"/>
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="{ThemeResource AccentLightColor}"/>
                    <SolidColorBrush x:Key="ListViewItemForeground" Color="{ThemeResource TextColor}"/>
                    <SolidColorBrush x:Key="ListViewItemForegroundPointerOver" Color="{ThemeResource TextColor}"/>
                    <SolidColorBrush x:Key="ListViewItemForegroundPressed" Color="{ThemeResource TextColor}"/>
                    <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="{ThemeResource TextColor}"/>
                    <SolidColorBrush x:Key="ListViewItemForegroundSelectedPointerOver" Color="{ThemeResource TextColor}"/>
                    <SolidColorBrush x:Key="ListViewItemForegroundSelectedPressed" Color="{ThemeResource TextColor}"/>
                    <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
                </ListView.Resources>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Margin" Value="2 1"/>
                        <Setter Property="Padding" Value="10 6"/>
                        <Setter Property="MinHeight" Value="0"/>
                        <Setter Property="CornerRadius" Value="4"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" FontSize="15"/>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Columna derecha: cabecera de la categoría + página de opciones. -->
        <Border Grid.Column="1" CornerRadius="4" Margin="8 0 0 0" Background="{ThemeResource CardBackgroundBrush}">
            <Grid RowDefinitions="Auto, *">
                <Border Grid.Row="0" Background="{ThemeResource BackgroundLightBrush}" CornerRadius="4 4 0 0" Padding="12 8">
                    <TextBlock Text="{Binding SelectedSection.Title}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource AccentLightBrush}"/>
                </Border>

                <ScrollViewer Grid.Row="1" Padding="16" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <uc:GeneralSettingsControl Visibility="{Binding IsGeneral, Converter={StaticResource VisibleIfTrueConverter}}"/>
                        <uc:ThemeSettingsControl Visibility="{Binding IsTheme, Converter={StaticResource VisibleIfTrueConverter}}"/>
                        <uc:AboutSettingsControl Visibility="{Binding IsAbout, Converter={StaticResource VisibleIfTrueConverter}}"/>
                        <TextBlock Text="{loc:Str Key=DialogsSettingsControl_Placeholder_Text}" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap"
                                   Visibility="{Binding IsPlaceholder, Converter={StaticResource VisibleIfTrueConverter}}"/>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>

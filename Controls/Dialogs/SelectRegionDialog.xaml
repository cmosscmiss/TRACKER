<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MM4LB.Controls.Dialogs.SelectRegionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MM4LB.Controls.Dialogs"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:loc="using:MM4LB.Markup"
    mc:Ignorable="d">

    <StackPanel Spacing="12" MinWidth="320">
        <TextBlock Text="{loc:Str Key=SelectRegionDialog_Prompt_Text}" TextWrapping="Wrap"/>
        <ComboBox x:Name="cbRegion" HorizontalAlignment="Stretch" DisplayMemberPath="Label"/>
    </StackPanel>
</Page>

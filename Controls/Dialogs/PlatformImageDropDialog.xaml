<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MM4LB.Controls.Dialogs.PlatformImageDropDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MM4LB.Controls.Dialogs"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:loc="using:MM4LB.Markup"
    mc:Ignorable="d">

    <StackPanel Spacing="12" MinWidth="320">
        <StackPanel Spacing="4">
            <TextBlock Text="{loc:Str Key=PlatformImageDropDialog_TypeLabel}"/>
            <!-- Sin selección por defecto: el usuario debe elegir el tipo (habilita el botón Add). -->
            <ComboBox x:Name="cbType" HorizontalAlignment="Stretch" PlaceholderText="{loc:Str Key=PlatformImageDropDialog_SelectType_Placeholder}"
                      DisplayMemberPath="Value" SelectionChanged="OnTypeSelectionChanged"/>
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="{loc:Str Key=PlatformImageDropDialog_ExistingImages_Label}"/>
            <!-- Índice 0 = Discard (reemplazar todas), 1 = Keep (añadir). -->
            <RadioButtons x:Name="rbExisting" SelectedIndex="1" MaxColumns="2">
                <RadioButton Content="{loc:Str Key=Common_Discard_Label}"/>
                <RadioButton Content="{loc:Str Key=Common_Keep_Label}"/>
            </RadioButtons>
        </StackPanel>
    </StackPanel>
</Page>

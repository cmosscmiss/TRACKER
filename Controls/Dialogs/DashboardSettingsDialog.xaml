<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MM4LB.Controls.Dialogs.DashboardSettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogs="using:MM4LB.Controls.Dialogs"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:loc="using:MM4LB.Markup"
    xmlns:help="using:MM4LB.Helpers"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="CriterionRowTemplate" x:DataType="dialogs:SettingsCriterionRow">
            <Grid Margin="0 2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" MinWidth="0" IsChecked="{x:Bind IsActive, Mode=TwoWay}"
                          help:Help.Key="DashboardSettingsDialog_ApplyCriterion_Tooltip"/>
                <TextBlock Grid.Column="1" Text="{x:Bind Label}" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" DisplayMemberPath="Value"
                          ItemsSource="{x:Bind Options}"
                          Loaded="CriterionCombo_Loaded" SelectionChanged="CriterionCombo_SelectionChanged"/>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <StackPanel Spacing="16" MinWidth="360">
        <StackPanel Spacing="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:Str Key=DashboardSettingsDialog_Preselection_Title}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Grid.Column="1" x:Name="PreselectionHelpButton" Style="{StaticResource Button_Icon}" Click="PreselectionHelp_Click" Padding="6" help:Help.AffordanceVisible="True" help:Help.Key="Common_Help_Tooltip">
                    <FontIcon Glyph="&#xE897;" FontSize="16"/>
                </Button>
                <TeachingTip Grid.Column="1" x:Name="PreselectionHelpTip" Target="{x:Bind PreselectionHelpButton}" IsLightDismissEnabled="True" PreferredPlacement="BottomLeft"
                             Title="{loc:Str Key=DashboardSettingsDialog_Preselection_Title}"
                             Subtitle="{loc:Str Key=DashboardSettingsDialog_Preselection_Description}"/>
            </Grid>
            <ItemsControl x:Name="icSelection" ItemTemplate="{StaticResource CriterionRowTemplate}" Margin="0 4 0 0"/>
        </StackPanel>

        <StackPanel Spacing="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:Str Key=DashboardSettingsDialog_Processing_Title}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Grid.Column="1" x:Name="ProcessingHelpButton" Style="{StaticResource Button_Icon}" Click="ProcessingHelp_Click" Padding="6" help:Help.AffordanceVisible="True" help:Help.Key="Common_Help_Tooltip">
                    <FontIcon Glyph="&#xE897;" FontSize="16"/>
                </Button>
                <TeachingTip Grid.Column="1" x:Name="ProcessingHelpTip" Target="{x:Bind ProcessingHelpButton}" IsLightDismissEnabled="True" PreferredPlacement="BottomLeft"
                             Title="{loc:Str Key=DashboardSettingsDialog_Processing_Title}"
                             Subtitle="{loc:Str Key=DashboardSettingsDialog_Processing_Description}"/>
            </Grid>
            <ItemsControl x:Name="icProcessing" ItemTemplate="{StaticResource CriterionRowTemplate}" Margin="0 4 0 0"/>
        </StackPanel>
    </StackPanel>
</Page>

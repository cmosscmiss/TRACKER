<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MM4LB.Controls.Views.GameDetailsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:template="using:MM4LB.Controls.Templates"
    xmlns:uc="using:MM4LB.Controls.Views"
    xmlns:loc="using:MM4LB.Markup"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Cabecera de cada grupo, igual que en SettingsControl (acento, mayúsculas y espaciado de caracteres). -->
        <Style x:Key="GroupHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource AccentBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CharacterSpacing" Value="120" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Rectangle Fill="{ThemeResource BackgroundLightBrush}" Opacity="0.75"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Flag: indica si el juego está o no en la base de datos de metadatos de LaunchBox. Solo visible
                 cuando hay un juego seleccionado (HasDetails). -->
            <Grid Grid.Row="0" Padding="24 12 24 0"
                  Visibility="{x:Bind ViewModel.HasDetails, Mode=OneWay, Converter={StaticResource VisibleIfTrueConverter}}">
                <!-- En la BBDD -->
                <Border HorizontalAlignment="Left" CornerRadius="12" Padding="10 4" BorderThickness="1"
                        BorderBrush="{ThemeResource AccentBrush}" Background="{ThemeResource AccentDarkBrushOpacity40}"
                        Visibility="{x:Bind ViewModel.IsInLaunchBoxDb, Mode=OneWay, Converter={StaticResource VisibleIfTrueConverter}}">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource AccentBrush}"/>
                        <TextBlock Text="{loc:Str Key=GameDetails_InLaunchBox_Label}" FontSize="12" Foreground="{ThemeResource TextBrush}"/>
                    </StackPanel>
                </Border>
                <!-- No está en la BBDD -->
                <Border HorizontalAlignment="Left" CornerRadius="12" Padding="10 4" BorderThickness="1"
                        BorderBrush="{ThemeResource TextBrushOpacity20}" Background="Transparent"
                        Visibility="{x:Bind ViewModel.IsInLaunchBoxDb, Mode=OneWay, Converter={StaticResource HiddenIfTrueConverter}}">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{ThemeResource TextSecondaryBrush}"/>
                        <TextBlock Text="{loc:Str Key=GameDetails_NotInLaunchBox_Label}" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Ficha del juego: grupos apilados, cada uno con cabecera y filas etiqueta/valor, todo en un ScrollViewer. -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" Padding="24 12 24 16">
            <ItemsControl ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <!-- Binding clásico (no x:Bind): x:DataType no referencia los tipos anidados GameDetails.Group /
                         GameDetails.Field, y el binding por reflexión es trivial para unas pocas filas. -->
                    <DataTemplate>
                        <StackPanel Margin="0 0 0 16">
                            <TextBlock Text="{Binding Header}" Style="{StaticResource GroupHeaderStyle}"/>
                            <template:SeparatorEx Margin="0 4 0 0" HorizontalAlignment="Stretch" Thickness="2" UseGradient="True" LineBrush="{ThemeResource AccentBrush}"/>
                            <ItemsControl ItemsSource="{Binding Fields}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0 8 0 0">
                                            <StackPanel Padding="20 0">
                                                <TextBlock Text="{Binding Label}" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="13" FontWeight="SemiBold"/>
                                                <!-- Valor de texto (oculto cuando la fila es un rating). -->
                                                <TextBlock Text="{Binding Value}" Foreground="{ThemeResource TextBrush}" FontSize="15" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                           Visibility="{Binding IsRating, Converter={StaticResource HiddenIfTrueConverter}}"/>
                                                <!-- Rating: 5 estrellas rellenas a la nota + la nota numérica. -->
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                                            Visibility="{Binding IsRating, Converter={StaticResource VisibleIfTrueConverter}}">
                                                    <RatingControl Value="{Binding RatingValue}" MaxRating="5" IsReadOnly="True" VerticalAlignment="Center">
                                                        <RatingControl.Resources>
                                                            <!-- Estrellas rellenas con el acento del tema (interactivo y solo-lectura). -->
                                                            <StaticResource x:Key="RatingControlSelectedForeground" ResourceKey="AccentLightBrush"/>
                                                            <StaticResource x:Key="RatingControlPlaceholderForeground" ResourceKey="AccentLightBrush"/>
                                                            <StaticResource x:Key="RatingControlSelectedDisabledForeground" ResourceKey="AccentLightBrush"/>
                                                            <StaticResource x:Key="RatingControlDisabledSelectedForeground" ResourceKey="AccentLightBrush"/>
                                                            <!-- Estrellas vacías en un tono de acento atenuado. -->
                                                            <StaticResource x:Key="RatingControlUnselectedForeground" ResourceKey="AccentBrush"/>
                                                        </RatingControl.Resources>
                                                    </RatingControl>
                                                    <TextBlock Text="{Binding Value}" Foreground="{ThemeResource TextBrush}" FontSize="15" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <template:SeparatorEx Margin="0 8 0 0" Thickness="1" UseGradient="True" Visibility="{Binding ShowSeparator, Converter={StaticResource VisibleIfTrueConverter}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>

            <!-- Resumen en pills (mismo patrón que Media Audit): imágenes conocidas en la BBDD. Solo si hay alguna. -->
            <uc:WidgetStatCardControl Grid.Row="2" Margin="24 8 24 12" VisualStyle="SplitPanel" ColorVariant="ThemeAccent"
                                      Glyph="&#xE91B;" IconCollapsePillCount="2"
                                      Visibility="{x:Bind ViewModel.HasKnownImages, Mode=OneWay, Converter={StaticResource VisibleIfTrueConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <uc:WidgetStatCardControl Grid.Column="0" VisualStyle="SplitPanel" ColorVariant="ThemeAccent" HasBorder="False"
                                              Label="{loc:Str Key=GameDetails_KnownImages_Label}" Value="{x:Bind ViewModel.KnownImagesTotal, Mode=OneWay}" Description="{loc:Str Key=GameDetails_KnownImages_Description}"/>
                    <uc:WidgetStatCardControl Grid.Column="1" VisualStyle="SplitPanel" ColorVariant="ThemeAccent" HasBorder="False"
                                              Label="{loc:Str Key=GameDetails_MediaTypes_Label}" Value="{x:Bind ViewModel.KnownImageTypeCount, Mode=OneWay}" Description="{loc:Str Key=GameDetails_MediaTypes_Description}"/>
                </Grid>
            </uc:WidgetStatCardControl>
        </Grid>

        <!-- Estado vacío: sin juego seleccionado (o sin ficha). -->
        <TextBlock Text="{loc:Str Key=GameDetails_Empty_Text}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{ThemeResource TextSecondaryBrush}" FontSize="15"
                   Visibility="{x:Bind ViewModel.HasDetails, Mode=OneWay, Converter={StaticResource HiddenIfTrueConverter}}"/>
    </Grid>
</UserControl>

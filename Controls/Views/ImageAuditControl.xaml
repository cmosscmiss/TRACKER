<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MM4LB.Controls.Views.ImageAuditControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MM4LB.Controls.Views"
    xmlns:uc="using:MM4LB.Controls.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="using:System"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:template="using:MM4LB.Controls.Templates"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    xmlns:loc="using:MM4LB.Markup"
    xmlns:help="using:MM4LB.Helpers"
    xmlns:helpers="using:MM4LB.Helpers"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>            
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Toolbar of the control -->
        <uc:AdaptiveToolbarPanel>
            <AppBarToggleButton Icon="Filter" Label="{loc:Str Key=ImageAudit_InUse_Label}" IsChecked="{x:Bind ViewModel.ActiveCountFilters.Images.OneImage, Mode=TwoWay}" Command="{x:Bind ViewModel.FilterImagesCommand}"></AppBarToggleButton>
            <AppBarToggleButton Icon="Filter" Label="{loc:Str Key=ImageAudit_Shared_Label}" IsChecked="{x:Bind ViewModel.ActiveCountFilters.Images.MoreThanOneImage, Mode=TwoWay}" Command="{x:Bind ViewModel.FilterImagesCommand}"></AppBarToggleButton>
            <AppBarToggleButton Icon="Filter" Label="{loc:Str Key=ImageAudit_Orphan_Label}" IsChecked="{x:Bind ViewModel.ActiveCountFilters.Images.Missing, Mode=TwoWay}" Command="{x:Bind ViewModel.FilterImagesCommand}"></AppBarToggleButton>
            <template:SeparatorEx VerticalAlignment="Stretch" HorizontalAlignment="Center" Thickness="2" Margin="16 0" Orientation="Vertical" UseGradient="True" LineBrush="{ThemeResource AccentBrush}" />
            <AppBarButton Label="{loc:Str Key=ImageAudit_Dimensions_Label}" help:Help.Key="ImageAudit_Dimensions_Tooltip" Command="{x:Bind ViewModel.GetImageDimensionsCommand}">
                <AppBarButton.Content>
                    <FontIcon Glyph="&#xE744;" />
                </AppBarButton.Content>
            </AppBarButton>
            <AppBarButton Icon="Delete" Label="{loc:Str Key=ImageAudit_Orphan_Label}" help:Help.Key="ImageAudit_Orphan_Tooltip" Command="{x:Bind ViewModel.DeleteOrphanImagesCommand}"></AppBarButton>
            <template:SeparatorEx VerticalAlignment="Stretch" HorizontalAlignment="Center" Thickness="2" Margin="16 0" Orientation="Vertical" UseGradient="True" LineBrush="{ThemeResource AccentBrush}" />
            <uc:ExclusiveOptionsControl Header="{loc:Str Key=Common_View_Header}" VerticalAlignment="Center" SelectedValue="{x:Bind ViewModel.SelectedViewValue, Mode=TwoWay}">
                <uc:ExclusiveOption LabelKey="Common_ListView_Label" Glyph="&#xE8FD;" Value="List"/>
                <uc:ExclusiveOption LabelKey="Common_GridView_Label" Glyph="&#xF0E2;" Value="Grid"/>
            </uc:ExclusiveOptionsControl>
        </uc:AdaptiveToolbarPanel>

        <template:SeparatorEx Grid.Row="1" Margin="0 8" VerticalAlignment="Bottom" Thickness="1" UseGradient="True" />

        <!-- Central content: FlipView with the audit views (page 1) and the image-set characteristics chart (page 2) -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <FlipView x:Name="AuditFlipView" Grid.Row="0" Background="Transparent" UseTouchAnimationsForAllNavigation="False" SelectionChanged="AuditFlipView_SelectionChanged">
                <!-- Page 1: data grid / image grid -->
                <FlipViewItem HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <Grid>
                        <controls:DataGrid x:Name="iaDataGrid" ItemsSource="{x:Bind ViewModel.ImagesCollectionFiltered, Mode=TwoWay}" SelectedItem="{x:Bind ViewModel.SharedDataService.SelectedImage, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsListView, Mode=OneWay, Converter={StaticResource VisibleIfTrueConverter}}" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible" AlternatingRowBackground="Transparent" AlternatingRowForeground="{StaticResource SystemBaseMediumColor}" AreRowGroupHeadersFrozen="True" AutoGenerateColumns="False" CanUserSortColumns="True" CanUserReorderColumns="True" CanUserResizeColumns="True" ColumnHeaderHeight="40" FrozenColumnCount="1" GridLinesVisibility="All" HeadersVisibility="Column" IsReadOnly="True" RowDetailsVisibilityMode="Collapsed" SelectionMode="Single" RowGroupHeaderPropertyNameAlternative="Range" SelectionChanged="{x:Bind ViewModel.IaControl_OnImageSelectionChanged}" Sorting="IaDataGrid_Sorting">
                            <controls:DataGrid.Columns>
                                <controls:DataGridTextColumn Width="400" Header="File name" Tag="FileName" Binding="{Binding Name}"/>
                                <controls:DataGridTextColumn Header="Size (Kb)" Tag="FileSize" Binding="{Binding FileSize}"/>
                                <!-- Quality/Duration: solo visibles para sets de vídeo (las ajusta el code-behind según IsVideoSet); ocultas por defecto. -->
                                <controls:DataGridTextColumn x:Name="QualityColumn" Header="Quality" Tag="Quality" Binding="{Binding QualityText}" Visibility="Collapsed"/>
                                <controls:DataGridTextColumn Header="Dimensions" Tag="Dimensions" Binding="{Binding Dimensions}"/>
                                <controls:DataGridTextColumn x:Name="DurationColumn" Header="Duration" Tag="Duration" Binding="{Binding DurationText}" Visibility="Collapsed"/>
                                <controls:DataGridTextColumn Header="Extension" Tag="FileExtension" Binding="{Binding FileExtension}"/>
                                <!-- Region: oculta para sets de vídeo (no tienen región). -->
                                <controls:DataGridTextColumn x:Name="RegionColumn" Header="Region" Tag="Region" Binding="{Binding Region}"/>
                                <controls:DataGridTextColumn Header="# games" Tag="LinkedGames" Binding="{Binding LinkedGames.Count}"/>
                                <controls:DataGridTextColumn Header="Game(s)" Tag="LinkedGamesToString" Binding="{Binding LinkedGamesToString}"/>
                            </controls:DataGrid.Columns>
                        </controls:DataGrid>
                        <uc:ImageGridControl Visibility="{x:Bind ViewModel.IsGridView, Mode=OneWay, Converter={StaticResource VisibleIfTrueConverter}}" ViewModel="{x:Bind ViewModel.IgViewModel}"></uc:ImageGridControl>
                    </Grid>
                </FlipViewItem>
                <!-- Page 2: image set characteristics (4 stacked columns: extension / dimensions / region / no-region). Y label = most repeated value of each column. -->
                <FlipViewItem x:Name="ImageCharacteristicsItem" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <uc:WidgetStatCardControl VisualStyle="LateralAccentBar" ColorVariant="ThemeAccent" ContentVerticalAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Str Key=ImageAudit_Characteristics_Title}" Margin="0 8" Style="{StaticResource TitleStyle}"/>
                                <Button Grid.Column="1" x:Name="ImageCharacteristicsHelpButton" Style="{StaticResource Button_Icon}" Click="ImageCharacteristicsHelp_Click" VerticalAlignment="Center" Margin="8 8 0 0" Padding="8" help:Help.AffordanceVisible="True" help:Help.Key="Common_Help_Tooltip">
                                    <FontIcon Glyph="&#xE897;" FontSize="16"/>
                                </Button>
                                <TeachingTip Grid.Column="1" x:Name="ImageCharacteristicsHelpTip" Target="{x:Bind ImageCharacteristicsHelpButton}" IsLightDismissEnabled="True" PreferredPlacement="BottomLeft" Title="{loc:Str Key=ImageAudit_Characteristics_Title}" Subtitle="{loc:Str Key=ImageAudit_Characteristics_Description}"/>
                            </Grid>
                            <template:SeparatorEx Grid.Row="1" Margin="0 8 0 16" VerticalAlignment="Bottom" Thickness="1" UseGradient="True"/>
                            <lvc:CartesianChart Grid.Row="2" Series="{x:Bind ViewModel.ImageCharacteristicsSeries, Mode=OneWay}" XAxes="{x:Bind ViewModel.ImageCharacteristicsXAxes, Mode=OneWay}" YAxes="{x:Bind ViewModel.ImageCharacteristicsYAxes, Mode=OneWay}" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" LegendPosition="Hidden" Visibility="{x:Bind ViewModel.HasImageCharacteristicsData, Mode=OneWay, Converter={StaticResource VisibleIfTrueConverter}}"/>
                        </Grid>
                    </uc:WidgetStatCardControl>
                </FlipViewItem>
            </FlipView>

            <!-- FlipView page indicator -->
            <PipsPager Grid.Row="1" HorizontalAlignment="Center" Margin="0 4 0 0" NumberOfPages="2" SelectedPageIndex="{x:Bind AuditFlipView.SelectedIndex, Mode=TwoWay}"/>
        </Grid>

        <template:SeparatorEx Grid.Row="3" Margin="0 8" VerticalAlignment="Bottom" Thickness="1" UseGradient="True" />

        <!-- Filter images count -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" >
            <TextBlock Text="{x:Bind helpers:LocFmt.ShowingXofY(ViewModel.ImagesCollectionFiltered.Count, ViewModel.ImagesCollection.Count), Mode=OneWay}" Foreground="{ThemeResource TextSecondaryBrush}"/>
        </StackPanel>

        <!-- Statistics -->
        <uc:WidgetStatCardControl Grid.Row="5" VisualStyle="SplitPanel" ColorVariant="ThemeAccent" Glyph="&#xE8B9;" IconCollapsePillCount="4" HasBorder="True">
            <!-- Orden: Extension · Quality · Dimensions · Region · NoRegion · Duration. Para imágenes se ocultan
                 Quality/Duration (quedan Extension·Dimensions·Region·NoRegion); para vídeos se ocultan Region/NoRegion
                 (quedan Extension·Quality·Dimensions·Duration). El ancho de columna sigue el mismo patrón StarIfTrue
                 que ya usaban las pastillas de región, para que las visibles repartan el espacio por igual. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"></ColumnDefinition>
                    <ColumnDefinition Width="{x:Bind ViewModel.IsVideoSet, Mode=OneWay, Converter={StaticResource StarIfTrueConverter}}"></ColumnDefinition>
                    <ColumnDefinition Width="1*"></ColumnDefinition>
                    <ColumnDefinition Width="{x:Bind ViewModel.ShowRegionStats, Mode=OneWay, Converter={StaticResource StarIfTrueConverter}}"></ColumnDefinition>
                    <ColumnDefinition Width="{x:Bind ViewModel.ShowRegionStats, Mode=OneWay, Converter={StaticResource StarIfTrueConverter}}"></ColumnDefinition>
                    <ColumnDefinition Width="{x:Bind ViewModel.IsVideoSet, Mode=OneWay, Converter={StaticResource StarIfTrueConverter}}"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <uc:WidgetStatCardControl Grid.Column="0" VisualStyle="SplitPanel" ColorVariant="ThemeAccent" Label="{x:Bind ViewModel.StatisticsImages.Extension.Title, Mode=OneWay}" Value="{x:Bind ViewModel.StatisticsImages.Extension.ValueText, Mode=OneWay}" Description="{x:Bind ViewModel.StatisticsImages.Extension.Description, Mode=OneWay}" HasBorder="False"/>
                <uc:WidgetStatCardControl Grid.Column="1" Visibility="{x:Bind ViewModel.IsVideoSet, Mode=OneWay, Converter={StaticResource VisibleIfTrueConverter}}" VisualStyle="SplitPanel" ColorVariant="ThemeAccent" Label="{x:Bind ViewModel.StatisticsImages.Quality.Title, Mode=OneWay}" Value="{x:Bind ViewModel.StatisticsImages.Quality.ValueText, Mode=OneWay}" Description="{x:Bind ViewModel.StatisticsImages.Quality.Description, Mode=OneWay}" HasBorder="False"/>
                <uc:WidgetStatCardControl Grid.Column="2" VisualStyle="SplitPanel" ColorVariant="ThemeAccent" Label="{x:Bind ViewModel.StatisticsImages.Dimensions.Title, Mode=OneWay}" Value="{x:Bind ViewModel.StatisticsImages.Dimensions.ValueText, Mode=OneWay}" Description="{x:Bind ViewModel.StatisticsImages.Dimensions.Description, Mode=OneWay}" HasBorder="False"/>
                <uc:WidgetStatCardControl Grid.Column="3" Visibility="{x:Bind ViewModel.ShowRegionStats, Mode=OneWay, Converter={StaticResource VisibleIfTrueConverter}}" VisualStyle="SplitPanel" ColorVariant="ThemeAccent" Label="{x:Bind ViewModel.StatisticsImages.Region.Title, Mode=OneWay}" Value="{x:Bind ViewModel.StatisticsImages.Region.ValueText, Mode=OneWay}" Description="{x:Bind ViewModel.StatisticsImages.Region.Description, Mode=OneWay}" HasBorder="False"/>
                <uc:WidgetStatCardControl Grid.Column="4" Visibility="{x:Bind ViewModel.ShowRegionStats, Mode=OneWay, Converter={StaticResource VisibleIfTrueConverter}}" VisualStyle="SplitPanel" ColorVariant="ThemeAccent" Label="{x:Bind ViewModel.StatisticsImages.NoRegion.Title, Mode=OneWay}" Value="{x:Bind ViewModel.StatisticsImages.NoRegion.ValueText, Mode=OneWay}" Description="{x:Bind ViewModel.StatisticsImages.NoRegion.Description, Mode=OneWay}" HasBorder="False"/>
                <uc:WidgetStatCardControl Grid.Column="5" Visibility="{x:Bind ViewModel.IsVideoSet, Mode=OneWay, Converter={StaticResource VisibleIfTrueConverter}}" VisualStyle="SplitPanel" ColorVariant="ThemeAccent" Label="{x:Bind ViewModel.StatisticsImages.Duration.Title, Mode=OneWay}" Value="{x:Bind ViewModel.StatisticsImages.Duration.ValueText, Mode=OneWay}" Description="{x:Bind ViewModel.StatisticsImages.Duration.Description, Mode=OneWay}" HasBorder="False"/>
            </Grid>
        </uc:WidgetStatCardControl>
        
    </Grid>
</UserControl>
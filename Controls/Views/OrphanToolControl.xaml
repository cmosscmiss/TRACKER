<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MM4LB.Controls.Views.OrphanToolControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="using:MM4LB.Controls.Views"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:template="using:MM4LB.Controls.Templates"
    xmlns:sys="using:System"
    xmlns:loc="using:MM4LB.Markup"
    xmlns:helpers="using:MM4LB.Helpers"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar: alterna tabla/grid, filtra por el tipo de medio seleccionado, y borra los huérfanos mostrados. -->
        <uc:AdaptiveToolbarPanel Grid.Row="0">
            <uc:ExclusiveOptionsControl Header="{loc:Str Key=Common_View_Header}" VerticalAlignment="Center" SelectedValue="{x:Bind ViewModel.SelectedViewValue, Mode=TwoWay}">
                <uc:ExclusiveOption LabelKey="Common_TableView_Label" Glyph="&#xE8FD;" Value="Table"/>
                <uc:ExclusiveOption LabelKey="Common_GridView_Label" Glyph="&#xE8A9;" Value="Grid"/>
            </uc:ExclusiveOptionsControl>
            <template:SeparatorEx VerticalAlignment="Stretch" HorizontalAlignment="Center" Thickness="2" Margin="16 0" Orientation="Vertical" UseGradient="True" LineBrush="{ThemeResource AccentBrush}"/>
            <AppBarToggleButton Icon="Filter" Label="{loc:Str Key=Common_SelectedType_Label}" IsChecked="{x:Bind ViewModel.FilterBySelectedType, Mode=TwoWay}"/>
            <template:SeparatorEx VerticalAlignment="Stretch" HorizontalAlignment="Center" Thickness="2" Margin="16 0" Orientation="Vertical" UseGradient="True" LineBrush="{ThemeResource AccentBrush}"/>
            <AppBarButton Icon="Delete" Label="{loc:Str Key=OrphanTool_DeleteAll_Label}" helpers:Help.Key="OrphanTool_DeleteAll_Tooltip" Command="{x:Bind ViewModel.DeleteAllOrphansCommand, Mode=OneWay}"/>
        </uc:AdaptiveToolbarPanel>

        <!-- Separador horizontal tras la toolbar. -->
        <template:SeparatorEx Grid.Row="1" Margin="0 8" VerticalAlignment="Bottom" Thickness="1" UseGradient="True"/>

        <!-- Contenido. -->
        <Grid Grid.Row="2">
            <!-- Vista TABLA: lista los huérfanos (tipo, fichero, región). -->
            <controls:DataGrid x:Name="dgOrphans"
                               ItemsSource="{x:Bind ViewModel.IgViewModel.Images, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.IsTableView, Mode=OneWay, Converter={StaticResource VisibleIfTrueConverter}}"
                               HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible"
                               AutoGenerateColumns="False" CanUserSortColumns="True" CanUserReorderColumns="True" CanUserResizeColumns="True"
                               ColumnHeaderHeight="40" FrozenColumnCount="1" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                               IsReadOnly="True" SelectionMode="Single" Sorting="OrphanDataGrid_Sorting">
                <controls:DataGrid.Columns>
                    <controls:DataGridTextColumn Width="200" Header="Type" Tag="Type" Binding="{Binding Type.Value}"/>
                    <controls:DataGridTextColumn Width="420" Header="File" Tag="Name" Binding="{Binding Name}"/>
                    <controls:DataGridTextColumn Header="Region" Tag="Region" Binding="{Binding Region.Value}"/>
                </controls:DataGrid.Columns>
            </controls:DataGrid>

            <!-- Vista GRID: miniaturas (imágenes y vídeos con chapa de play), decodificadas al hacer scroll. -->
            <uc:ImageGridControl Visibility="{x:Bind ViewModel.IsGridView, Mode=OneWay, Converter={StaticResource VisibleIfTrueConverter}}" ViewModel="{x:Bind ViewModel.IgViewModel}"/>

            <!-- Estado vacío: se escaneó y no hay huérfanos. -->
            <TextBlock Text="{loc:Str Key=OrphanTool_Empty_Text}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center" Foreground="{ThemeResource TextSecondaryBrush}" Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay, Converter={StaticResource VisibleIfTrueConverter}}"/>
        </Grid>

        <!-- Separador antes del pie. -->
        <template:SeparatorEx Grid.Row="3" Margin="0 8" VerticalAlignment="Bottom" Thickness="1" UseGradient="True"/>

        <!-- Contador "Showing X of Y" (huérfanos mostrados / total de huérfanos). -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock Text="{x:Bind helpers:LocFmt.ShowingXofY(ViewModel.ShownCount, ViewModel.TotalOrphanCount), Mode=OneWay}" Foreground="{ThemeResource TextSecondaryBrush}"/>
        </StackPanel>

        <!-- Estadísticas de huérfanos en pastillas. -->
        <uc:WidgetStatCardControl Grid.Row="5" VisualStyle="SplitPanel" ColorVariant="ThemeAccent" Glyph="&#xE7BA;" IconCollapsePillCount="4" HasBorder="True" Visibility="{x:Bind ViewModel.HasRun, Mode=OneWay, Converter={StaticResource VisibleIfTrueConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <uc:WidgetStatCardControl Grid.Column="0" VisualStyle="SplitPanel" ColorVariant="ThemeAccent" Label="{loc:Str Key=OrphanTool_Orphans_Label}" Value="{x:Bind ViewModel.OrphansRatio, Mode=OneWay}" Description="{loc:Str Key=OrphanTool_OrphansRatio_Description}" HasBorder="False"/>
                <uc:WidgetStatCardControl Grid.Column="1" VisualStyle="SplitPanel" ColorVariant="ThemeAccent" Label="{loc:Str Key=Common_Size_Label}" Value="{x:Bind ViewModel.SizeRatio, Mode=OneWay}" Description="{loc:Str Key=OrphanTool_SizeRatio_Description}" HasBorder="False"/>
                <uc:WidgetStatCardControl Grid.Column="2" VisualStyle="SplitPanel" ColorVariant="ThemeAccent" Label="{loc:Str Key=Common_Types_Label}" Value="{x:Bind ViewModel.TypesRatio, Mode=OneWay}" Description="{loc:Str Key=OrphanTool_TypesRatio_Description}" HasBorder="False"/>
                <uc:WidgetStatCardControl Grid.Column="3" VisualStyle="SplitPanel" ColorVariant="ThemeAccent" Label="{x:Bind ViewModel.TopOrphanType, Mode=OneWay}" Value="{x:Bind ViewModel.TopTypeOrphanRatio, Mode=OneWay}" Description="{loc:Str Key=OrphanTool_TopTypeRatio_Description}" HasBorder="False"/>
            </Grid>
        </uc:WidgetStatCardControl>
    </Grid>
</UserControl>

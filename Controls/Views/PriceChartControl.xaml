<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MM4LB.Controls.Views.PriceChartControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:uc="using:MM4LB.Controls.Views"
    xmlns:vm="using:MM4LB.Controls.ViewModels"
    xmlns:template="using:MM4LB.Controls.Templates"
    xmlns:loc="using:MM4LB.Markup"
    xmlns:help="using:MM4LB.Helpers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barra de herramientas del producto, en grupos separados por barras verticales:
             refrescar/buscar | editar/alerta | comprado/borrar | favorito. -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4" Padding="8 6 8 0"
                    Visibility="{x:Bind ViewModel.HasProduct, Converter={StaticResource VisibleIfTrueConverter}, FallbackValue=Collapsed, Mode=OneWay}">
            <Button Style="{StaticResource Button_Icon}" BorderThickness="0" Padding="8" Click="OnRefreshProductClick" help:Help.Key="PriceChart_Refresh_Tooltip">
                <FontIcon Glyph="&#xE72C;" FontSize="16"/>
            </Button>
            <Button Style="{StaticResource Button_Icon}" BorderThickness="0" Padding="8" Click="OnSearchProductClick" help:Help.Key="PriceChart_Search_Tooltip">
                <FontIcon Glyph="&#xE721;" FontSize="16"/>
            </Button>

            <template:SeparatorEx VerticalAlignment="Stretch" HorizontalAlignment="Center" Thickness="2" Margin="2 4" Orientation="Vertical" UseGradient="True" LineBrush="{ThemeResource AccentBrush}"/>

            <Button Style="{StaticResource Button_Icon}" BorderThickness="0" Padding="8" Click="OnEditNameClick" help:Help.Key="PriceChart_Edit_Tooltip">
                <FontIcon Glyph="&#xE70F;" FontSize="16"/>
            </Button>
            <Button Style="{StaticResource Button_Icon}" BorderThickness="0" Padding="8" Click="OnSetAlertClick" help:Help.Key="PriceChart_Alert_Tooltip">
                <Grid>
                    <FontIcon Glyph="&#xE7ED;" FontSize="16" Foreground="{ThemeResource AccentBrush}"
                              Visibility="{x:Bind ViewModel.HasAlert, Converter={StaticResource VisibleIfTrueConverter}, FallbackValue=Collapsed, Mode=OneWay}"/>
                    <FontIcon Glyph="&#xE7ED;" FontSize="16"
                              Visibility="{x:Bind ViewModel.HasAlert, Converter={StaticResource HiddenIfTrueConverter}, FallbackValue=Visible, Mode=OneWay}"/>
                </Grid>
            </Button>

            <template:SeparatorEx VerticalAlignment="Stretch" HorizontalAlignment="Center" Thickness="2" Margin="2 4" Orientation="Vertical" UseGradient="True" LineBrush="{ThemeResource AccentBrush}"/>

            <Button Style="{StaticResource Button_Icon}" BorderThickness="0" Padding="8" Click="OnMarkPurchasedClick" help:Help.Key="PriceChart_Purchased_Tooltip">
                <Grid>
                    <FontIcon Glyph="&#xE7BF;" FontSize="16" Foreground="{ThemeResource AccentBrush}"
                              Visibility="{x:Bind ViewModel.IsPurchased, Converter={StaticResource VisibleIfTrueConverter}, FallbackValue=Collapsed, Mode=OneWay}"/>
                    <FontIcon Glyph="&#xE7BF;" FontSize="16"
                              Visibility="{x:Bind ViewModel.IsPurchased, Converter={StaticResource HiddenIfTrueConverter}, FallbackValue=Visible, Mode=OneWay}"/>
                </Grid>
            </Button>
            <Button Style="{StaticResource Button_Icon}" BorderThickness="0" Padding="8" Click="OnDeleteProductClick" help:Help.Key="PriceChart_Delete_Tooltip">
                <FontIcon Glyph="&#xE74D;" FontSize="16"/>
            </Button>

            <template:SeparatorEx VerticalAlignment="Stretch" HorizontalAlignment="Center" Thickness="2" Margin="2 4" Orientation="Vertical" UseGradient="True" LineBrush="{ThemeResource AccentBrush}"/>

            <Button Style="{StaticResource Button_Icon}" BorderThickness="0" Padding="8" Click="OnToggleFavoriteClick"
                    IsEnabled="{x:Bind ViewModel.CanToggleFavorite, Mode=OneWay}" help:Help.Key="PriceChart_Favorite_Tooltip">
                <Grid>
                    <FontIcon Glyph="&#xE735;" FontSize="16" Foreground="{ThemeResource AccentBrush}"
                              Visibility="{x:Bind ViewModel.IsFavorite, Converter={StaticResource VisibleIfTrueConverter}, FallbackValue=Collapsed, Mode=OneWay}"/>
                    <FontIcon Glyph="&#xE734;" FontSize="16"
                              Visibility="{x:Bind ViewModel.IsFavorite, Converter={StaticResource HiddenIfTrueConverter}, FallbackValue=Visible, Mode=OneWay}"/>
                </Grid>
            </Button>
        </StackPanel>

        <!-- Separador horizontal tras la toolbar (solo con producto). -->
        <template:SeparatorEx Grid.Row="1" Margin="0 8 0 8" Thickness="1" UseGradient="True"
                              Visibility="{x:Bind ViewModel.HasProduct, Converter={StaticResource VisibleIfTrueConverter}, FallbackValue=Collapsed, Mode=OneWay}"/>

        <!-- Cabecera del producto seleccionado: imagen + título + pills de precio actual y mínimo histórico. -->
        <Grid Grid.Row="2" Padding="12 8" ColumnSpacing="12"
              Visibility="{x:Bind ViewModel.HasProduct, Converter={StaticResource VisibleIfTrueConverter}, FallbackValue=Collapsed, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Columna izquierda: imagen del producto y, debajo, los chips por tienda (precio + Prime + envío). -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Image Grid.Row="0" Width="106" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top"
                       Source="{x:Bind ViewModel.Image, Mode=OneWay}"/>

                <!-- Chips por tienda, apilados bajo la imagen; scroll vertical si no caben. -->
                <ScrollViewer Grid.Row="1" Margin="0 8 0 0" VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Stores, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" Spacing="6"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:StoreChip">
                                <Border Background="{ThemeResource CardBackgroundLightBrush}" CornerRadius="10" Padding="8 3" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{x:Bind Label}" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind PriceText}" Foreground="{ThemeResource AccentLightBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                        <Border Background="#FF2E7D32" CornerRadius="6" Padding="5 1" VerticalAlignment="Center"
                                                Visibility="{x:Bind ShowPrimeBadge, Converter={StaticResource VisibleIfTrueConverter}}">
                                            <TextBlock Text="Prime" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                                        </Border>
                                        <!-- Coste de envío (Amazon), aparte del precio. Solo si se detectó (> 0). -->
                                        <TextBlock Text="{x:Bind ShippingText}" Foreground="{ThemeResource WarningBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   help:Help.Key="PriceChart_Shipping_Tooltip"
                                                   Visibility="{x:Bind ShowShipping, Converter={StaticResource VisibleIfTrueConverter}}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{x:Bind ViewModel.ProductName, Mode=OneWay}" TextWrapping="Wrap"
                       MaxLines="3" TextTrimming="CharacterEllipsis" Style="{StaticResource TitleStyle}"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0 8 0 0">
                <Border Background="#FF546E7A" CornerRadius="12" Padding="10 4"
                        Visibility="{x:Bind ViewModel.IsPurchased, Converter={StaticResource VisibleIfTrueConverter}, FallbackValue=Collapsed, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Str Key=PriceChart_Purchased_Label}" Foreground="White" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Background="#FF2F6FED" CornerRadius="12" Padding="10 4"
                        help:Help.Key="Product_Preorder_Tooltip"
                        Visibility="{x:Bind ViewModel.ShowPreorder, Converter={StaticResource VisibleIfTrueConverter}, FallbackValue=Collapsed, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE787;" FontSize="12" Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Str Key=PriceChart_Preorder_Label}" Foreground="White" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Background="{ThemeResource SuccessBrush}" CornerRadius="12" Padding="10 4"
                        help:Help.Key="PriceChart_BelowAlert_Tooltip"
                        Visibility="{x:Bind ViewModel.ShowBelowAlert, Converter={StaticResource VisibleIfTrueConverter}, FallbackValue=Collapsed, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE7ED;" FontSize="12" Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind ViewModel.AlertPriceText, Mode=OneWay}" Foreground="White" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Background="{ThemeResource WarningBrush}" CornerRadius="12" Padding="10 4"
                        help:Help.Key="Product_Issues_Tooltip"
                        Visibility="{x:Bind ViewModel.ShowIssues, Converter={StaticResource VisibleIfTrueConverter}, FallbackValue=Collapsed, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Str Key=PriceChart_Issues_Label}" Foreground="White" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Background="#FFCC5500" CornerRadius="12" Padding="10 4"
                        Visibility="{x:Bind ViewModel.ShowPromo, Converter={StaticResource VisibleIfTrueConverter}, FallbackValue=Collapsed, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE719;" FontSize="12" Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Str Key=PriceChart_Promo_Label}" Foreground="White" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Background="{x:Bind ViewModel.PrimeBrush, Mode=OneWay}" CornerRadius="12" Padding="10 4"
                        Visibility="{x:Bind ViewModel.ShowPrime, Converter={StaticResource VisibleIfTrueConverter}, FallbackValue=Collapsed, Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.PrimeText, Mode=OneWay}" Foreground="White" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>

                <uc:ChartTypeSelectorControl Grid.Row="2" SelectedChartType="{x:Bind ViewModel.SelectedChartType, Mode=TwoWay}" SortOrder="{x:Bind ViewModel.SortOrder, Mode=TwoWay}" TopN="{x:Bind ViewModel.TopN, Mode=TwoWay}" ShowCategoryLabels="{x:Bind ViewModel.SharedDataService.ShowChartAxisLabels, Mode=OneWay}" FitValueAxis="True" SeriesValues="{x:Bind ViewModel.SeriesValues, Mode=OneWay}" SeriesNames="{x:Bind ViewModel.SeriesNames, Mode=OneWay}" Labels="{x:Bind ViewModel.Labels, Mode=OneWay}" ValueSuffix="{x:Bind ViewModel.ValueSuffix, Mode=OneWay}" ValueFormat="0.00" LabelsRotation="45"/>
            </Grid>
        </Grid>

        <!-- Pie: precio actual y precio más bajo del histórico, como tarjetas de estadística. -->
        <Grid Grid.Row="3" Margin="4 0 4 4"
              Visibility="{x:Bind ViewModel.HasProduct, Converter={StaticResource VisibleIfTrueConverter}, FallbackValue=Collapsed, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <uc:WidgetStatCardControl Grid.Column="0" VisualStyle="IconBoxSoftNeon" ColorVariant="ThemeAccent"
                                      Glyph="&#xE8EC;"
                                      Label="{loc:Str Key=PriceChart_CurrentPrice_Label}"
                                      Value="{x:Bind ViewModel.CurrentPriceText, Mode=OneWay}"
                                      Description="{x:Bind ViewModel.CurrentPriceStore, Mode=OneWay}"/>
            <uc:WidgetStatCardControl Grid.Column="1" VisualStyle="IconBoxSoftNeon" ColorVariant="AccentLight"
                                      Glyph="&#xE96E;"
                                      Label="{loc:Str Key=PriceChart_LowestPrice_Label}"
                                      Value="{x:Bind ViewModel.LowestPriceText, Mode=OneWay}"
                                      Description="{x:Bind ViewModel.LowestPriceStore, Mode=OneWay}"/>
        </Grid>
    </Grid>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MM4LB.Controls.Views.SettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:template="using:MM4LB.Controls.Templates"
    xmlns:helpers="using:MM4LB.Helpers"
    xmlns:loc="using:MM4LB.Markup"
    mc:Ignorable="d">

    <UserControl.Resources>
        <helpers:IntToDoubleConverter x:Key="IntToDoubleConverter" />
        <!-- Cabecera de cada grupo de ajustes: texto en acento, mayúsculas y espaciado, con un margen superior
             que separa el grupo del anterior. El primer grupo sobreescribe el Margin a 0 (ya lo separa el padding). -->
        <Style x:Key="SettingsSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource AccentBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CharacterSpacing" Value="120" />
            <Setter Property="Margin" Value="0 24 0 0" />
        </Style>
        <!-- Fila etiqueta + slider compartida por todos los ajustes. -->
        <Style x:Key="SettingsRowStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0 10 0 0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SettingsLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextBrush}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" Padding="24 16">
            <!-- ==================== THUMBNAILS ==================== -->
            <TextBlock Text="{loc:Str Key=QuickSettings_Thumbnails_Header}" Style="{StaticResource SettingsSectionHeaderStyle}" Margin="0" />
            <template:SeparatorEx Margin="0 4 0 0" HorizontalAlignment="Stretch" Thickness="2" UseGradient="True" LineBrush="{ThemeResource AccentBrush}" />
            <Grid Style="{StaticResource SettingsRowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="700" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Str Key=QuickSettings_GameGallery_Label}" Style="{StaticResource SettingsLabelStyle}" />
                <Slider Grid.Column="1" Orientation="Horizontal" Minimum="{x:Bind ViewModel.ImageGridGameViewModel.MinimumSize, Mode=OneWay, Converter={StaticResource IntToDoubleConverter}}" Maximum="{x:Bind ViewModel.ImageGridGameViewModel.MaximumSize, Mode=OneWay, Converter={StaticResource IntToDoubleConverter}}" LargeChange="50" Value="{x:Bind ViewModel.ImageGridGameViewModel.Width, Mode=TwoWay, Converter={StaticResource IntToDoubleConverter}}" />
            </Grid>
            <Grid Style="{StaticResource SettingsRowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="700" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Str Key=QuickSettings_MediaAudit_Label}" Style="{StaticResource SettingsLabelStyle}" />
                <Slider Grid.Column="1" Orientation="Horizontal" Minimum="{x:Bind ViewModel.ImageAuditViewModel.IgViewModel.MinimumSize, Mode=OneWay, Converter={StaticResource IntToDoubleConverter}}" Maximum="{x:Bind ViewModel.ImageAuditViewModel.IgViewModel.MaximumSize, Mode=OneWay, Converter={StaticResource IntToDoubleConverter}}" LargeChange="50" Value="{x:Bind ViewModel.ImageAuditViewModel.IgViewModel.Width, Mode=TwoWay, Converter={StaticResource IntToDoubleConverter}}" />
            </Grid>
            <Grid Style="{StaticResource SettingsRowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="700" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Str Key=QuickSettings_ImportMedia_Label}" Style="{StaticResource SettingsLabelStyle}" />
                <Slider Grid.Column="1" Orientation="Horizontal" Minimum="{x:Bind ViewModel.ImageCollectionImportViewModel.MinimumSize, Mode=OneWay, Converter={StaticResource IntToDoubleConverter}}" Maximum="{x:Bind ViewModel.ImageCollectionImportViewModel.MaximumSize, Mode=OneWay, Converter={StaticResource IntToDoubleConverter}}" LargeChange="50" Value="{x:Bind ViewModel.ImageCollectionImportViewModel.Width, Mode=TwoWay, Converter={StaticResource IntToDoubleConverter}}" />
            </Grid>
            <Grid Style="{StaticResource SettingsRowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="700" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Str Key=QuickSettings_OrphanMedia_Label}" Style="{StaticResource SettingsLabelStyle}" />
                <Slider Grid.Column="1" Orientation="Horizontal" Minimum="{x:Bind ViewModel.ToolsViewModel.OrphanToolViewModel.IgViewModel.MinimumSize, Mode=OneWay, Converter={StaticResource IntToDoubleConverter}}" Maximum="{x:Bind ViewModel.ToolsViewModel.OrphanToolViewModel.IgViewModel.MaximumSize, Mode=OneWay, Converter={StaticResource IntToDoubleConverter}}" LargeChange="50" Value="{x:Bind ViewModel.ToolsViewModel.OrphanToolViewModel.IgViewModel.Width, Mode=TwoWay, Converter={StaticResource IntToDoubleConverter}}" />
            </Grid>

            <!-- ==================== SOUND ==================== -->
            <TextBlock Text="{loc:Str Key=QuickSettings_Sound_Header}" Style="{StaticResource SettingsSectionHeaderStyle}" />
            <template:SeparatorEx Margin="0 4 0 0" HorizontalAlignment="Stretch" Thickness="2" UseGradient="True" LineBrush="{ThemeResource AccentBrush}" />
            <Grid Style="{StaticResource SettingsRowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="700" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Str Key=QuickSettings_VideoVolume_Label}" Style="{StaticResource SettingsLabelStyle}" />
                <Slider Grid.Column="1" Orientation="Horizontal" Maximum="100" Minimum="0" Value="{x:Bind ViewModel.GameImagesDashboardViewModel.VideoVolume, Mode=TwoWay}" />
            </Grid>

            <!-- ==================== WIDGETS ==================== -->
            <TextBlock Text="{loc:Str Key=QuickSettings_Widgets_Header}" Style="{StaticResource SettingsSectionHeaderStyle}" />
            <template:SeparatorEx Margin="0 4 0 0" HorizontalAlignment="Stretch" Thickness="2" UseGradient="True" LineBrush="{ThemeResource AccentBrush}" />
            <Grid Style="{StaticResource SettingsRowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="700" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Str Key=QuickSettings_CornerRadius_Label}" Style="{StaticResource SettingsLabelStyle}" />
                <Slider Grid.Column="1" Orientation="Horizontal" Maximum="24" Minimum="0" Value="{x:Bind ViewModel.LayoutSelectorViewModel.WidgetCornerRadius, Mode=TwoWay}" />
            </Grid>
            <Grid Style="{StaticResource SettingsRowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="700" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Str Key=QuickSettings_Gap_Label}" Style="{StaticResource SettingsLabelStyle}" />
                <Slider Grid.Column="1" Orientation="Horizontal" Maximum="24" Minimum="0" Value="{x:Bind ViewModel.LayoutSelectorViewModel.WidgetGap, Mode=TwoWay}" />
            </Grid>
            <Grid Style="{StaticResource SettingsRowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="700" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Str Key=QuickSettings_PanelMargin_Label}" Style="{StaticResource SettingsLabelStyle}" />
                <Slider Grid.Column="1" Orientation="Horizontal" Maximum="32" Minimum="0" Value="{x:Bind ViewModel.LayoutSelectorViewModel.WidgetPanelOuterMargin, Mode=TwoWay}" />
            </Grid>

        </StackPanel>
    </Grid>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MM4LB.Controls.Views.GamesAuditControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:uc="using:MM4LB.Controls.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:sys="using:System" 
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls" xmlns:template="using:MM4LB.Controls.Templates"
    xmlns:loc="using:MM4LB.Markup"
    xmlns:helpers="using:MM4LB.Helpers"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>            
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Toolbar -->
        <CommandBar DefaultLabelPosition="Right" HorizontalAlignment="Left" OverflowButtonVisibility="Collapsed" Background="Transparent" Visibility="{x:Bind ViewModel.IsGamesAuditView, Converter={StaticResource VisibleIfTrueConverter}, Mode=OneWay}">
            <AppBarToggleButton Icon="Filter" Label="{loc:Str Key=GamesAudit_InCollection_Label}" IsChecked="{x:Bind ViewModel.ActiveCountFilters.Game.InCollection, Mode=TwoWay}" Command="{x:Bind ViewModel.FilterGamesCommand}"></AppBarToggleButton>
            <AppBarToggleButton Icon="Filter" Label="{loc:Str Key=GamesAudit_InLbDb_Label}" IsChecked="{x:Bind ViewModel.ActiveCountFilters.Game.InLaunchboxDb, Mode=TwoWay}" Command="{x:Bind ViewModel.FilterGamesCommand}"></AppBarToggleButton>
            <AppBarToggleButton Icon="Filter" Label="{loc:Str Key=GamesAudit_NotInLbDb_Label}" IsChecked="{x:Bind ViewModel.ActiveCountFilters.Game.InCollectionNotInLaunchboxDb, Mode=TwoWay}" Command="{x:Bind ViewModel.FilterGamesCommand}"></AppBarToggleButton>
        </CommandBar>
        <CommandBar DefaultLabelPosition="Right" HorizontalAlignment="Left" OverflowButtonVisibility="Collapsed" Background="Transparent" Visibility="{x:Bind ViewModel.IsGamesAuditView, Converter={StaticResource HiddenIfTrueConverter}, Mode=OneWay}">
            <AppBarToggleButton Icon="Filter" Label="{loc:Str Key=GamesAudit_NoMatches_Label}" IsChecked="{x:Bind ViewModel.ActiveCountFilters.Images.Missing, Mode=TwoWay}" Command="{x:Bind ViewModel.FilterGamesCommand}"></AppBarToggleButton>
            <AppBarToggleButton Icon="Filter" Label="{loc:Str Key=GamesAudit_OneMatch_Label}" IsChecked="{x:Bind ViewModel.ActiveCountFilters.Images.OneImage, Mode=TwoWay}" Command="{x:Bind ViewModel.FilterGamesCommand}"></AppBarToggleButton>
            <AppBarToggleButton Icon="Filter" Label="{loc:Str Key=GamesAudit_MoreThanOneMatch_Label}" IsChecked="{x:Bind ViewModel.ActiveCountFilters.Images.MoreThanOneImage, Mode=TwoWay}" Command="{x:Bind ViewModel.FilterGamesCommand}"></AppBarToggleButton>
        </CommandBar>

        <template:SeparatorEx Grid.Row="1" Margin="0 8" VerticalAlignment="Bottom" Thickness="1" UseGradient="True"/>

        <!-- Data grid depending on the view -->
        <controls:DataGrid x:Name="dgGamesAudit" Grid.Row="2" ItemsSource="{x:Bind ViewModel.GamesCollectionFiltered, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedGame, Mode=TwoWay}" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible" AreRowGroupHeadersFrozen="True" AutoGenerateColumns="False" CanUserSortColumns="True" CanUserReorderColumns="True" CanUserResizeColumns="True" ColumnHeaderHeight="40" FrozenColumnCount="2" GridLinesVisibility="Horizontal" HeadersVisibility="Column" IsReadOnly="True" RowDetailsVisibilityMode="Collapsed" SelectionMode="Single" RowGroupHeaderPropertyNameAlternative="Range" SelectionChanged="{x:Bind ViewModel.GaControl_OnGameSelectionChanged}" Sorting="GaDataGrid_Sorting" Visibility="{x:Bind ViewModel.IsGamesAuditView, Mode=OneWay, Converter={StaticResource VisibleIfTrueConverter}}">
            <controls:DataGrid.Columns>
                <controls:DataGridTemplateColumn Tag="InCollection" Width="40">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding InCollection, Converter={StaticResource VisibleIfTrueConverter}}">
                                <Ellipse Width="12" Height="12" Fill="{ThemeResource AccentBrush}"></Ellipse>
                            </StackPanel>
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>
                <controls:DataGridTextColumn Width="400" Header="Title" Tag="Title" Binding="{Binding Title}"/>
                <controls:DataGridTextColumn Header="Launchbox ID" Tag="DatabaseId" Binding="{Binding DatabaseId}"/>
                <controls:DataGridTextColumn Header="Rom" Tag="RomFileName" Binding="{Binding RomFileName}"/>
                <controls:DataGridTextColumn Header="Version" Tag="Version" Binding="{Binding Version}"/>
            </controls:DataGrid.Columns>
        </controls:DataGrid>

        <controls:DataGrid x:Name="dgInGallery" Grid.Row="2" ItemsSource="{x:Bind ViewModel.GamesCollectionFiltered, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedGame, Mode=TwoWay}" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible" AlternatingRowBackground="Transparent" AlternatingRowForeground="{StaticResource SystemBaseMediumColor}" AreRowGroupHeadersFrozen="True" AutoGenerateColumns="False" CanUserSortColumns="True" CanUserReorderColumns="True" CanUserResizeColumns="True" ColumnHeaderHeight="40" FrozenColumnCount="1" GridLinesVisibility="All" HeadersVisibility="Column" IsReadOnly="True" RowDetailsVisibilityMode="Collapsed" SelectionMode="Single" RowGroupHeaderPropertyNameAlternative="Range" SelectionChanged="{x:Bind ViewModel.GaControl_OnGameSelectionChanged}" Sorting="GaDataGrid_Sorting" Visibility="{x:Bind ViewModel.IsGamesAuditView, Mode=OneWay, Converter={StaticResource HiddenIfTrueConverter}}">
            <controls:DataGrid.Columns>
                <controls:DataGridTextColumn Width="400" Header="Title" Tag="Title" Binding="{Binding Title}"/>
                <controls:DataGridTextColumn Header="Launchbox ID" Tag="DatabaseId" Binding="{Binding DatabaseId}"/>
                <controls:DataGridTextColumn Header="Matched Images" Tag="MatchedImages" Binding="{Binding Images.Count}"/>
            </controls:DataGrid.Columns>
        </controls:DataGrid>

        <template:SeparatorEx Grid.Row="3" Margin="0 8" VerticalAlignment="Bottom" Thickness="1" UseGradient="True"/>

        <!-- Count filtered elements -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock Text="{x:Bind helpers:LocFmt.ShowingXofY(ViewModel.GamesCollectionFiltered.Count, ViewModel.GamesCollection.Count), Mode=OneWay}" Foreground="{ThemeResource TextSecondaryBrush}"/>
        </StackPanel>

        <uc:WidgetStatCardControl Grid.Row="5" VisualStyle="SplitPanel" ColorVariant="ThemeAccent" Glyph="&#xE7FC;" IconCollapsePillCount="3" Visibility="{x:Bind ViewModel.IsGamesAuditView, Mode=OneWay, Converter={StaticResource VisibleIfTrueConverter}}" >
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <uc:WidgetStatCardControl Grid.Column="0" VisualStyle="SplitPanel" ColorVariant="ThemeAccent" Label="{x:Bind ViewModel.StatisticsGames.InCollection.Title, Mode=OneWay}" Value="{x:Bind ViewModel.StatisticsGames.InCollection.ValueText, Mode=OneWay}" Description="{x:Bind ViewModel.StatisticsGames.InCollection.Description, Mode=OneWay}" HasBorder="False"/>
                <uc:WidgetStatCardControl Grid.Column="1" VisualStyle="SplitPanel" ColorVariant="ThemeAccent" Label="{x:Bind ViewModel.StatisticsGames.InLaunchBox.Title, Mode=OneWay}" Value="{x:Bind ViewModel.StatisticsGames.InLaunchBox.ValueText, Mode=OneWay}" Description="{x:Bind ViewModel.StatisticsGames.InLaunchBox.Description, Mode=OneWay}" HasBorder="False"/>
                <uc:WidgetStatCardControl Grid.Column="2" VisualStyle="SplitPanel" ColorVariant="ThemeAccent" Label="{x:Bind ViewModel.StatisticsGames.NotInLaunchBox.Title, Mode=OneWay}" Value="{x:Bind ViewModel.StatisticsGames.NotInLaunchBox.ValueText, Mode=OneWay}" Description="{x:Bind ViewModel.StatisticsGames.NotInLaunchBox.Description, Mode=OneWay}" HasBorder="False"/>
            </Grid>
        </uc:WidgetStatCardControl>
    </Grid>
</UserControl>

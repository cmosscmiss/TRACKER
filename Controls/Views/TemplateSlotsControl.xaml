<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MM4LB.Controls.Views.TemplateSlotsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:MM4LB.Markup"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Tarjetas de templates: imagen + nombre (o placeholder si el slot está vacío). Los built-in (de app) llevan un
         candado. En modo selección (diálogo de grabar) se usa la selección del GridView; en modo carga (toolbar) se
         usa ItemClick. Máximo 3 por fila; el resto envuelve. -->
    <GridView x:Name="Items" HorizontalAlignment="Center" Background="Transparent"
              SelectionMode="None" IsItemClickEnabled="True"
              ItemContainerStyle="{StaticResource GameImagesGridViewItemStyle}"
              SelectionChanged="OnSelectionChanged" ItemClick="OnItemClick"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
        <GridView.ItemsPanel>
            <ItemsPanelTemplate>
                <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3"/>
            </ItemsPanelTemplate>
        </GridView.ItemsPanel>
        <GridView.ItemTemplate>
            <DataTemplate>
                <Grid Width="343" ToolTipService.ToolTip="{Binding DisplayName}">
                    <StackPanel Spacing="8">
                        <Border CornerRadius="8" Height="206" BorderThickness="1"
                                BorderBrush="{ThemeResource CardBackgroundLightBrush}" Background="{ThemeResource BackgroundLightBrush}">
                            <Grid>
                                <FontIcon Glyph="&#xE8B9;" FontSize="47" Foreground="{ThemeResource TextSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image Source="{Binding Image}" Stretch="UniformToFill"/>

                                <!-- Candado en los templates de aplicación (read-only). -->
                                <Border Visibility="{Binding IsBuiltIn, Converter={StaticResource VisibleIfTrueConverter}}"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" CornerRadius="4"
                                        Background="{ThemeResource BackgroundBrushOpacity80}" Padding="5 3"
                                        ToolTipService.ToolTip="{loc:Str Key=TemplateSlots_BuiltIn_Tooltip}">
                                    <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{ThemeResource AccentLightBrush}"/>
                                </Border>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="Center" Foreground="{ThemeResource TextBrush}"/>
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </GridView.ItemTemplate>
    </GridView>
</UserControl>

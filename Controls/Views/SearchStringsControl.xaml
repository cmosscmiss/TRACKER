<UserControl
    x:Class="MM4LB.Controls.Views.SearchStringsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <StackPanel VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" FontSize="16" Foreground="{ThemeResource AccentBrush}" />
            <TextBlock Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}" Padding="0 2" Foreground="{ThemeResource TextBrush}" Visibility="{x:Bind ViewModel.HasSearchStrings, Converter={StaticResource HiddenIfTrueConverter}, Mode=OneWay}" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.SearchStrings, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasSearchStrings, Converter={StaticResource VisibleIfTrueConverter}, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" Padding="0 2" Foreground="{Binding IsMatched, Converter={StaticResource ColorIfTrueConverter}}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</UserControl>
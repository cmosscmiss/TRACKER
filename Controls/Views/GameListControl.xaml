<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MM4LB.Controls.Views.GameListControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MM4LB.Controls.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MM4LB.Models"
    xmlns:uc="using:MM4LB.Controls.Views"
    xmlns:template="using:MM4LB.Controls.Templates"
    xmlns:sys="using:System"
    xmlns:loc="using:MM4LB.Markup"
    xmlns:helpers="using:MM4LB.Helpers"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Selector de tipo de medio + su separador (se colapsa con fade cuando la banda del panel lo muestra;
                 al ocultarlo, la lista de juegos crece para ocupar el hueco). -->
            <RowDefinition x:Name="SelectorRow" Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Image type selector (integrated above the game list). Selector + separador juntos para animarlos como uno. -->
        <Grid x:Name="SelectorHost" Grid.Row="0" SizeChanged="OnSelectorHostSizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <uc:ImageTypeControl Grid.Row="0" Margin="0 8 0 0" ViewModel="{Binding ImageTypeViewModel}"/>
            <template:SeparatorEx Grid.Row="1" Margin="0 8 0 16" VerticalAlignment="Bottom" Thickness="2" UseGradient="True" LineBrush="{ThemeResource AccentBrush}"/>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="8" Padding="16 0 20 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Text="{x:Bind ViewModel.FilterBy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{loc:Str Key=GameList_Filter_Placeholder}"/>
            <ToggleSplitButton Grid.Column="1" HorizontalAlignment="Left" IsChecked="{x:Bind ViewModel.FiltersEnabled, Mode=TwoWay}">
                <SymbolIcon Symbol="Filter"/>
                <ToggleSplitButton.Flyout>
                    <MenuFlyout>
                        <ToggleMenuFlyoutItem Text="{loc:Str Key=GameList_Missing_Label}" IsChecked="{x:Bind ViewModel.ActiveFilters.Images.Missing, Mode=TwoWay}" Command="{x:Bind ViewModel.FiltersChangedCommand}"/>
                        <ToggleMenuFlyoutItem Text="{loc:Str Key=GameList_OneMedia_Label}" IsChecked="{x:Bind ViewModel.ActiveFilters.Images.OneImage, Mode=TwoWay}" Command="{x:Bind ViewModel.FiltersChangedCommand}"/>
                        <ToggleMenuFlyoutItem Text="{loc:Str Key=GameList_MoreMedia_Label}" IsChecked="{x:Bind ViewModel.ActiveFilters.Images.MoreThanOneImage, Mode=TwoWay}" Command="{x:Bind ViewModel.FiltersChangedCommand}"/>
                    </MenuFlyout>
                </ToggleSplitButton.Flyout>
            </ToggleSplitButton>
        </Grid>

        <Grid Grid.Row="2" Margin="0 8 0 0">
            <ListView x:Name="lvGamesList" VerticalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.SharedDataService.GamesFiltered, Mode=OneWay}" Margin="0 4 0 16" HorizontalContentAlignment="Stretch" SelectedItem="{x:Bind ViewModel.SharedDataService.SelectedGame, Mode=TwoWay}" ItemContainerStyle="{StaticResource ListViewItemDefaultStyle}">
                <ListView.ItemTemplate>
                    <DataTemplate x:Name="CompactGameItemList" x:DataType="models:Game">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{Binding Images.Count, Converter={StaticResource ImagesCountToColorConverter}, Mode=OneWay}" CornerRadius="2" Width="20" Margin="0 4" Padding="0 0 0 2">
                                <TextBlock Text="{x:Bind Images.Count, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{x:Bind Title}" Margin="8 4" Foreground="{ThemeResource TextBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <template:SeparatorEx Grid.Row="3" Margin="0 0 0 8" VerticalAlignment="Bottom" Thickness="1" UseGradient="True"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="16 0 16 12" HorizontalAlignment="Right">
            <TextBlock Text="{x:Bind helpers:LocFmt.ShowingXofY(ViewModel.SharedDataService.GamesFiltered.Count, ViewModel.SharedDataService.SelectedPlatform.Games.Count), Mode=OneWay}" Foreground="{ThemeResource TextSecondaryBrush}"/>
        </StackPanel>
    </Grid>
</UserControl>

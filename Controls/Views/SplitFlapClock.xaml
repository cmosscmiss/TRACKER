<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Tracker.Controls.Views.SplitFlapClock"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Tracker.Controls.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Reloj split-flap HH:MM:SS. Los dígitos son tarjetas que vuelcan (SplitFlapDigit); los dos puntos que separan
         horas/minutos/segundos usan el color de acento del tema. Alimentado por la propiedad Value (tiempo restante). -->
    <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
        <views:SplitFlapDigit x:Name="H0"/>
        <views:SplitFlapDigit x:Name="H1"/>

        <StackPanel Orientation="Vertical" VerticalAlignment="Center" Spacing="6" Margin="3 0">
            <Ellipse Width="4" Height="4" Fill="{ThemeResource AccentBrush}"/>
            <Ellipse Width="4" Height="4" Fill="{ThemeResource AccentBrush}"/>
        </StackPanel>

        <views:SplitFlapDigit x:Name="M0"/>
        <views:SplitFlapDigit x:Name="M1"/>

        <StackPanel Orientation="Vertical" VerticalAlignment="Center" Spacing="6" Margin="3 0">
            <Ellipse Width="4" Height="4" Fill="{ThemeResource AccentBrush}"/>
            <Ellipse Width="4" Height="4" Fill="{ThemeResource AccentBrush}"/>
        </StackPanel>

        <views:SplitFlapDigit x:Name="S0"/>
        <views:SplitFlapDigit x:Name="S1"/>
    </StackPanel>
</UserControl>

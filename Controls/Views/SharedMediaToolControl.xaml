<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MM4LB.Controls.Views.SharedMediaToolControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="using:MM4LB.Controls.Views"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:template="using:MM4LB.Controls.Templates"
    xmlns:sys="using:System"
    xmlns:loc="using:MM4LB.Markup"
    xmlns:helpers="using:MM4LB.Helpers"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar: alterna tabla/grid y filtra por el tipo de medio seleccionado (sin borrado: la media es compartida). -->
        <uc:AdaptiveToolbarPanel Grid.Row="0">
            <uc:ExclusiveOptionsControl Header="{loc:Str Key=Common_View_Header}" VerticalAlignment="Center" SelectedValue="{x:Bind ViewModel.SelectedViewValue, Mode=TwoWay}">
                <uc:ExclusiveOption LabelKey="Common_TableView_Label" Glyph="&#xE8FD;" Value="Table"/>
                <uc:ExclusiveOption LabelKey="Common_GridView_Label" Glyph="&#xE8A9;" Value="Grid"/>
            </uc:ExclusiveOptionsControl>
            <template:SeparatorEx VerticalAlignment="Stretch" HorizontalAlignment="Center" Thickness="2" Margin="16 0" Orientation="Vertical" UseGradient="True" LineBrush="{ThemeResource AccentBrush}"/>
            <AppBarToggleButton Icon="Filter" Label="{loc:Str Key=Common_SelectedType_Label}" IsChecked="{x:Bind ViewModel.FilterBySelectedType, Mode=TwoWay}"/>
        </uc:AdaptiveToolbarPanel>

        <!-- Separador horizontal tras la toolbar. -->
        <template:SeparatorEx Grid.Row="1" Margin="0 8" VerticalAlignment="Bottom" Thickness="1" UseGradient="True"/>

        <!-- Contenido. -->
        <Grid Grid.Row="2">
            <!-- Vista TABLA: una fila por pareja juego ↔ media compartida. Click en fila → selecciona ese juego. -->
            <controls:DataGrid x:Name="dgShared"
                               ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
                               SelectedItem="{x:Bind ViewModel.SelectedRow, Mode=TwoWay}"
                               Visibility="{x:Bind ViewModel.IsTableView, Mode=OneWay, Converter={StaticResource VisibleIfTrueConverter}}"
                               HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible"
                               AutoGenerateColumns="False" CanUserSortColumns="True" CanUserReorderColumns="True" CanUserResizeColumns="True"
                               ColumnHeaderHeight="40" FrozenColumnCount="1" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                               IsReadOnly="True" SelectionMode="Single" Sorting="SharedDataGrid_Sorting">
                <controls:DataGrid.Columns>
                    <controls:DataGridTextColumn Width="320" Header="Game" Tag="Game" Binding="{Binding Game.Title}"/>
                    <controls:DataGridTextColumn Width="180" Header="Type" Tag="Type" Binding="{Binding Image.Type.Value}"/>
                    <controls:DataGridTextColumn Width="360" Header="File" Tag="File" Binding="{Binding Image.Name}"/>
                    <controls:DataGridTextColumn Header="Region" Tag="Region" Binding="{Binding Image.Region.Value}"/>
                </controls:DataGrid.Columns>
            </controls:DataGrid>

            <!-- Vista GRID: miniaturas de las media compartidas (decodificadas al hacer scroll). Click → primer juego. -->
            <uc:ImageGridControl Visibility="{x:Bind ViewModel.IsGridView, Mode=OneWay, Converter={StaticResource VisibleIfTrueConverter}}" ViewModel="{x:Bind ViewModel.IgViewModel}"/>

            <!-- Estado vacío: se escaneó y no hay media compartida. -->
            <TextBlock Text="{loc:Str Key=SharedMediaTool_Empty_Text}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center" Foreground="{ThemeResource TextSecondaryBrush}" Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay, Converter={StaticResource VisibleIfTrueConverter}}"/>
        </Grid>

        <!-- Separador antes del pie. -->
        <template:SeparatorEx Grid.Row="3" Margin="0 8" VerticalAlignment="Bottom" Thickness="1" UseGradient="True"/>

        <!-- Contador "Showing X of Y" (media compartidas mostradas / total de compartidas). -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock Text="{x:Bind helpers:LocFmt.ShowingXofY(ViewModel.ShownCount, ViewModel.TotalSharedCount), Mode=OneWay}" Foreground="{ThemeResource TextSecondaryBrush}"/>
        </StackPanel>

        <!-- Estadísticas de media compartida en pastillas. -->
        <uc:WidgetStatCardControl Grid.Row="5" VisualStyle="SplitPanel" ColorVariant="ThemeAccent" Glyph="&#xE8B9;" IconCollapsePillCount="4" HasBorder="True" Visibility="{x:Bind ViewModel.HasRun, Mode=OneWay, Converter={StaticResource VisibleIfTrueConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <uc:WidgetStatCardControl Grid.Column="0" VisualStyle="SplitPanel" ColorVariant="ThemeAccent" Label="{loc:Str Key=SharedMediaTool_Shared_Label}" Value="{x:Bind ViewModel.SharedRatio, Mode=OneWay}" Description="{loc:Str Key=SharedMediaTool_SharedRatio_Description}" HasBorder="False"/>
                <uc:WidgetStatCardControl Grid.Column="1" VisualStyle="SplitPanel" ColorVariant="ThemeAccent" Label="{loc:Str Key=Common_Size_Label}" Value="{x:Bind ViewModel.SizeRatio, Mode=OneWay}" Description="{loc:Str Key=SharedMediaTool_SizeRatio_Description}" HasBorder="False"/>
                <uc:WidgetStatCardControl Grid.Column="2" VisualStyle="SplitPanel" ColorVariant="ThemeAccent" Label="{loc:Str Key=Common_Types_Label}" Value="{x:Bind ViewModel.TypesRatio, Mode=OneWay}" Description="{loc:Str Key=SharedMediaTool_TypesRatio_Description}" HasBorder="False"/>
                <uc:WidgetStatCardControl Grid.Column="3" VisualStyle="SplitPanel" ColorVariant="ThemeAccent" Label="{loc:Str Key=SharedMediaTool_Games_Label}" Value="{x:Bind ViewModel.GamesRatio, Mode=OneWay}" Description="{loc:Str Key=SharedMediaTool_GamesRatio_Description}" HasBorder="False"/>
            </Grid>
        </uc:WidgetStatCardControl>
    </Grid>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MM4LB.Controls.Views.StatsPlatformControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="using:MM4LB.Controls.Views" xmlns:template="using:MM4LB.Controls.Templates"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    xmlns:sys="using:System"
    xmlns:loc="using:MM4LB.Markup"
    xmlns:help="using:MM4LB.Helpers"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Ámbito de tipos del eje X: favoritos (por defecto) o presentes en la plataforma -->
        <uc:AdaptiveToolbarPanel Grid.Row="0" Spacing="6" Margin="0 0 0 0">
            <uc:ExclusiveOptionsControl Header="{loc:Str Key=StatsPlatform_Scope_Header}" VerticalAlignment="Center" SelectedValue="{x:Bind ViewModel.SelectedScopeValue, Mode=TwoWay}">
                <uc:ExclusiveOption LabelKey="StatsPlatform_Favourites_Label" Glyph="&#xE735;" Value="Favourites"/>
                <uc:ExclusiveOption LabelKey="StatsPlatform_InPlatform_Label" Glyph="&#xF6C6;" Value="Present"/>
            </uc:ExclusiveOptionsControl>
            <template:SeparatorEx VerticalAlignment="Stretch" HorizontalAlignment="Center" Thickness="2" Margin="8 0" Orientation="Vertical" UseGradient="True" LineBrush="{ThemeResource AccentBrush}"/>
            <!-- Muestra/oculta el panel de resumen de cobertura -->
            <AppBarToggleButton Label="{loc:Str Key=StatsPlatform_Coverage_Label}" help:Help.Key="StatsPlatform_Coverage_Tooltip" IsChecked="{x:Bind ViewModel.IsCoverageVisible, Mode=TwoWay}">
                <AppBarToggleButton.Content>
                    <FontIcon Glyph="&#xE908;"/>
                </AppBarToggleButton.Content>
            </AppBarToggleButton>
        </uc:AdaptiveToolbarPanel>

        <template:SeparatorEx Grid.Row="1" Margin="0 8" VerticalAlignment="Bottom" Thickness="1" UseGradient="True"/>

        <!-- Resumen de cobertura: barra de la cobertura media de la plataforma + media de todas -->
        <uc:WidgetStatCardControl Grid.Row="2" VisualStyle="LateralAccentBar" ColorVariant="ThemeAccent" Visibility="{x:Bind ViewModel.IsCoverageVisible, Mode=OneWay, Converter={StaticResource VisibleIfTrueConverter}}">
            <StackPanel Orientation="Vertical">
                <StackPanel Padding="0 12">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{loc:Str Key=StatsPlatform_CoverageNow_Label}" FontSize="20" FontWeight="SemiBold" Opacity="0.8"/>
                        <TextBlock Text="{x:Bind ViewModel.PlatformCoverageText, Mode=OneWay}" Foreground="{ThemeResource AccentLightBrush}" FontSize="22" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Grid Height="32" Margin="0 4">
                        <Border Background="{ThemeResource AccentDarkBrush}" CornerRadius="8" Opacity="0.5" Margin="0 4"/>
                        <ProgressBar Value="{x:Bind ViewModel.PlatformCoveragePercent, Mode=OneWay}" Maximum="100" Margin="0 8" Background="Transparent" Foreground="{ThemeResource AccentBrush}" MinHeight="16" CornerRadius="8"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{loc:Str Key=StatsPlatform_AverageAll_Label}" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.AllPlatformsCoverageText, Mode=OneWay}" FontSize="18" Foreground="{ThemeResource AccentBrush}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </uc:WidgetStatCardControl>

        <!-- Gráficas (FlipView navegable). Cada una es un ChartTypeSelectorControl con su propia toolbar de tipo y
             el chart que controla; aquí solo se le pasan los datos (valores/etiquetas) calculados por el VM. -->
        <FlipView x:Name="ChartFlipView" Grid.Row="3" Background="Transparent" UseTouchAnimationsForAllNavigation="False" SelectedIndex="{x:Bind ViewModel.SelectedChartIndex, Mode=TwoWay}">
            <!-- Gráfica 1: cobertura de tipos de imagen por cada juego de la plataforma (área), con el juego seleccionado resaltado. Idéntica a la de GameStatsControl. -->
            <FlipViewItem>
                <uc:WidgetStatCardControl VisualStyle="LateralAccentBar" ColorVariant="ThemeAccent" ContentVerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Str Key=StatsPlatform_CoverageByGame_Title}" Margin="0 8" Style="{StaticResource TitleStyle}"/>
                            <Button Grid.Column="1" x:Name="CoverageByGameHelpButton" Style="{StaticResource Button_Icon}" Click="CoverageByGameHelp_Click" VerticalAlignment="Center" Margin="8 8 0 0" Padding="8" help:Help.AffordanceVisible="True" help:Help.Key="Common_Help_Tooltip">
                                <FontIcon Glyph="&#xE897;" FontSize="16"/>
                            </Button>
                            <TeachingTip Grid.Column="1" x:Name="CoverageByGameHelpTip" Target="{x:Bind CoverageByGameHelpButton}" IsLightDismissEnabled="True" PreferredPlacement="BottomLeft" Title="{loc:Str Key=StatsPlatform_CoverageByGame_Title}" Subtitle="{loc:Str Key=StatsPlatform_CoverageByGame_Help}"/>
                        </Grid>
                        <template:SeparatorEx Grid.Row="1" Margin="0 8 0 16" VerticalAlignment="Bottom" Thickness="1" UseGradient="True"/>
                        <lvc:CartesianChart Grid.Row="2" x:Name="CoverageByGameChart" Series="{x:Bind ViewModel.CoverageByGameSeries, Mode=OneWay}" XAxes="{x:Bind ViewModel.CoverageByGameXAxes, Mode=OneWay}" YAxes="{x:Bind ViewModel.CoverageByGameYAxes, Mode=OneWay}" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" LegendPosition="Hidden" Visibility="{x:Bind ViewModel.HasCoverageByGameData, Mode=OneWay, Converter={StaticResource VisibleIfTrueConverter}}"/>
                    </Grid>
                </uc:WidgetStatCardControl>
            </FlipViewItem>
            <!-- Gráfica 2: distribución de cobertura (nº de juegos por tramo de cobertura de favoritos) -->
            <FlipViewItem>
                <uc:WidgetStatCardControl VisualStyle="LateralAccentBar" ColorVariant="ThemeAccent" ContentVerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <uc:ChartTypeSelectorControl Grid.Row="1" Title="{loc:Str Key=StatsPlatform_CoverageDistribution_Title}" HelpText="{loc:Str Key=StatsPlatform_CoverageDistribution_Help}" Values="{x:Bind ViewModel.CoverageDistributionValues, Mode=OneWay}" Labels="{x:Bind ViewModel.CoverageDistributionLabels, Mode=OneWay}" LabelsRotation="0" SelectedChartType="{x:Bind ViewModel.CoverageDistributionChart.ChartType, Mode=TwoWay}" SortOrder="{x:Bind ViewModel.CoverageDistributionChart.SortOrder, Mode=TwoWay}" TopN="{x:Bind ViewModel.CoverageDistributionChart.TopN, Mode=TwoWay}"/>
                    </Grid>
                </uc:WidgetStatCardControl>
            </FlipViewItem>
            <!-- Gráfica 3: cobertura por tipo de imagen -->
            <FlipViewItem>
                <uc:WidgetStatCardControl VisualStyle="LateralAccentBar" ColorVariant="ThemeAccent" ContentVerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <uc:ChartTypeSelectorControl Grid.Row="3" Title="{loc:Str Key=StatsPlatform_CoverageByType_Title}" HelpText="{loc:Str Key=StatsPlatform_CoverageByType_Help}" Values="{x:Bind ViewModel.CoverageByTypeValues, Mode=OneWay}" Labels="{x:Bind ViewModel.CoverageByTypeLabels, Mode=OneWay}" HighlightIndex="{x:Bind ViewModel.CoverageByTypeHighlightIndex, Mode=OneWay}" ValueSuffix="%" ValueMax="100" LabelsRotation="45" SelectedChartType="{x:Bind ViewModel.CoverageByTypeChart.ChartType, Mode=TwoWay}" SortOrder="{x:Bind ViewModel.CoverageByTypeChart.SortOrder, Mode=TwoWay}" TopN="{x:Bind ViewModel.CoverageByTypeChart.TopN, Mode=TwoWay}"/>
                    </Grid>
                </uc:WidgetStatCardControl>
            </FlipViewItem>
            <!-- Gráfica 4: nº de imágenes por tipo (conteo bruto) de la plataforma seleccionada -->
            <FlipViewItem>
                <uc:WidgetStatCardControl VisualStyle="LateralAccentBar" ColorVariant="ThemeAccent" ContentVerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <uc:ChartTypeSelectorControl Grid.Row="1" Title="{loc:Str Key=StatsPlatform_MediaSetByType_Title}" HelpText="{loc:Str Key=StatsPlatform_MediaSetByType_Help}" Values="{x:Bind ViewModel.ImagesByTypeValues, Mode=OneWay}" Labels="{x:Bind ViewModel.ImagesByTypeLabels, Mode=OneWay}" HighlightIndex="{x:Bind ViewModel.ImagesByTypeHighlightIndex, Mode=OneWay}" ReferenceValue="{x:Bind ViewModel.PlatformGameCount, Mode=OneWay}" SelectedChartType="{x:Bind ViewModel.ImagesByTypeChart.ChartType, Mode=TwoWay}" SortOrder="{x:Bind ViewModel.ImagesByTypeChart.SortOrder, Mode=TwoWay}" TopN="{x:Bind ViewModel.ImagesByTypeChart.TopN, Mode=TwoWay}"/>
                    </Grid>
                </uc:WidgetStatCardControl>
            </FlipViewItem>
        </FlipView>

        <!-- Indicador del nº de gráficas y página actual del FlipView -->
        <PipsPager Grid.Row="4" HorizontalAlignment="Center" Margin="0 0 0 4" NumberOfPages="4" SelectedPageIndex="{x:Bind ChartFlipView.SelectedIndex, Mode=TwoWay}"/>

        <!-- Pastillas: valor de la plataforma / total (o media) de todas las plataformas -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <uc:WidgetStatCardControl Grid.Column="0" VisualStyle="SplitPanel" ColorVariant="ThemeAccent" Glyph="&#xE7FC;" IconCollapsePillCount="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"></ColumnDefinition>
                        <ColumnDefinition Width="1*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <uc:WidgetStatCardControl Grid.Column="0" VisualStyle="SplitPanel" ColorVariant="ThemeAccent" Label="{x:Bind ViewModel.GamesPill.Title, Mode=OneWay}" Value="{x:Bind ViewModel.GamesPill.ValueText, Mode=OneWay}" Description="{x:Bind ViewModel.GamesPill.Description, Mode=OneWay}" HasBorder="False"/>
                    <uc:WidgetStatCardControl Grid.Column="1" VisualStyle="SplitPanel" ColorVariant="ThemeAccent" Label="{loc:Str Key=StatsPlatform_CoveragePill_Label}" Value="{x:Bind sys:String.Format(x:Null,'{0} / {1}', ViewModel.PlatformCoverageText, ViewModel.AllPlatformsCoverageText), Mode=OneWay}" Description="{loc:Str Key=StatsPlatform_CoveragePill_Description}" HasBorder="False"/>
                </Grid>
            </uc:WidgetStatCardControl>
            <uc:WidgetStatCardControl Grid.Column="1" VisualStyle="SplitPanel" ColorVariant="ThemeAccent" Glyph="&#xE8B9;" IconCollapsePillCount="3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"></ColumnDefinition>
                        <ColumnDefinition Width="2*"></ColumnDefinition>
                        <ColumnDefinition Width="4*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <uc:WidgetStatCardControl Grid.Column="0" VisualStyle="SplitPanel" ColorVariant="ThemeAccent" Label="{x:Bind ViewModel.ImagePills.Images.Title, Mode=OneWay}" Value="{x:Bind ViewModel.ImagePills.Images.ValueText, Mode=OneWay}" Description="{x:Bind ViewModel.ImagePills.Images.Description, Mode=OneWay}" HasBorder="False"/>
                    <uc:WidgetStatCardControl Grid.Column="1" VisualStyle="SplitPanel" ColorVariant="ThemeAccent" Label="{x:Bind ViewModel.ImagePills.ImageTypes.Title, Mode=OneWay}" Value="{x:Bind ViewModel.ImagePills.ImageTypes.ValueText, Mode=OneWay}" Description="{x:Bind ViewModel.ImagePills.ImageTypes.Description, Mode=OneWay}" HasBorder="False"/>
                    <uc:WidgetStatCardControl Grid.Column="2" VisualStyle="SplitPanel" ColorVariant="ThemeAccent" Label="{x:Bind ViewModel.ImagePills.Size.Title, Mode=OneWay}" Value="{x:Bind ViewModel.ImagePills.Size.ValueText, Mode=OneWay}" Description="{x:Bind ViewModel.ImagePills.Size.Description, Mode=OneWay}" HasBorder="False"/>
                </Grid>
            </uc:WidgetStatCardControl>
        </Grid>
    </Grid>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MM4LB.Controls.Views.ToolsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="using:MM4LB.Controls.Views"
    mc:Ignorable="d">

    <!-- Contenedor de herramientas del dashboard: cada herramienta es una página del FlipView. Para añadir otra:
         un <FlipViewItem> nuevo con su control + subir NumberOfPages del PipsPager. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <FlipView x:Name="ToolsFlipView" Grid.Row="0" Background="Transparent" UseTouchAnimationsForAllNavigation="False" SelectedIndex="{x:Bind ViewModel.SelectedToolIndex, Mode=TwoWay}">
            <FlipViewItem>
                <uc:AuditPanelControl/>
            </FlipViewItem>
            <FlipViewItem>
                <uc:OrphanToolControl/>
            </FlipViewItem>
            <FlipViewItem>
                <uc:SharedMediaToolControl/>
            </FlipViewItem>
        </FlipView>

        <PipsPager Grid.Row="1" HorizontalAlignment="Center" Margin="0 4 0 0" NumberOfPages="3" SelectedPageIndex="{x:Bind ToolsFlipView.SelectedIndex, Mode=TwoWay}"/>
    </Grid>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Tracker.Controls.Views.FavoritesControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:uc="using:Tracker.Controls.Views"
    xmlns:vm="using:Tracker.Controls.ViewModels"
    xmlns:loc="using:Tracker.Markup"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- FlipView: página 0 = producto seleccionado, resto = favoritos. Cada página es la vista de producto. -->
        <FlipView x:Name="Flip" Grid.Row="0" ItemsSource="{x:Bind ViewModel.FavoriteViews, Mode=OneWay}" SelectedIndex="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <!-- Fuerza que cada página llene el alto del FlipView. -->
            <FlipView.ItemContainerStyle>
                <Style TargetType="FlipViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                </Style>
            </FlipView.ItemContainerStyle>
            <FlipView.ItemTemplate>
                <DataTemplate x:DataType="vm:PriceChartViewModel">
                    <uc:PriceChartControl ViewModel="{x:Bind}"/>
                </DataTemplate>
            </FlipView.ItemTemplate>
        </FlipView>
        <PipsPager Grid.Row="1" HorizontalAlignment="Center" Margin="0 4 0 8" NumberOfPages="{x:Bind ViewModel.FavoritesCount, Mode=OneWay}" MaxVisiblePips="{x:Bind ViewModel.FavoritesCount, Mode=OneWay}" SelectedPageIndex="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}" Visibility="{x:Bind ViewModel.ShowPager, Converter={StaticResource VisibleIfTrueConverter}, FallbackValue=Collapsed, Mode=OneWay}"/>
    </Grid>
</UserControl>

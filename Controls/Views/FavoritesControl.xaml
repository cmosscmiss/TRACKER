<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MM4LB.Controls.Views.FavoritesControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:uc="using:MM4LB.Controls.Views"
    xmlns:vm="using:MM4LB.Controls.ViewModels"
    xmlns:loc="using:MM4LB.Markup"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Un FlipView con la vista de producto (con su toolbar) por cada favorito. -->
        <FlipView x:Name="Flip" Grid.Row="0" ItemsSource="{x:Bind ViewModel.FavoriteViews, Mode=OneWay}"
                  SelectedIndex="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}"
                  Visibility="{x:Bind ViewModel.HasFavorites, Converter={StaticResource VisibleIfTrueConverter}, FallbackValue=Collapsed, Mode=OneWay}">
            <FlipView.ItemTemplate>
                <DataTemplate x:DataType="vm:PriceChartViewModel">
                    <uc:PriceChartControl ViewModel="{x:Bind}"/>
                </DataTemplate>
            </FlipView.ItemTemplate>
        </FlipView>

        <!-- Selector de vista (puntitos) sincronizado con el FlipView. -->
        <PipsPager Grid.Row="1" HorizontalAlignment="Center" Margin="0 4 0 8"
                   NumberOfPages="{x:Bind ViewModel.FavoritesCount, Mode=OneWay}"
                   SelectedPageIndex="{x:Bind Flip.SelectedIndex, Mode=TwoWay}"
                   Visibility="{x:Bind ViewModel.HasFavorites, Converter={StaticResource VisibleIfTrueConverter}, FallbackValue=Collapsed, Mode=OneWay}"/>

        <TextBlock Grid.RowSpan="2" Text="{loc:Str Key=FavoritesWidget_Empty}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{ThemeResource TextSecondaryBrush}"
                   Visibility="{x:Bind ViewModel.HasFavorites, Converter={StaticResource HiddenIfTrueConverter}, FallbackValue=Visible, Mode=OneWay}"/>
    </Grid>
</UserControl>

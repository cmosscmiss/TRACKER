<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MM4LB.Controls.Views.AboutSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:template="using:MM4LB.Controls.Templates"
    xmlns:loc="using:MM4LB.Markup"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Página de la categoría About: identidad de la app, descripción, detalles del build/runtime y componentes de
         terceros con su licencia. Solo lectura. DataContext heredado del SettingsDialogViewModel. -->
    <StackPanel Spacing="14">

        <!-- Identidad: marca + nombre + tagline + pastilla de build. -->
        <StackPanel Orientation="Horizontal" Spacing="16">
            <Border Width="72" Height="72" CornerRadius="16" BorderThickness="1" BorderBrush="{ThemeResource AccentDarkBrush}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{ThemeResource CardBackgroundLightColorOpacity80}" Offset="0"/>
                        <GradientStop Color="{ThemeResource BackgroundColorOpacity80}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <FontIcon Glyph="&#xE8B9;" FontSize="34" Foreground="{ThemeResource AccentLightBrush}"/>
            </Border>

            <StackPanel VerticalAlignment="Center" Spacing="6">
                <TextBlock Text="{loc:Str Key=Common_AppName}" FontSize="32" FontWeight="Bold" Foreground="{ThemeResource TextBrush}"/>
                <TextBlock Text="{loc:Str Key=AboutSettings_Tagline_Text}" FontSize="14" Foreground="{ThemeResource TextSecondaryBrush}"/>
                <Border HorizontalAlignment="Left" CornerRadius="10" Padding="9 3" Margin="0 2 0 0"
                        Background="{ThemeResource AccentBrushOpacity20}" BorderThickness="1" BorderBrush="{ThemeResource AccentDarkBrush}">
                    <TextBlock FontSize="12" Foreground="{ThemeResource AccentLightBrush}" Text="{Binding BuildText}"/>
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- Descripción. -->
        <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="21" Foreground="{ThemeResource TextBrush}"
                   Text="{loc:Str Key=AboutSettings_Description_Text}"/>

        <template:SeparatorEx Margin="0 4" Thickness="1" UseGradient="True"/>

        <!-- Detalles. -->
        <TextBlock Text="{loc:Str Key=AboutSettings_Details_Header}" FontSize="11" CharacterSpacing="140" Foreground="{ThemeResource TextSecondaryBrush}"/>
        <Grid ColumnSpacing="16" RowSpacing="9" ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Str Key=AboutSettings_Build_Label}" FontSize="13.5" Foreground="{ThemeResource TextSecondaryBrush}"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding BuildText}" FontSize="13.5" Foreground="{ThemeResource TextBrush}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Str Key=AboutSettings_Runtime_Label}" FontSize="13.5" Foreground="{ThemeResource TextSecondaryBrush}"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RuntimeText}" FontSize="13.5" Foreground="{ThemeResource TextBrush}"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Str Key=AboutSettings_Architecture_Label}" FontSize="13.5" Foreground="{ThemeResource TextSecondaryBrush}"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ArchitectureText}" FontSize="13.5" Foreground="{ThemeResource TextBrush}"/>
        </Grid>

        <template:SeparatorEx Margin="0 4" Thickness="1" UseGradient="True"/>

        <!-- Componentes de terceros (con su licencia). -->
        <TextBlock Text="{loc:Str Key=AboutSettings_ThirdParty_Header}" FontSize="11" CharacterSpacing="140" Foreground="{ThemeResource TextSecondaryBrush}"/>
        <ItemsControl ItemsSource="{Binding ThirdPartyLicenses}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto" Margin="0 3">
                        <TextBlock Grid.Column="0" Text="{Binding Component}" FontSize="13" Foreground="{ThemeResource TextBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding License}" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <template:SeparatorEx Margin="0 4" Thickness="1" UseGradient="True"/>

        <!-- Nota de acento por tema + copyright. -->
        <TextBlock FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" Text="{loc:Str Key=AboutSettings_AccentNote_Text}"/>
        <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}"
                   Text="{loc:Str Key=AboutSettings_Copyright_Text}"/>

    </StackPanel>
</UserControl>

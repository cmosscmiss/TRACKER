<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Tracker.Controls.Views.AboutSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:template="using:Tracker.Controls.Templates"
    xmlns:loc="using:Tracker.Markup"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Página de la categoría About. -->
    <StackPanel Spacing="14">
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image Source="ms-appx:///Assets/TRACKER-Logo-HR.png" Height="96" Stretch="Uniform" VerticalAlignment="Top"/>
            <StackPanel Grid.Column="1" Spacing="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Str Key=Common_AppName}" FontSize="26" FontWeight="Bold" Foreground="{ThemeResource TextBrush}"/>
                    <!-- Pastillas de identidad: versión declarada en el csproj y marca de compilación. -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                        <Border CornerRadius="4" Padding="9 3" Background="{ThemeResource AccentBrushOpacity20}" BorderThickness="1" BorderBrush="{ThemeResource AccentDarkBrush}">
                            <TextBlock FontSize="12" Foreground="{ThemeResource AccentLightBrush}" Text="{Binding VersionText}"/>
                        </Border>
                        <Border CornerRadius="4" Padding="9 3" Background="{ThemeResource AccentBrushOpacity20}" BorderThickness="1" BorderBrush="{ThemeResource AccentDarkBrush}">
                            <TextBlock FontSize="12" Foreground="{ThemeResource AccentLightBrush}" Text="{Binding BuildText}"/>
                        </Border>
                    </StackPanel>
                </Grid>
                <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="21" Foreground="{ThemeResource TextBrush}" Text="{loc:Str Key=AboutSettings_Description_Text}"/>
            </StackPanel>
        </Grid>

        <!-- Detalles: como las filas de la ficha de juego de MM4LB, el descriptor va ENCIMA del valor. -->
        <StackPanel Spacing="2">
            <TextBlock Text="{loc:Str Key=AboutSettings_Details_Header}" Style="{StaticResource GroupHeaderStyle}"/>
            <template:SeparatorEx Margin="0 4" Thickness="2" UseGradient="True" LineBrush="{ThemeResource AccentBrush}"/>
        </StackPanel>
        <StackPanel>
            <StackPanel Padding="20 0">
                <TextBlock Text="{loc:Str Key=AboutSettings_DevelopedBy_Label}" Style="{StaticResource FieldLabelStyle}"/>
                <TextBlock Text="Víctor BLÁZQUEZ (CMOSS)" Style="{StaticResource FieldValueStyle}"/>
            </StackPanel>
            <template:SeparatorEx Margin="0 8 0 0" Thickness="1" UseGradient="True"/>
        </StackPanel>
        <StackPanel>
            <StackPanel Padding="20 0">
                <TextBlock Text="{loc:Str Key=AboutSettings_Build_Label}" Style="{StaticResource FieldLabelStyle}"/>
                <TextBlock Text="{Binding BuildText}" Style="{StaticResource FieldValueStyle}"/>
            </StackPanel>
            <template:SeparatorEx Margin="0 8 0 0" Thickness="1" UseGradient="True"/>
        </StackPanel>
        <StackPanel>
            <StackPanel Padding="20 0">
                <TextBlock Text="{loc:Str Key=AboutSettings_Architecture_Label}" Style="{StaticResource FieldLabelStyle}"/>
                <TextBlock Text="{Binding ArchitectureText}" Style="{StaticResource FieldValueStyle}"/>
            </StackPanel>
            <template:SeparatorEx Margin="0 8 0 0" Thickness="1" UseGradient="True"/>
        </StackPanel>
        <StackPanel>
            <StackPanel Padding="20 0">
                <TextBlock Text="{loc:Str Key=AboutSettings_Runtime_Label}" Style="{StaticResource FieldLabelStyle}"/>
                <TextBlock Text="{Binding RuntimeText}" Style="{StaticResource FieldValueStyle}"/>
            </StackPanel>
            <template:SeparatorEx Margin="0 8 0 0" Thickness="1" UseGradient="True"/>
        </StackPanel>

        <!-- Componentes de terceros. -->
        <StackPanel Spacing="2" Margin="0 8 0 0">
            <TextBlock Text="{loc:Str Key=AboutSettings_ThirdParty_Header}" Style="{StaticResource GroupHeaderStyle}"/>
            <template:SeparatorEx Margin="0 4" Thickness="2" UseGradient="True" LineBrush="{ThemeResource AccentBrush}"/>
        </StackPanel>
        <ItemsControl ItemsSource="{Binding ThirdPartyLicenses}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <Grid Padding="20 0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Component}" Style="{StaticResource FieldValueStyle}"/>
                            <TextBlock Grid.Column="1" Text="{Binding License}" Style="{StaticResource FieldLabelStyle}"/>
                        </Grid>
                        <template:SeparatorEx Margin="0 8" Thickness="1" UseGradient="True"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>

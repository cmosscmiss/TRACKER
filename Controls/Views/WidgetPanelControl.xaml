<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MM4LB.Controls.Views.WidgetPanelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MM4LB.Controls.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:template="using:MM4LB.Controls.Templates"
    xmlns:help="using:MM4LB.Helpers"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <!-- Banda fija superior (ancho completo, fuera del sistema de slots): se ajusta a su contenido. Su alto
                 se anima a 0 al ocultarla para que el grid de widgets crezca hacia arriba (ver TopBandVisible). -->
            <RowDefinition x:Name="TopBandRow" Height="Auto"/>
            <!-- Grid de widgets (slots dinámicos, splitters, drag). -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Banda fija: contenido persistente a ancho completo, por encima del grid de widgets. No participa en el
             layout de slots (drag/resize/ocultar). El contenido lo aporta MainWindow vía TopBandContent. -->
        <ContentPresenter x:Name="TopBandHost" Grid.Row="0" HorizontalAlignment="Stretch" SizeChanged="OnTopBandHostSizeChanged" Content="{x:Bind TopBandContent, Mode=OneWay}"/>

        <Grid x:Name="WidgetGrid" Grid.Row="1" Margin="0" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <!-- MinWidth: evita que una columna se reduzca tanto (con los splitters o al estrechar el panel)
                     que el contenido entre en un layout patológico y congele la app. El Grid y el GridSplitter
                     respetan este mínimo al redimensionar. -->
                <ColumnDefinition Width="*" MinWidth="150"></ColumnDefinition>
                <ColumnDefinition Width="*" MinWidth="150"></ColumnDefinition>
                <ColumnDefinition Width="*" MinWidth="150"></ColumnDefinition>
            </Grid.ColumnDefinitions>
        </Grid>
        <Canvas x:Name="WidgetGridDragLayer" Grid.Row="1" IsHitTestVisible="False"/>

        <!-- Barra flotante de acciones de los splitters: aparece/desaparece junto con los splitters. -->
        <Border x:Name="SplittersToolbar" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30 30" Padding="12" Visibility="Collapsed" Opacity="0" Background="{ThemeResource BackgroundBrushOpacity80}" BorderBrush="{ThemeResource AccentDarkBrush}" BorderThickness="3" CornerRadius="16">
            <Border.Resources>
                <Style x:Key="SplittersToolbarButtonStyle" TargetType="Button">
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
                <!-- Efecto "breathe" entre los colores de acento (mismo timing que los splitters, 2,4 s) para
                     que el usuario advierta que la barra acaba de aparecer. Lo lanza el code-behind cuando la
                     toolbar se hace visible, animando el resplandor SplittersToolbarGlow. -->
                <Storyboard x:Key="SplittersToolbarBreatheStoryboard">
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SplittersToolbarGlow" Storyboard.TargetProperty="Opacity">
                        <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                        <LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="0.85"/>
                        <LinearDoubleKeyFrame KeyTime="0:0:2.0" Value="0.85"/>
                        <LinearDoubleKeyFrame KeyTime="0:0:2.4" Value="0"/>
                    </DoubleAnimationUsingKeyFrames>
                    <ColorAnimationUsingKeyFrames EnableDependentAnimation="True" Storyboard.TargetName="SplittersToolbarGlow" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)">
                        <LinearColorKeyFrame KeyTime="0:0:0" Value="{ThemeResource AccentColor}"/>
                        <LinearColorKeyFrame KeyTime="0:0:0.6" Value="{ThemeResource AccentLightColor}"/>
                        <LinearColorKeyFrame KeyTime="0:0:1.2" Value="{ThemeResource AccentDarkColor}"/>
                        <LinearColorKeyFrame KeyTime="0:0:1.8" Value="{ThemeResource AccentLightColor}"/>
                        <LinearColorKeyFrame KeyTime="0:0:2.4" Value="{ThemeResource AccentColor}"/>
                    </ColorAnimationUsingKeyFrames>
                </Storyboard>
            </Border.Resources>
            <Grid>
                <!-- Resplandor de atención; invisible en reposo, detrás de los botones para no taparlos. El
                     margen negativo cancela el Padding de la toolbar para que cubra TODO su interior (hasta
                     el borde), no solo la zona de los botones. -->
                <Border x:Name="SplittersToolbarGlow" Margin="-12" CornerRadius="14" Opacity="0" IsHitTestVisible="False">
                    <Border.Background>
                        <SolidColorBrush Color="{ThemeResource AccentColor}"/>
                    </Border.Background>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Style="{StaticResource SplittersToolbarButtonStyle}" Click="OnSplittersConfirm" help:Help.Key="WidgetPanel_SplittersConfirm_Tooltip">
                        <FontIcon Glyph="&#xE73E;" FontSize="32" Foreground="{ThemeResource SuccessBrush}"/>
                    </Button>
                    <Button Style="{StaticResource SplittersToolbarButtonStyle}" Click="OnSplittersCancel" help:Help.Key="WidgetPanel_SplittersCancel_Tooltip">
                        <FontIcon Glyph="&#xE711;" FontSize="32" Foreground="{ThemeResource DangerBrush}"/>
                    </Button>
                    <template:SeparatorEx VerticalAlignment="Stretch" HorizontalAlignment="Center" Thickness="2" Margin="8 0" Orientation="Vertical" UseGradient="True" LineBrush="{ThemeResource AccentBrush}" />
                    <Button Style="{StaticResource SplittersToolbarButtonStyle}" Click="OnSplittersDefault" help:Help.Key="WidgetPanel_SplittersDefault_Tooltip">
                        <FontIcon Glyph="&#xE777;" FontSize="32" Foreground="{ThemeResource TextSecondaryBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

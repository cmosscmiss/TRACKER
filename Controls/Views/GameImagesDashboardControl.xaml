<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MM4LB.Controls.Views.GameImagesDashboardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:uc="using:MM4LB.Controls.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:template="using:MM4LB.Controls.Templates"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:loc="using:MM4LB.Markup"
    xmlns:help="using:MM4LB.Helpers"
    mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="GameImageThumbnailTemplate">
            <uc:GameImageControl GameImage="{Binding}" />
        </DataTemplate>

        <!-- Mitad de la pastilla de process game: transparente (deja ver el gradiente de acento). En vez de un velo
             rectangular, al pasar el puntero enciende un GLOW RADIAL suave anclado a su borde EXTERIOR (según el
             HorizontalContentAlignment del botón: Left en la mitad izquierda, Right en la derecha), sobre la flecha
             y el título. El glow se apaga mucho antes del centro, así nunca solapa el separador diagonal. El botón
             solo aporta hit-testing + el glow; el contenido se dibuja aparte por debajo. -->
        <Style x:Key="ProcessDiagonalHalf" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" Background="{TemplateBinding Background}">
                            <Rectangle x:Name="Glow" Width="200" Opacity="0" IsHitTestVisible="False"
                                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                                <Rectangle.Fill>
                                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.75">
                                        <GradientStop Offset="0" Color="#CCFFFFFF"/>
                                        <GradientStop Offset="1" Color="#00FFFFFF"/>
                                    </RadialGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Glow.Opacity" Value="0.30"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Glow.Opacity" Value="0.45"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Grid.Row="1" Background="Transparent" AllowDrop="True"
          DragEnter="{x:Bind ViewModel.Dashboard_DragEnter}"
          DragOver="{x:Bind ViewModel.GameImages_DragOver}"
          DragLeave="{x:Bind ViewModel.Dashboard_DragLeave}"
          Drop="{x:Bind ViewModel.Dashboard_Drop}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Command bar to select the dashboard view. -->
        <Grid Grid.Row="1" VerticalAlignment="Top" Margin="0 8 0 0">
            <uc:AdaptiveToolbarPanel>
                <!-- Grupo excluyente de layout (Expanded/Collapsed/Auto según el ajuste global). -->
                <uc:ExclusiveOptionsControl Header="{loc:Str Key=Dashboard_Layout_Header}" VerticalAlignment="Center" SelectedValue="{x:Bind ViewModel.SelectedLayoutValue, Mode=TwoWay}">
                    <uc:ExclusiveOption LabelKey="Dashboard_HorView_Label" Glyph="&#xE76F;" Value="Horizontal"/>
                    <uc:ExclusiveOption LabelKey="Dashboard_VerView_Label" Glyph="&#xE784;" Value="Vertical"/>
                </uc:ExclusiveOptionsControl>
                <!-- Grupo de resolución de descarga de vídeo (incluido su separador): solo visible cuando el set
                     seleccionado es de vídeo; para imágenes no aplica. -->
                <StackPanel Orientation="Horizontal" Visibility="{x:Bind ViewModel.IsVideoSetSelected, Converter={StaticResource VisibleIfTrueConverter}, Mode=OneWay}">
                    <template:SeparatorEx VerticalAlignment="Stretch" HorizontalAlignment="Center" Thickness="2" Margin="16 0" Orientation="Vertical" UseGradient="True" LineBrush="{ThemeResource AccentBrush}" />
                    <!-- Resolución de descarga de vídeo de YouTube (excluyentes). Grupo Expanded/Collapsed/Auto. -->
                    <uc:ExclusiveOptionsControl Header="{loc:Str Key=Dashboard_VideoQuality_Header}" VerticalAlignment="Center" SelectedValue="{x:Bind ViewModel.SelectedVideoQualityValue, Mode=TwoWay}">
                        <uc:ExclusiveOption LabelKey="Dashboard_Quality240_Label" Glyph="&#xE714;" Value="240"/>
                        <uc:ExclusiveOption LabelKey="Dashboard_Quality360_Label" Glyph="&#xE714;" Value="360"/>
                        <uc:ExclusiveOption LabelKey="Dashboard_Quality480_Label" Glyph="&#xE714;" Value="480"/>
                        <uc:ExclusiveOption LabelKey="Dashboard_Quality720_Label" Glyph="&#xE714;" Value="720"/>
                        <uc:ExclusiveOption LabelKey="Dashboard_Quality1080_Label" Glyph="&#xE714;" Value="1080"/>
                    </uc:ExclusiveOptionsControl>
                </StackPanel>
                <template:SeparatorEx VerticalAlignment="Stretch" HorizontalAlignment="Center" Thickness="2" Margin="16 0" Orientation="Vertical" UseGradient="True" LineBrush="{ThemeResource AccentBrush}" />
                <AppBarToggleButton x:Name="SearchStringsPanelButton" Label="{loc:Str Key=Dashboard_Strings_Label}" help:Help.Key="Dashboard_Strings_Tooltip" IsChecked="{x:Bind ViewModel.IsSearchStringsPanelVisible, Mode=TwoWay}">
                    <AppBarToggleButton.Icon>
                        <FontIcon Glyph="&#xE773;" />
                    </AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <template:SeparatorEx VerticalAlignment="Stretch" HorizontalAlignment="Center" Thickness="2" Margin="16 0" Orientation="Vertical" UseGradient="True" LineBrush="{ThemeResource AccentBrush}" />
                <!-- Borrar el medio seleccionado del dashboard (con confirmación y undo). -->
                <AppBarButton Label="{loc:Str Key=Dashboard_Delete_Label}" help:Help.Key="Dashboard_Delete_Tooltip" Command="{x:Bind ViewModel.DeleteSelectedImageCommand, Mode=OneWay}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE74D;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <template:SeparatorEx VerticalAlignment="Stretch" HorizontalAlignment="Center" Thickness="2" Margin="16 0" Orientation="Vertical" UseGradient="True" LineBrush="{ThemeResource AccentBrush}" />
                <!-- Ver/editar los criterios de preselección y de proceso del dashboard. -->
                <AppBarButton Label="{loc:Str Key=Dashboard_Settings_Label}" help:Help.Key="Dashboard_Settings_Tooltip" Command="{x:Bind ViewModel.OpenSettingsCommand, Mode=OneWay}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </uc:AdaptiveToolbarPanel>
        </Grid>

        <template:SeparatorEx Grid.Row="2" Margin="0 8 0 16" VerticalAlignment="Bottom" Thickness="1" UseGradient="True"/>

        <Grid Grid.Row="3">
            <!-- Horizontal View -->
            <Grid Visibility="{x:Bind ViewModel.IsHorizontalView, Converter={StaticResource VisibleIfTrueConverter}, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" MinHeight="400"/>
                    <RowDefinition x:Name="HorizontalThumbnailRow" Height="400" MinHeight="200" MaxHeight="500"/>
                </Grid.RowDefinitions>
                
                <!-- Selected image preview -->
                <uc:GameImageControl Grid.Row="0" GameImage="{x:Bind ViewModel.SharedDataService.SelectedImage, Mode=TwoWay}" DisplayMode="StandAloneHorizontalMode" HostSlotIndex="{x:Bind ViewModel.SlotIndex, Mode=OneWay}" VideoVolume="{x:Bind ViewModel.EffectiveVideoVolume, Mode=OneWay}" ShowTransportControls="{x:Bind ViewModel.ShowVideoControls, Mode=OneWay}" IsSearchStringsPanelVisible="{x:Bind ViewModel.IsSearchStringsPanelVisible, Mode=TwoWay}"/>

                <!-- Horizontal thumbnails list -->
                <Grid x:Name="HorizontalThumbnailPanel" Grid.Row="1" Margin="0 16 0 0" SizeChanged="ThumbnailPanel_SizeChanged">
                    <ListView ItemsSource="{x:Bind ViewModel.SharedDataService.GameImages}" SelectedItem="{x:Bind ViewModel.SharedDataService.SelectedImage, Mode=OneWay}" SelectionChanged="GameImages_ImageSelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.VerticalScrollMode="Disabled" ItemContainerStyle="{StaticResource GameImagesListViewItemStyle}" ItemTemplate="{StaticResource GameImageThumbnailTemplate}" Padding="0 0 0 8">
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection>
                                <NavigationThemeTransition/>
                            </TransitionCollection>
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                    </ListView>
                </Grid>

                <toolkit:GridSplitter Grid.Row="1" Height="12" VerticalAlignment="Top" HorizontalAlignment="Stretch" ResizeDirection="Auto" ResizeBehavior="BasedOnAlignment" Style="{StaticResource GridSplitterHorizontalStyle}"/>
            </Grid>

            <!-- Vertical View -->
            <Grid Visibility="{x:Bind ViewModel.IsVerticalView, Converter={StaticResource VisibleIfTrueConverter}, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="400"/>
                    <ColumnDefinition x:Name="VerticalThumbnailColumn" Width="200" MinWidth="200" MaxWidth="600"/>
                </Grid.ColumnDefinitions>

                <!-- Selected image preview -->
                <uc:GameImageControl Grid.Column="0" GameImage="{x:Bind ViewModel.SharedDataService.SelectedImage, Mode=TwoWay}" DisplayMode="StandAloneVerticalMode" HostSlotIndex="{x:Bind ViewModel.SlotIndex, Mode=OneWay}" VideoVolume="{x:Bind ViewModel.EffectiveVideoVolume, Mode=OneWay}" ShowTransportControls="{x:Bind ViewModel.ShowVideoControls, Mode=OneWay}" IsSearchStringsPanelVisible="{x:Bind ViewModel.IsSearchStringsPanelVisible, Mode=TwoWay}"/>

                <!-- Vertical thumbnails list -->
                <Grid x:Name="VerticalThumbnailPanel" Grid.Column="1" Margin="16 0 0 0" SizeChanged="ThumbnailPanel_SizeChanged">
                    <ListView ItemsSource="{x:Bind ViewModel.SharedDataService.GameImages}" SelectedItem="{x:Bind ViewModel.SharedDataService.SelectedImage, Mode=OneWay}" SelectionChanged="GameImages_ImageSelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.VerticalScrollMode="Enabled" Padding="0 0 8 0" ItemContainerStyle="{StaticResource GameImagesListViewItemStyle}" ItemTemplate="{StaticResource GameImageThumbnailTemplate}">
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection>
                                <NavigationThemeTransition/>
                            </TransitionCollection>
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                    </ListView>
                </Grid>

                <toolkit:GridSplitter Grid.Column="1" Width="12" HorizontalAlignment="Left" VerticalAlignment="Stretch" ResizeDirection="Auto" ResizeBehavior="BasedOnAlignment" Background="{ThemeResource CardBackgroundLightBrush}" Style="{StaticResource GridSplitterVerticalStyle}"/>
            </Grid>

            <!-- Zona única de drop: cubre la imagen seleccionada y la lista; al soltar añade y selecciona -->
            <uc:DropTargetOverlayControl
                Visibility="{x:Bind ViewModel.IsDragActive, Converter={StaticResource VisibleIfTrueConverter}, Mode=OneWay}"
                AllowDrop="True" DragOver="{x:Bind ViewModel.GameImages_DragOver}" Drop="{x:Bind ViewModel.SelectedImage_Drop}"/>
        </Grid>

        <!-- Overlay de importación: cubre el área de imagen mientras se resuelve un drop (copia local o descarga web) -->
        <Grid Grid.Row="3" Background="{ThemeResource AccentDarkBrushOpacity40}"
              Visibility="{x:Bind ViewModel.IsImportingDrop, Converter={StaticResource VisibleIfTrueConverter}, Mode=OneWay}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <ProgressRing IsActive="True" Width="48" Height="48" Foreground="{ThemeResource AccentBrush}"/>
                <TextBlock Text="{loc:Str Key=Dashboard_Importing_Text}" HorizontalAlignment="Center" Foreground="{ThemeResource TextBrush}" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>

        <!-- Barra inferior "pastilla diagonal": una única pastilla partida en diagonal. Cada mitad procesa el juego
             actual (conservar el medio preferido, borrar el resto y renombrar el conservado) y se desliza al juego
             anterior / siguiente, mostrando su título (o el del juego actual en los extremos de la lista, donde
             procesa y se queda). El fondo de cada mitad es un gradiente de acento distinto y un fino corte diagonal
             las separa. Deshabilitación POR MITAD: solo la mitad "anterior" en el primer juego, o la "siguiente" en
             el último, y ademas con <=1 medio (nada que procesar ni a donde ir). La mitad deshabilitada se atenua,
             oculta su texto y no responde a hover. -->
        <Border Grid.Row="4" Margin="0 16 0 0" CornerRadius="14" Height="66"
                Background="{ThemeResource CardBackgroundBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Corte diagonal REAL y centrado mediante skew: cada mitad es un rectángulo de acento que se
                     extiende bajo la contraria (margen negativo) y comparte el MISMO SkewX y origen vertical (0.5),
                     así la costura entre ambos es una diagonal recta por el centro. El ángulo es constante en
                     píxeles (no depende del ancho) y todo queda recortado por el CornerRadius del Border. Un
                     gradiente lineal no servía: con la caja tan apaisada el eje queda casi horizontal y el corte
                     sale casi vertical. Decorativos => IsHitTestVisible=False para no robar clicks a los botones. -->
                <Rectangle Grid.Column="0" HorizontalAlignment="Stretch" Margin="-80 0 0 0"
                           IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5"
                           Opacity="{x:Bind ViewModel.IsProcessPreviousDisabled, Converter={StaticResource DimIfTrueConverter}, Mode=OneWay}">
                    <Rectangle.Fill>
                        <!-- Stops de tipo Color (tipo por valor): se refrescan por código en OnThemeChanged. -->
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop x:Name="ProcessPrevStopOuter" Offset="0" Color="{ThemeResource AccentDarkColor}"/>
                            <GradientStop x:Name="ProcessPrevStopInner" Offset="1" Color="{ThemeResource AccentColor}"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                    <Rectangle.RenderTransform>
                        <CompositeTransform SkewX="-24"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle Grid.Column="1" HorizontalAlignment="Stretch" Margin="0 0 -80 0"
                           IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5"
                           Opacity="{x:Bind ViewModel.IsProcessNextDisabled, Converter={StaticResource DimIfTrueConverter}, Mode=OneWay}">
                    <Rectangle.Fill>
                        <!-- Acento en el centro (junto a la costura) -> oscuro en el extremo exterior, donde va el
                             texto de "PROCESS & NEXT", para que contraste igual que la mitad izquierda. -->
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop x:Name="ProcessNextStopInner" Offset="0" Color="{ThemeResource AccentColor}"/>
                            <GradientStop x:Name="ProcessNextStopOuter" Offset="1" Color="{ThemeResource AccentDarkColor}"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                    <Rectangle.RenderTransform>
                        <CompositeTransform SkewX="-24"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
                <!-- Línea divisoria oscura sobre la costura (mismo skew y origen). -->
                <Rectangle Grid.ColumnSpan="2" Width="3" HorizontalAlignment="Center" Fill="#59000000"
                           IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                    <Rectangle.RenderTransform>
                        <CompositeTransform SkewX="-24"/>
                    </Rectangle.RenderTransform>
                </Rectangle>

                <!-- Contenido izquierdo (no captura clics; el botón de encima lo hace). Se oculta si la mitad
                     "anterior" está deshabilitada (primer juego con <=1 medio). -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" Margin="20 0 0 0"
                            VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"
                            Visibility="{x:Bind ViewModel.IsProcessPreviousEnabled, Converter={StaticResource VisibleIfTrueConverter}, Mode=OneWay}">
                    <FontIcon Glyph="&#xE76B;" FontSize="22" Foreground="{ThemeResource TextBrush}"/>
                    <StackPanel VerticalAlignment="Center" Spacing="0">
                        <TextBlock Text="{loc:Str Key=Dashboard_ProcessPrevious_Label}" FontSize="10" FontWeight="SemiBold"
                                   CharacterSpacing="90" Opacity="0.7" Foreground="{ThemeResource TextBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.PreviousGameTitle, Mode=OneWay}"
                                   FontSize="16" FontWeight="SemiBold" MaxLines="1" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Contenido derecho. Se oculta si la mitad "siguiente" está deshabilitada (último juego con <=1 medio). -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="0 0 20 0"
                            VerticalAlignment="Center" HorizontalAlignment="Right" IsHitTestVisible="False"
                            Visibility="{x:Bind ViewModel.IsProcessNextEnabled, Converter={StaticResource VisibleIfTrueConverter}, Mode=OneWay}">
                    <StackPanel VerticalAlignment="Center" Spacing="0">
                        <TextBlock Text="{loc:Str Key=Dashboard_ProcessNext_Label}" FontSize="10" FontWeight="SemiBold"
                                   CharacterSpacing="90" Opacity="0.7" HorizontalAlignment="Right"
                                   Foreground="{ThemeResource TextBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.NextGameTitle, Mode=OneWay}"
                                   FontSize="16" FontWeight="SemiBold" MaxLines="1" TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="Right" Foreground="{ThemeResource TextBrush}"/>
                    </StackPanel>
                    <FontIcon Glyph="&#xE76C;" FontSize="22" Foreground="{ThemeResource TextBrush}"/>
                </StackPanel>

                <!-- Zonas interactivas (encima): ocupan toda su mitad (área de click completa). El feedback de hover
                     es el glow radial del estilo, anclado al borde EXTERIOR vía HorizontalContentAlignment (Left en
                     la izquierda, Right en la derecha); como se apaga antes del centro, no hace falta recortar el
                     área para no tocar el separador. -->
                <Button Grid.Column="0" Style="{StaticResource ProcessDiagonalHalf}"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Command="{x:Bind ViewModel.ProcessPreviousGameCommand, Mode=OneWay}"
                        help:Help.Key="GameImagesDashboard_ProcessPrevious_Tooltip"/>
                <Button Grid.Column="1" Style="{StaticResource ProcessDiagonalHalf}"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Right"
                        Command="{x:Bind ViewModel.ProcessNextGameCommand, Mode=OneWay}"
                        help:Help.Key="GameImagesDashboard_ProcessNext_Tooltip"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
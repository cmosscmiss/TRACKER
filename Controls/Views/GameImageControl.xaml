<UserControl
    x:Class="MM4LB.Controls.Views.GameImageControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:uc="using:MM4LB.Controls.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="using:System"
    xmlns:loc="using:MM4LB.Markup"
    mc:Ignorable="d"
    x:Name="Root">

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="DisplayModeStates">
                <VisualState x:Name="Default">
                    <VisualState.Setters>
                        <Setter Target="RootFrame.BorderThickness" Value="0"/>
                        <Setter Target="RootFrame.BorderBrush" Value="Transparent"/>
                        <Setter Target="RootFrame.CornerRadius" Value="0"/>
                        <Setter Target="DefaultDisplayMode.Visibility" Value="Visible"/>
                        <Setter Target="StandAloneDisplayMode.Visibility" Value="Collapsed"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="StandAloneHorizontalMode">
                    <VisualState.Setters>
                        <Setter Target="RootFrame.BorderThickness" Value="2"/>
                        <Setter Target="RootFrame.BorderBrush" Value="{ThemeResource CardBackgroundLightBrush}"/>
                        <Setter Target="RootFrame.CornerRadius" Value="8"/>
                        <Setter Target="DefaultDisplayMode.Visibility" Value="Collapsed"/>
                        <Setter Target="StandAloneDisplayMode.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="StandAloneVerticalMode">
                    <VisualState.Setters>
                        <Setter Target="RootFrame.BorderThickness" Value="2"/>
                        <Setter Target="RootFrame.BorderBrush" Value="{ThemeResource CardBackgroundLightBrush}"/>
                        <Setter Target="RootFrame.CornerRadius" Value="8"/>
                        <Setter Target="DefaultDisplayMode.Visibility" Value="Collapsed"/>
                        <Setter Target="StandAloneDisplayMode.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="ImageOnly">
                    <VisualState.Setters>
                        <Setter Target="DefaultDisplayMode.Visibility" Value="Visible"/>
                        <Setter Target="StandAloneDisplayMode.Visibility" Value="Collapsed"/>
                        <Setter Target="DefaultInfoOverlay.Visibility" Value="Collapsed"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid x:Name="DefaultDisplayMode" Visibility="Visible">
            <Image Stretch="Uniform" Margin="4" Source="{x:Bind GameImage.Binary, Mode=OneWay}"/>
            <!-- Chapa de "play" para los items de vídeo (que no tienen bitmap): centrada sobre el hueco (modo ImageOnly). -->
            <Border Width="42" Height="42" CornerRadius="28" Background="{ThemeResource BackgroundColorOpacity80}" BorderBrush="{ThemeResource AccentBrush}" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind VideoBadgeVisibility(GameImage, DisplayMode), Mode=OneWay}">
                <FontIcon Glyph="&#xE768;" FontSize="24" Foreground="{ThemeResource TextSecondaryBrush}"/>
            </Border>
            <!-- Chapa de "play" en la esquina superior derecha: identifica los vídeos en listas/galerías mixtas (modo Default).
                 Un 30% más pequeña que la centrada para no tapar la miniatura. -->
            <Border Width="29" Height="29" CornerRadius="20" Background="{ThemeResource BackgroundColorOpacity80}" BorderBrush="{ThemeResource AccentBrush}" BorderThickness="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4" Visibility="{x:Bind VideoCornerBadgeVisibility(GameImage, DisplayMode), Mode=OneWay}">
                <FontIcon Glyph="&#xE768;" FontSize="17" Foreground="{ThemeResource TextSecondaryBrush}"/>
            </Border>
            <Grid x:Name="DefaultInfoOverlay" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Visibility="{x:Bind GameImage.Name, Converter={StaticResource HiddenIfNullConverter}, Mode=OneWay, FallbackValue=Collapsed}">
                <Rectangle Fill="{ThemeResource BackgroundColorOpacity80}"/>
                <StackPanel Orientation="Vertical" Padding="8 4">
                    <StackPanel.ChildrenTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition IsStaggeringEnabled="True" />
                        </TransitionCollection>
                    </StackPanel.ChildrenTransitions>
                    <!-- Fila 1: nombre del fichero (común a imagen y vídeo). -->
                    <TextBlock Text="{x:Bind GameImage.Name, Mode=OneWay}" Foreground="{ThemeResource TextBrush}" TextTrimming="CharacterEllipsis"/>

                    <!-- IMAGEN · Fila 2: Dimensiones · Tamaño · Extensión / Fila 3: región (carpeta hoja). -->
                    <StackPanel Orientation="Horizontal" Visibility="{x:Bind ImageOverlayVisibility(GameImage), Mode=OneWay}">
                        <TextBlock Text="{x:Bind GameImage.Dimensions, Mode=OneWay}" Foreground="{ThemeResource TextSecondaryBrush}"/>
                        <Ellipse Width="8" Height="8" Fill="{ThemeResource AccentDarkBrush}" VerticalAlignment="Center" Margin="8 4 8 0"/>
                        <TextBlock Text="{x:Bind sys:String.Format(x:Null,'{0} Kb', GameImage.FileSize), Mode=OneWay}" Foreground="{ThemeResource TextSecondaryBrush}"/>
                        <Ellipse Width="6" Height="6" Fill="{ThemeResource AccentDarkBrush}" VerticalAlignment="Center" Margin="8 4 8 0"/>
                        <TextBlock Text="{x:Bind GameImage.FileExtension, Mode=OneWay}" Foreground="{ThemeResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{x:Bind GameImage.FileLeafFolder, Mode=OneWay}" Foreground="{ThemeResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Visibility="{x:Bind ImageOverlayVisibility(GameImage), Mode=OneWay}"/>

                    <!-- VÍDEO · Fila 2: Calidad · Dimensiones · Duración / Fila 3: Tamaño · Extensión. -->
                    <StackPanel Orientation="Horizontal" Visibility="{x:Bind VideoOverlayVisibility(GameImage), Mode=OneWay}">
                        <TextBlock Text="{x:Bind VideoQuality(GameImage.Height), Mode=OneWay}" Foreground="{ThemeResource TextSecondaryBrush}"/>
                        <Ellipse Width="8" Height="8" Fill="{ThemeResource AccentDarkBrush}" VerticalAlignment="Center" Margin="8 4 8 0"/>
                        <TextBlock Text="{x:Bind GameImage.Dimensions, Mode=OneWay}" Foreground="{ThemeResource TextSecondaryBrush}"/>
                        <Ellipse Width="6" Height="6" Fill="{ThemeResource AccentDarkBrush}" VerticalAlignment="Center" Margin="8 4 8 0"/>
                        <TextBlock Text="{x:Bind GameImage.DurationText, Mode=OneWay}" Foreground="{ThemeResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{x:Bind VideoOverlayVisibility(GameImage), Mode=OneWay}">
                        <TextBlock Text="{x:Bind sys:String.Format(x:Null,'{0} Kb', GameImage.FileSize), Mode=OneWay}" Foreground="{ThemeResource TextSecondaryBrush}"/>
                        <Ellipse Width="6" Height="6" Fill="{ThemeResource AccentDarkBrush}" VerticalAlignment="Center" Margin="8 4 8 0"/>
                        <TextBlock Text="{x:Bind GameImage.FileExtension, Mode=OneWay}" Foreground="{ThemeResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
        <Grid x:Name="StandAloneDisplayMode" Visibility="Collapsed">
            <Border x:Name="RootFrame" BorderThickness="0" BorderBrush="Transparent" CornerRadius="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Image file name -->
                    <TextBlock Text="{x:Bind GameImage.Name, Mode=OneWay}" Margin="8 4" Style="{StaticResource TitleStyle}"></TextBlock>
                    <Grid x:Name="StandAloneLayoutGrid" Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="ImageRow" Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- Image area. Para vídeos, el Image actúa de póster (su Binary es el fotograma extraído) y
                             el MediaPlayerElement se revela encima solo cuando el primer frame ha decodificado
                             (OnVideoMediaOpened), evitando el flash negro del swap chain. -->
                        <Grid x:Name="ImageHost" Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" Tapped="ImageHost_Tapped">
                            <Image x:Name="Image" Source="{x:Bind GameImage.Binary, Mode=OneWay}" Stretch="Uniform" Margin="4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <MediaPlayerElement x:Name="PreviewVideo" Stretch="Uniform" Margin="4" AreTransportControlsEnabled="{x:Bind ShowTransportControls, Mode=OneWay}" Visibility="Collapsed"/>
                            <!-- Chapa de "play" mostrada cuando el vídeo está detenido (terminado o pausado sin controles);
                                 un toque en la imagen reinicia o reanuda. IsHitTestVisible=False para que el toque lo capte
                                 el Grid (ImageHost) en toda su superficie. -->
                            <Border x:Name="ReplayBadge" Width="56" Height="56" CornerRadius="28" Background="{ThemeResource BackgroundColorOpacity80}" BorderBrush="{ThemeResource AccentBrush}" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False">
                                <FontIcon Glyph="&#xE768;" FontSize="28" Foreground="{ThemeResource TextSecondaryBrush}"/>
                            </Border>
                        </Grid>
                        <!-- Search strings -->
                        <Grid Grid.Row="1" Visibility="{Binding IsSearchStringsPanelVisible, ElementName=Root, Converter={StaticResource VisibleIfTrueConverter},
                           Mode=OneWay}">
                            <uc:WidgetStatCardControl VisualStyle="LateralAccentBar"
                              ColorVariant="AccentDark">
                                <uc:SearchStringsControl SearchStringsSource="GameImage" />
                            </uc:WidgetStatCardControl>
                        </Grid>
                        <!-- Stats area -->
                        <Grid x:Name="WidgetStats" Grid.Row="2" VerticalAlignment="Bottom">
                            <uc:WidgetStatCardControl VisualStyle="LateralAccentBar" ColorVariant="AccentDark">
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <uc:WidgetStatCardControl VisualStyle="SplitPanel" Label="{loc:Str Key=Common_Dimensions_Label}" Value="{x:Bind GameImage.Dimensions, Mode=OneWay}" HasBorder="False"/>
                                    <uc:WidgetStatCardControl VisualStyle="SplitPanel" Label="{loc:Str Key=Common_FileSize_Label}" Value="{x:Bind sys:String.Format(x:Null, '{0} Kb', GameImage.FileSize), Mode=OneWay}" HasBorder="False"/>
                                    <uc:WidgetStatCardControl VisualStyle="SplitPanel" Label="{loc:Str Key=Common_Extension_Label}" Value="{x:Bind GameImage.FileExtension, Mode=OneWay}" HasBorder="False"/>
                                    <!-- Region para imágenes; para vídeos se sustituye por Quality (360p/720p/1080p) + Duration. -->
                                    <uc:WidgetStatCardControl VisualStyle="SplitPanel" Label="{loc:Str Key=Common_Region_Header}" Value="{x:Bind RegionText(GameImage.Region), Mode=OneWay}" HasBorder="False" Visibility="{x:Bind ImageRegionVisibility(GameImage), Mode=OneWay}"/>
                                    <uc:WidgetStatCardControl VisualStyle="SplitPanel" Label="{loc:Str Key=Common_Quality_Label}" Value="{x:Bind VideoQuality(GameImage.Height), Mode=OneWay}" HasBorder="False" Visibility="{x:Bind VideoInfoVisibility(GameImage), Mode=OneWay}"/>
                                    <uc:WidgetStatCardControl VisualStyle="SplitPanel" Label="{loc:Str Key=Common_Duration_Label}" Value="{x:Bind GameImage.DurationText, Mode=OneWay}" HasBorder="False" Visibility="{x:Bind VideoInfoVisibility(GameImage), Mode=OneWay}"/>
                                </StackPanel>                                
                            </uc:WidgetStatCardControl>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
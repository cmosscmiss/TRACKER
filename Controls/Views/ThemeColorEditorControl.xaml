<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Tracker.Controls.Views.ThemeColorEditorControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:template="using:Tracker.Controls.Templates"
    xmlns:loc="using:Tracker.Markup"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Contenido del diálogo de edición EN CALIENTE de colores del tema. -->
    <Grid ColumnSpacing="16" Padding="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Editor -->
        <StackPanel x:Name="EditorColumn" Grid.Column="0" Spacing="12" Width="280">
            <StackPanel Spacing="2">
                <TextBlock Text="{loc:Str Key=ThemeColors_Picker_Header}" Style="{StaticResource GroupHeaderStyle}"/>
                <template:SeparatorEx Margin="0 4" Thickness="2" UseGradient="True" LineBrush="{ThemeResource AccentBrush}"/>
            </StackPanel>

            <!-- Selector de color + botón de revertir. -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="ColorCombo" Grid.Column="0" HorizontalAlignment="Stretch" DisplayMemberPath="Display" SelectionChanged="OnColorSelectionChanged"/>
                <!-- Revierte el color seleccionado a su valor original (antes de los cambios en caliente). -->
                <Button x:Name="RevertButton" Grid.Column="1" Style="{StaticResource Button_Icon}" BorderThickness="0" Padding="8 0" VerticalAlignment="Stretch" Click="OnRevertClick" ToolTipService.ToolTip="{loc:Str Key=ThemeColors_Revert}">
                    <FontIcon Glyph="&#xE7A7;" FontSize="16"/>
                </Button>
            </Grid>
            <ColorPicker x:Name="Picker" IsAlphaEnabled="False" IsHexInputVisible="False" IsColorChannelTextInputVisible="True" ColorChanged="OnPickerColorChanged"/>
        </StackPanel>

        <!-- Separador vertical entre las dos secciones. -->
        <template:SeparatorEx Grid.Column="1" Orientation="Vertical" VerticalAlignment="Stretch" Thickness="2" UseGradient="True" LineBrush="{ThemeResource AccentBrush}"/>

        <!-- Lista de colores. -->
        <Grid Grid.Column="2" Width="470" RowSpacing="6" Height="{Binding ActualHeight, ElementName=EditorColumn}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Spacing="2">
                <TextBlock Text="{loc:Str Key=ThemeColors_Swatches}" Style="{StaticResource GroupHeaderStyle}"/>
                <template:SeparatorEx Margin="0 4" Thickness="2" UseGradient="True" LineBrush="{ThemeResource AccentBrush}"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ColorList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="10" Padding="0 3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="3">
                                    <Rectangle Width="44" Height="18" RadiusX="4" RadiusY="4" Fill="{Binding Swatch}" Stroke="{ThemeResource TextSecondaryBrush}" StrokeThickness="1"/>
                                    <Rectangle Width="44" Height="18" RadiusX="4" RadiusY="4" Fill="{Binding SwatchOpacity80}" Stroke="{ThemeResource TextSecondaryBrush}" StrokeThickness="1"/>
                                    <Rectangle Width="44" Height="18" RadiusX="4" RadiusY="4" Fill="{Binding SwatchOpacity60}" Stroke="{ThemeResource TextSecondaryBrush}" StrokeThickness="1"/>
                                    <Rectangle Width="44" Height="18" RadiusX="4" RadiusY="4" Fill="{Binding SwatchOpacity40}" Stroke="{ThemeResource TextSecondaryBrush}" StrokeThickness="1"/>
                                    <Rectangle Width="44" Height="18" RadiusX="4" RadiusY="4" Fill="{Binding SwatchOpacity20}" Stroke="{ThemeResource TextSecondaryBrush}" StrokeThickness="1"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Display}"/>
                                    <TextBlock Text="{Binding RgbText, Mode=OneWay}" Foreground="{ThemeResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Pie: ajuste del texto por contraste. Vive AQUÍ y no en la pestaña Theme de los ajustes (que sería su sitio
             "de manual") porque este diálogo se muestra sin atenuar el fondo: se ve el efecto sobre la app entera al
             instante. Se aplica en caliente y lo confirma el OK del diálogo, igual que los colores. -->
        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0 12 0 0">
            <template:SeparatorEx Margin="0 0 0 10" Thickness="2" UseGradient="True" LineBrush="{ThemeResource AccentBrush}"/>
            <CheckBox x:Name="ContrastTextCheck" Checked="OnContrastTextChanged" Unchecked="OnContrastTextChanged">
                <TextBlock Text="{loc:Str Key=ThemeColors_UseContrastText_Label}" Style="{StaticResource FieldLabelStyle}"/>
            </CheckBox>
        </StackPanel>
    </Grid>
</UserControl>

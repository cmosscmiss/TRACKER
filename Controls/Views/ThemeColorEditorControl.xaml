<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MM4LB.Controls.Views.ThemeColorEditorControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:template="using:MM4LB.Controls.Templates"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Contenido del diálogo de edición EN CALIENTE de colores del tema. Izquierda: combobox de color + ColorPicker
         (inputs de texto ocultos) + revertir. Derecha: lista de colores con su muestra base y las variantes de
         opacidad. Un separador vertical divide ambas secciones. -->
    <Grid ColumnSpacing="16" Padding="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Editor -->
        <StackPanel Grid.Column="0" Spacing="12" Width="280">
            <ComboBox x:Name="ColorCombo" Header="Color del tema" HorizontalAlignment="Stretch"
                      DisplayMemberPath="Display" SelectionChanged="OnColorSelectionChanged"/>
            <ColorPicker x:Name="Picker" IsAlphaEnabled="False"
                         IsHexInputVisible="False" IsColorChannelTextInputVisible="False"
                         ColorChanged="OnPickerColorChanged"/>
            <!-- Devuelve el color seleccionado a su valor original (antes de los cambios en caliente). -->
            <Button Content="Revertir" HorizontalAlignment="Stretch" Click="OnRevertClick"/>
        </StackPanel>

        <!-- Separador vertical entre las dos secciones. -->
        <template:SeparatorEx Grid.Column="1" Orientation="Vertical" VerticalAlignment="Stretch"
                              Thickness="2" UseGradient="True" LineBrush="{ThemeResource AccentBrush}"/>

        <!-- Lista de colores: muestra base + variantes de opacidad (80/60/40/20) + nombre. Cada muestra enlaza al
             brush VIVO del recurso (mutado in situ), así se actualiza en caliente. -->
        <StackPanel Grid.Column="2" Spacing="6" Width="470">
            <TextBlock Text="Muestras (base + opacidades)" FontWeight="SemiBold"/>
            <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ColorList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="10" Padding="0 3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="3">
                                    <Rectangle Width="44" Height="18" RadiusX="4" RadiusY="4" Fill="{Binding Swatch}" Stroke="{ThemeResource TextSecondaryBrush}" StrokeThickness="1"/>
                                    <Rectangle Width="44" Height="18" RadiusX="4" RadiusY="4" Fill="{Binding SwatchOpacity80}" Stroke="{ThemeResource TextSecondaryBrush}" StrokeThickness="1"/>
                                    <Rectangle Width="44" Height="18" RadiusX="4" RadiusY="4" Fill="{Binding SwatchOpacity60}" Stroke="{ThemeResource TextSecondaryBrush}" StrokeThickness="1"/>
                                    <Rectangle Width="44" Height="18" RadiusX="4" RadiusY="4" Fill="{Binding SwatchOpacity40}" Stroke="{ThemeResource TextSecondaryBrush}" StrokeThickness="1"/>
                                    <Rectangle Width="44" Height="18" RadiusX="4" RadiusY="4" Fill="{Binding SwatchOpacity20}" Stroke="{ThemeResource TextSecondaryBrush}" StrokeThickness="1"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Display}" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </Grid>
</UserControl>

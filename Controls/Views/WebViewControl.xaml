<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MM4LB.Controls.Views.WebViewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MM4LB.Controls.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:template="using:MM4LB.Controls.Templates"
    xmlns:loc="using:MM4LB.Markup"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <!-- Marketplace de Amazon: al cambiar, navega al mismo producto en ese dominio. -->
                <ComboBox x:Name="CountrySelector" MinWidth="72" VerticalAlignment="Center" SelectionChanged="OnCountryChanged"
                          ToolTipService.ToolTip="{loc:Str Key=WebView_Country_Tooltip}">
                    <ComboBoxItem Content="ES" Tag="es"/>
                    <ComboBoxItem Content="DE" Tag="de"/>
                    <ComboBoxItem Content="FR" Tag="fr"/>
                    <ComboBoxItem Content="BE" Tag="be"/>
                    <ComboBoxItem Content="NL" Tag="nl"/>
                </ComboBox>
                <template:SeparatorEx VerticalAlignment="Stretch" HorizontalAlignment="Center" Thickness="2" Margin="16 0 8 0" Orientation="Vertical" UseGradient="True" LineBrush="{ThemeResource AccentBrush}" />
                <AppBarButton x:Name="abNavigateBack" LabelPosition="Collapsed" Width="40" Click="AbNavigateBack_Click">
                    <AppBarButton.Content>
                        <FontIcon Glyph="&#xE0A6;" />
                    </AppBarButton.Content>
                </AppBarButton>
                <AppBarButton x:Name="abNavigateForward" LabelPosition="Collapsed" Width="40" Margin="0 0 8 0" Click="AbNavigateForward_Click">
                    <AppBarButton.Content>
                        <FontIcon Glyph="&#xE0AB;" />
                    </AppBarButton.Content>
                </AppBarButton>
            </StackPanel>
            <TextBox x:Name="tbAddressBar" Text="https://" Grid.Column="1" VerticalAlignment="Center" KeyDown="TbAddressBar_KeyDown"/>

            <!-- Altas desde la página mostrada: nuevo producto, o link alternativo del producto seleccionado. -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8 0 0 0">
                <Button x:Name="AddProductButton" Style="{StaticResource Button_Icon}" BorderThickness="0" Padding="8" VerticalAlignment="Center" Click="OnAddProductClick" ToolTipService.ToolTip="{loc:Str Key=WebView_AddProduct_Tooltip}">
                    <FontIcon Glyph="&#xE710;" FontSize="16"/>
                </Button>
                <Button x:Name="AddAltLinkButton" Style="{StaticResource Button_Icon}" BorderThickness="0" Padding="8" VerticalAlignment="Center" Margin="4 0 0 0" Click="OnAddAlternativeLinkClick" ToolTipService.ToolTip="{loc:Str Key=WebView_AddAltLink_Tooltip}">
                    <FontIcon Glyph="&#xE71B;" FontSize="16"/>
                </Button>
            </StackPanel>

        </Grid>

        <template:SeparatorEx Grid.Row="1" Margin="0 4 0 12" VerticalAlignment="Bottom" Thickness="1" UseGradient="True"/>

        <Grid Grid.Row="2">
            <controls:WebView2 x:Name="MyWebView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" CoreWebView2Initialized="MyWebView_CoreWebView2Initialized" NavigationCompleted="MyWebView_NavigationCompleted"/>
        </Grid>
    </Grid>
</UserControl>
<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MM4LB.Controls.Views.WebViewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MM4LB.Controls.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:template="using:MM4LB.Controls.Templates"
    xmlns:loc="using:MM4LB.Markup"
    xmlns:help="using:MM4LB.Helpers"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <!-- Marketplace de Amazon: toggle buttons excluyentes entre sí; al elegir uno, navega al mismo producto
                     en ese dominio. -->
                <StackPanel x:Name="CountryToggles" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"
                            help:Help.Key="WebView_Country_Tooltip">
                    <ToggleButton Content="ES" Tag="es" Click="OnCountryToggle" Style="{StaticResource ToggleButton_Icon}" MinWidth="40" Padding="8 4"/>
                    <ToggleButton Content="DE" Tag="de" Click="OnCountryToggle" Style="{StaticResource ToggleButton_Icon}" MinWidth="40" Padding="8 4"/>
                    <ToggleButton Content="FR" Tag="fr" Click="OnCountryToggle" Style="{StaticResource ToggleButton_Icon}" MinWidth="40" Padding="8 4"/>
                    <ToggleButton Content="BE" Tag="be" Click="OnCountryToggle" Style="{StaticResource ToggleButton_Icon}" MinWidth="40" Padding="8 4"/>
                    <ToggleButton Content="NL" Tag="nl" Click="OnCountryToggle" Style="{StaticResource ToggleButton_Icon}" MinWidth="40" Padding="8 4"/>
                </StackPanel>
                <template:SeparatorEx VerticalAlignment="Stretch" HorizontalAlignment="Center" Thickness="2" Margin="8 0" Orientation="Vertical" UseGradient="True" LineBrush="{ThemeResource AccentBrush}" />
                <AppBarButton x:Name="abNavigateBack" LabelPosition="Collapsed" Width="40" Click="AbNavigateBack_Click">
                    <AppBarButton.Content>
                        <FontIcon Glyph="&#xE0A6;" />
                    </AppBarButton.Content>
                </AppBarButton>
                <AppBarButton x:Name="abNavigateForward" LabelPosition="Collapsed" Width="40" Margin="0 0 8 0" Click="AbNavigateForward_Click">
                    <AppBarButton.Content>
                        <FontIcon Glyph="&#xE0AB;" />
                    </AppBarButton.Content>
                </AppBarButton>
            </StackPanel>
            <TextBox x:Name="tbAddressBar" Text="https://" Grid.Column="1" VerticalAlignment="Center" KeyDown="TbAddressBar_KeyDown"/>

            <!-- Altas desde la página mostrada: nuevo producto, o link alternativo del producto seleccionado; y al final,
                 tras un separador, los selectores del elemento de la imagen y del precio (deshabilitados en Amazon). -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8 0 0 0">
                <Button x:Name="AddProductButton" Style="{StaticResource Button_Icon}" BorderThickness="0" Padding="8" VerticalAlignment="Center" Click="OnAddProductClick" help:Help.Key="WebView_AddProduct_Tooltip">
                    <FontIcon Glyph="&#xE710;" FontSize="16"/>
                </Button>
                <Button x:Name="AddAltLinkButton" Style="{StaticResource Button_Icon}" BorderThickness="0" Padding="8" VerticalAlignment="Center" Margin="4 0 0 0" Click="OnAddAlternativeLinkClick" help:Help.Key="WebView_AddAltLink_Tooltip">
                    <FontIcon Glyph="&#xE71B;" FontSize="16"/>
                </Button>
                <template:SeparatorEx VerticalAlignment="Stretch" HorizontalAlignment="Center" Thickness="2" Margin="8 0" Orientation="Vertical" UseGradient="True" LineBrush="{ThemeResource AccentBrush}" />
                <Button x:Name="PickImageButton" Style="{StaticResource Button_Icon}" BorderThickness="0" Padding="8" VerticalAlignment="Center" Margin="0 0 4 0" Click="OnPickImageClick" help:Help.Key="WebView_PickImage_Tooltip">
                    <FontIcon Glyph="&#xEB9F;" FontSize="16"/>
                </Button>
                <Button x:Name="PickPriceButton" Style="{StaticResource Button_Icon}" BorderThickness="0" Padding="8" VerticalAlignment="Center" Click="OnPickPriceClick" help:Help.Key="WebView_PickPrice_Tooltip">
                    <FontIcon Glyph="&#xE719;" FontSize="16"/>
                </Button>
            </StackPanel>
        </Grid>

        <template:SeparatorEx Grid.Row="1" Margin="0 0 0 8" Thickness="1" UseGradient="True"/>

        <Grid Grid.Row="2">
            <controls:WebView2 x:Name="MyWebView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" CoreWebView2Initialized="MyWebView_CoreWebView2Initialized" NavigationCompleted="MyWebView_NavigationCompleted"/>
        </Grid>
    </Grid>
</UserControl>
<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MM4LB.Controls.Views.ProductListControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MM4LB.Controls.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MM4LB.Models"
    mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="ProductItemTemplate" x:DataType="models:Product">
            <Grid VerticalAlignment="Center" ColumnSpacing="8" Padding="4 2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Recuadro del precio: verde si bajó, rojo si subió, gris si igual/sin datos. -->
                <Border Grid.Column="0" Background="{x:Bind Trend, Converter={StaticResource PriceTrendToBrushConverter}, Mode=OneWay}" CornerRadius="6" Padding="6 2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind BestPriceText, Mode=OneWay}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                </Border>
                <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" Foreground="{ThemeResource TextBrush}" />
                <!-- Estrella de favorito tras el título. -->
                <FontIcon Grid.Column="2" Glyph="&#xE735;" FontSize="12" Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center" Margin="4 0 0 0"
                          Visibility="{x:Bind IsFavorite, Converter={StaticResource VisibleIfTrueConverter}, FallbackValue=Collapsed, Mode=OneWay}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <ListView x:Name="ProductListView" ItemsSource="{x:Bind ViewModel.SharedDataService.ProductSet.Products, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SharedDataService.SelectedProduct, Mode=TwoWay}" ItemTemplate="{StaticResource ProductItemTemplate}" ItemContainerStyle="{StaticResource ListViewItemDefaultStyle}" />
    </Grid>
</UserControl>

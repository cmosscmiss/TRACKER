<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Tracker.Controls.Views.ProductListControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Tracker.Controls.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Tracker.Models"
    xmlns:template="using:Tracker.Controls.Templates"
    xmlns:loc="using:Tracker.Markup"
    xmlns:help="using:Tracker.Helpers"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="ProductItemTemplate" x:DataType="models:Product">
            <Grid VerticalAlignment="Center" ColumnSpacing="8" Padding="4 2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Recuadro del precio: verde si bajó, rojo si subió, azul si es el mínimo histórico, gris si neutro. -->
                <Border Grid.Column="0" Background="{x:Bind ListPriceHighlight, Converter={StaticResource PriceHighlightToBrushConverter}, Mode=OneWay}" CornerRadius="6" Padding="6 2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ListPriceText, Mode=OneWay}" Foreground="{x:Bind ListPriceHighlight, Converter={StaticResource PriceHighlightTextConverter}, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"/>
                </Border>
                <!-- Título: el tono lo decide el modelo (comprado -> secundario; fila seleccionada -> sobre el acento). -->
                <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" Foreground="{x:Bind ListTitleTone, Converter={StaticResource ListTextToneConverter}, Mode=OneWay}" TextDecorations="{x:Bind IsPurchased, Converter={StaticResource StrikethroughIfTrueConverter}, Mode=OneWay}" />
                <!-- Iconos tras el título. -->
                <Grid Grid.Column="2" VerticalAlignment="Center" Margin="4 0 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE787;" FontSize="14" Foreground="{x:Bind ListIconTone, Converter={StaticResource ListTextToneConverter}, Mode=OneWay}" HorizontalAlignment="Center"
                              help:Help.Key="Product_Preorder_Tooltip" Visibility="{x:Bind IsPreorder, Converter={StaticResource VisibleIfTrueConverter}, FallbackValue=Collapsed, Mode=OneWay}"/>
                    <FontIcon Grid.Column="1" Glyph="&#xE7ED;" FontSize="14" Foreground="{x:Bind ListIconTone, Converter={StaticResource ListTextToneConverter}, Mode=OneWay}" HorizontalAlignment="Center"
                              help:Help.Key="PriceChart_BelowAlert_Tooltip" Visibility="{x:Bind IsBelowAlert, Converter={StaticResource VisibleIfTrueConverter}, FallbackValue=Collapsed, Mode=OneWay}"/>
                    <FontIcon Grid.Column="2" Glyph="&#xE7BA;" FontSize="14" Foreground="{x:Bind ListIconTone, Converter={StaticResource ListTextToneConverter}, Mode=OneWay}" HorizontalAlignment="Center"
                              help:Help.Key="Product_Issues_Tooltip" Visibility="{x:Bind HasIssues, Converter={StaticResource VisibleIfTrueConverter}, FallbackValue=Collapsed, Mode=OneWay}"/>
                    <FontIcon Grid.Column="3" Glyph="&#xE7B8;" FontSize="14" Foreground="{x:Bind ListIconTone, Converter={StaticResource ListTextToneConverter}, Mode=OneWay}" HorizontalAlignment="Center"
                              help:Help.Key="PriceChart_Shipping_Tooltip" Visibility="{x:Bind HasShipping, Converter={StaticResource VisibleIfTrueConverter}, FallbackValue=Collapsed, Mode=OneWay}"/>
                    <FontIcon Grid.Column="4" Glyph="&#xE735;" FontSize="14" Foreground="{x:Bind ListIconTone, Converter={StaticResource ListTextToneConverter}, Mode=OneWay}" HorizontalAlignment="Center"
                              Visibility="{x:Bind IsFavorite, Converter={StaticResource VisibleIfTrueConverter}, FallbackValue=Collapsed, Mode=OneWay}"/>
                    <FontIcon Grid.Column="5" Glyph="&#xE73E;" FontSize="14" Foreground="{x:Bind ListIconTone, Converter={StaticResource ListTextToneConverter}, Mode=OneWay}" HorizontalAlignment="Center" Width="18" help:Help.Key="PriceChart_Purchased_Tooltip" Visibility="{x:Bind IsPurchased, Converter={StaticResource VisibleIfTrueConverter}, FallbackValue=Collapsed, Mode=OneWay}"/>
                </Grid>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Banda de filtro. -->
        <Grid Grid.Row="0" ColumnSpacing="8" Padding="16 0 16 8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{x:Bind ViewModel.FilterBy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{loc:Str Key=ProductList_Filter_Placeholder}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <ToggleSplitButton IsChecked="{x:Bind ViewModel.FiltersEnabled, Mode=TwoWay}" help:Help.Key="ProductList_Filters_Tooltip">
                    <SymbolIcon Symbol="Filter"/>
                    <ToggleSplitButton.Flyout>
                        <!-- Los items los crea el code-behind (BuildFilterMenu): van ORDENADOS ALFABÉTICAMENTE por su
                             texto ya traducido, así que el orden depende del idioma y se rehace al cambiarlo. -->
                        <MenuFlyout x:Name="FiltersFlyout"/>
                    </ToggleSplitButton.Flyout>
                </ToggleSplitButton>
                <!-- Orden -->
                <ToggleSplitButton x:Name="SortButton" IsChecked="{x:Bind ViewModel.SortByPrice, Mode=TwoWay}" help:Help.Key="ProductList_Sort_Tooltip">
                    <SymbolIcon Symbol="Sort"/>
                    <ToggleSplitButton.Flyout>
                        <!-- A diferencia del de filtros, este menú NO se ordena alfabéticamente: el orden fijo
                             (asc/desc dentro de cada criterio, separados por una línea) se lee mejor. -->
                        <MenuFlyout>
                            <ToggleMenuFlyoutItem x:Name="SortPriceAscItem" Tag="price-asc" IsChecked="True" Text="{loc:Str Key=ProductList_SortPriceAsc_Label}" Click="OnSortDirectionClick"/>
                            <ToggleMenuFlyoutItem x:Name="SortPriceDescItem" Tag="price-desc" Text="{loc:Str Key=ProductList_SortPriceDesc_Label}" Click="OnSortDirectionClick"/>
                            <MenuFlyoutSeparator/>
                            <ToggleMenuFlyoutItem x:Name="SortDateAscItem" Tag="date-asc" Text="{loc:Str Key=ProductList_SortDateAsc_Label}" Click="OnSortDirectionClick"/>
                            <ToggleMenuFlyoutItem x:Name="SortDateDescItem" Tag="date-desc" Text="{loc:Str Key=ProductList_SortDateDesc_Label}" Click="OnSortDirectionClick"/>
                        </MenuFlyout>
                    </ToggleSplitButton.Flyout>
                </ToggleSplitButton>
            </StackPanel>
        </Grid>

        <!-- Distribución de precios sobre el slider -->
        <local:PriceHistogramControl Grid.Row="1" Height="60" Margin="16 8 16 2" BarSpacing="1.5" Values="{x:Bind ViewModel.PriceHistogram, Mode=OneWay}" Minimum="{x:Bind ViewModel.PriceFloor, Mode=OneWay}" Maximum="{x:Bind ViewModel.PriceCeiling, Mode=OneWay}" RangeStart="{x:Bind ViewModel.MinPrice, Mode=OneWay}" RangeEnd="{x:Bind ViewModel.MaxPrice, Mode=OneWay}" InRangeBrush="{ThemeResource AccentBrush}" OutOfRangeBrush="{ThemeResource TextSecondaryBrush}"/>

        <!-- Rango de precio -->
        <toolkit:RangeSelector x:Name="PriceRangeSelector" Grid.Row="2" Margin="16 0 16 8" HorizontalAlignment="Stretch" VerticalAlignment="Center" Minimum="{x:Bind ViewModel.PriceFloor, Mode=OneWay}" Maximum="{x:Bind ViewModel.PriceCeiling, Mode=OneWay}" RangeStart="{x:Bind ViewModel.MinPrice, Mode=TwoWay}" RangeEnd="{x:Bind ViewModel.MaxPrice, Mode=TwoWay}" StepFrequency="1" help:Help.Key="ProductList_PriceRange_Tooltip"/>
       
        <ListView x:Name="ProductListView" Grid.Row="3" ItemsSource="{x:Bind ViewModel.FilteredProducts, Mode=OneWay}" SelectionChanged="OnSelectionChanged" ItemTemplate="{StaticResource ProductItemTemplate}" ItemContainerStyle="{StaticResource ListViewItemDefaultStyle}" />

        <template:SeparatorEx Grid.Row="4" Margin="0 0 0 8" VerticalAlignment="Bottom" Thickness="1" UseGradient="True"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="16 0 16 12" HorizontalAlignment="Right">
            <TextBlock Text="{x:Bind ViewModel.CountText, Mode=OneWay}" Foreground="{ThemeResource TextSecondaryBrush}"/>
        </StackPanel>
    </Grid>
</UserControl>

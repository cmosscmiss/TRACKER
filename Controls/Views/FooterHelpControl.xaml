<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MM4LB.Controls.Views.FooterHelpControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MM4LB.Controls.Views"
    xmlns:loc="using:MM4LB.Markup"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Toggle de ayuda del footer: alterna en caliente si se muestran los tooltips y los paneles de ayuda de toda la
         app (SharedDataService.HelpTooltipsEnabled). Estado por color como el control de sonido (acento = activada,
         atenuado = desactivada). Su propio tooltip NO se cierra con el toggle (usa {loc:Str} directo) para que siga
         siendo descubrible cuando la ayuda está apagada. -->
    <Button x:Name="HelpButton" Style="{StaticResource Button_Icon}" BorderThickness="0" Padding="10 0" VerticalAlignment="Stretch"
            Click="HelpButton_Click" ToolTipService.ToolTip="{loc:Str Key=FooterHelp_Toggle_Tooltip}">
        <Grid>
            <FontIcon FontSize="18" Glyph="&#xE897;" Foreground="{ThemeResource AccentBrush}" Visibility="{x:Bind Shared.HelpTooltipsEnabled, Mode=OneWay, Converter={StaticResource VisibleIfTrueConverter}}"/>
            <FontIcon FontSize="18" Glyph="&#xE897;" Foreground="{ThemeResource TextSecondaryBrush}" Visibility="{x:Bind Shared.HelpTooltipsEnabled, Mode=OneWay, Converter={StaticResource HiddenIfTrueConverter}}"/>
        </Grid>
    </Button>
</UserControl>

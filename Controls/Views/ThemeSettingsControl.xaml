<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Tracker.Controls.Views.ThemeSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:template="using:Tracker.Controls.Templates"
    xmlns:loc="using:Tracker.Markup"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Página de la categoría Theme. Mismo patrón de grupo/fila que la página General. -->
    <StackPanel Spacing="12">
        <!-- TEMA -->
        <StackPanel Spacing="2">
            <TextBlock Text="{loc:Str Key=ThemeSettings_ThemeSection_Header}" Style="{StaticResource GroupHeaderStyle}"/>
            <template:SeparatorEx Margin="0 4" Thickness="2" UseGradient="True" LineBrush="{ThemeResource AccentBrush}"/>
        </StackPanel>
        <StackPanel Padding="20 0" Spacing="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Str Key=ThemeSettings_Theme_Label}" Style="{StaticResource FieldLabelStyle}"/>
                <ComboBox Grid.Column="1" MinWidth="220" HorizontalAlignment="Left" ItemsSource="{Binding ThemeNames}" SelectedItem="{Binding SelectedThemeName, Mode=TwoWay}"/>
            </Grid>
            <CheckBox IsChecked="{Binding RandomTheme, Mode=TwoWay}">
                <TextBlock Text="{loc:Str Key=ThemeSettings_RandomTheme_Label}" Style="{StaticResource FieldLabelStyle}"/>
            </CheckBox>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding UseCustomColors, Mode=TwoWay}" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Str Key=ThemeSettings_UseCustomColors_Label}" Style="{StaticResource FieldLabelStyle}"/>
                </CheckBox>
                <!-- Icono + texto, como los botones del pie del AppDialog, y con SU MISMO estilo (Button_Default, que
                     atenúa el Disabled con la opacidad del chrome). El icono es un TextBlock con la fuente de
                     símbolos, no un FontIcon: el FontIcon trae su propio Foreground del estilo de WinUI, así que no
                     hereda el del contenido del botón y se quedaba en blanco puro; enlazarlo por Binding tampoco vale,
                     porque un Foreground HEREDADO no re-evalúa el binding. -->
                <Button x:Name="EditColorsButton" Grid.Column="1" Style="{StaticResource Button_Default}" HorizontalAlignment="Left" Command="{Binding EditColorsCommand}" IsEnabled="{Binding UseCustomColors}">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="&#xE790;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Str Key=ThemeSettings_EditColors_Label}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>

        <!-- OVERLAY DEL FONDO (ventana principal) -->
        <StackPanel Spacing="2" Margin="0 8 0 0">
            <TextBlock Text="{loc:Str Key=ThemeSettings_BackgroundOverlay_Header}" Style="{StaticResource GroupHeaderStyle}"/>
            <template:SeparatorEx Margin="0 4" Thickness="2" UseGradient="True" LineBrush="{ThemeResource AccentBrush}"/>
        </StackPanel>
        <!-- Preview en vivo del fondo del tema seleccionado (staging, no aplicado). -->
        <StackPanel>
            <Border Margin="20 0" CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource CardBackgroundLightBrush}">
                <template:TintedImage Height="160" HorizontalAlignment="Stretch" Source="{Binding ThemePreviewSource}" TintColor="{Binding ThemePreviewTintColor}" TintOpacity="{Binding TintOpacity}" TintSaturation="{Binding TintSaturation}" TintBrightness="{Binding TintBrightness}" BlendMode="Hue"/>
            </Border>
        </StackPanel>
        <StackPanel Padding="20 0" Spacing="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="64"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Str Key=ThemeSettings_OverlayBlur_Label}" Style="{StaticResource FieldLabelStyle}"/>
                <Slider Grid.Column="1" Minimum="0" Maximum="50" StepFrequency="1" VerticalAlignment="Center" Value="{Binding OverlayImageBlur, Mode=TwoWay}"/>
                <TextBlock Grid.Column="2" Margin="0 0 8 0" HorizontalAlignment="Right" Style="{StaticResource FieldValueStyle}" Text="{Binding OverlayImageBlur}"/>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="64"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Str Key=ThemeSettings_OverlayOpacity_Label}" Style="{StaticResource FieldLabelStyle}"/>
                <Slider Grid.Column="1" Minimum="0" Maximum="1" StepFrequency="0.01" VerticalAlignment="Center" Value="{Binding OverlayImageOpacity, Mode=TwoWay}"/>
                <TextBlock Grid.Column="2" Margin="0 0 8 0" HorizontalAlignment="Right" Style="{StaticResource FieldValueStyle}" Text="{Binding OverlayImageOpacity}"/>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="64"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Str Key=ThemeSettings_TintBrightness_Label}" Style="{StaticResource FieldLabelStyle}"/>
                <Slider Grid.Column="1" Minimum="0" Maximum="2" StepFrequency="0.01" VerticalAlignment="Center" Value="{Binding TintBrightness, Mode=TwoWay}"/>
                <TextBlock Grid.Column="2" Margin="0 0 8 0" HorizontalAlignment="Right" Style="{StaticResource FieldValueStyle}" Text="{Binding TintBrightness}"/>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="64"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Str Key=ThemeSettings_TintOpacity_Label}" Style="{StaticResource FieldLabelStyle}"/>
                <Slider Grid.Column="1" Minimum="0" Maximum="1" StepFrequency="0.01" VerticalAlignment="Center" Value="{Binding TintOpacity, Mode=TwoWay}"/>
                <TextBlock Grid.Column="2" Margin="0 0 8 0" HorizontalAlignment="Right" Style="{StaticResource FieldValueStyle}" Text="{Binding TintOpacity}"/>
            </Grid>
            <Grid >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="64"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Str Key=ThemeSettings_TintSaturation_Label}" Style="{StaticResource FieldLabelStyle}"/>
                <Slider Grid.Column="1" Minimum="0" Maximum="2" StepFrequency="0.01" VerticalAlignment="Center" Value="{Binding TintSaturation, Mode=TwoWay}"/>
                <TextBlock Grid.Column="2" Margin="0 0 8 0" HorizontalAlignment="Right" Style="{StaticResource FieldValueStyle}" Text="{Binding TintSaturation}"/>
            </Grid>
        </StackPanel>
    </StackPanel>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MM4LB.Controls.Views.ImageCollectionImportControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:template="using:MM4LB.Controls.Templates"
    xmlns:uc="using:MM4LB.Controls.Views" xmlns:sys="using:System"
    xmlns:loc="using:MM4LB.Markup"
    xmlns:help="using:MM4LB.Helpers"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar of the control: AppBar buttons SUELTOS (fuera de CommandBar) para que el label salga debajo,
             como en las demás toolbars. La CommandBar tiene altura fija ~48px y recortaba el label inferior. -->
        <StackPanel Orientation="Horizontal">
            <AppBarButton Icon="BrowsePhotos" Label="{loc:Str Key=ImageCollectionImport_Folder_Label}" help:Help.Key="ImageCollectionImport_Folder_Tooltip" Command="{x:Bind ViewModel.SelectFolderCommand}"/>
            <template:SeparatorEx VerticalAlignment="Stretch" HorizontalAlignment="Center" Thickness="2" Margin="16 0" Orientation="Vertical" UseGradient="True" LineBrush="{ThemeResource AccentBrush}" />
            <AppBarButton Label="{loc:Str Key=ImageCollectionImport_Import_Label}" help:Help.Key="ImageCollectionImport_Import_Tooltip" Command="{x:Bind ViewModel.ImportImagesCommand}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xF16C;"/>
                </AppBarButton.Icon>
            </AppBarButton>
            <template:SeparatorEx VerticalAlignment="Stretch" HorizontalAlignment="Center" Thickness="2" Margin="16 0" Orientation="Vertical" UseGradient="True" LineBrush="{ThemeResource AccentBrush}" />
            <AppBarToggleButton x:Name="atbImagesView" Label="{loc:Str Key=ImageCollectionImport_Media_Label}" IsChecked="{x:Bind ViewModel.IsImagesView, Mode=TwoWay}" Click="AtbView_Click">
                <AppBarToggleButton.Icon>
                    <FontIcon Glyph="&#xF0E2;" />
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>
            <AppBarToggleButton x:Name="atbGamesView" Label="{loc:Str Key=ImageCollectionImport_Games_Label}" IsChecked="{x:Bind ViewModel.IsGamesView, Mode=TwoWay}" Click="AtbView_Click">
                <AppBarToggleButton.Icon>
                    <FontIcon Glyph="&#xE8FD;" />
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>
        </StackPanel>
        
        <template:SeparatorEx Grid.Row="1" Margin="0 8" VerticalAlignment="Bottom" Thickness="1" UseGradient="True" />

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>                
                <RowDefinition Height="{x:Bind atbImagesView.IsChecked, Mode=OneWay, Converter={StaticResource StarIfTrueConverter}}"/>
                <RowDefinition Height="{x:Bind atbGamesView.IsChecked, Mode=OneWay, Converter={StaticResource StarIfTrueConverter}}"/>
            </Grid.RowDefinitions>
            <uc:ImageGridControl Grid.Row="0" Visibility="{x:Bind atbImagesView.IsChecked, Mode=OneWay, Converter={StaticResource VisibleIfTrueConverter}}" ViewModel="{x:Bind ViewModel}"></uc:ImageGridControl>
            <uc:GamesAuditControl Grid.Row="1" ViewModel="{x:Bind ViewModel.GaViewModel}" IsHeaderVisible="False" IsEnabled="{x:Bind IsEnabled}" Visibility="{x:Bind atbGamesView.IsChecked, Mode=OneWay, Converter={StaticResource VisibleIfTrueConverter}}"/>
        </Grid>        
        <!-- Statistics (hidden until a source folder has been selected) -->
        <uc:WidgetStatCardControl Grid.Row="3" VisualStyle="SplitPanel" ColorVariant="ThemeAccent" Glyph="&#xE838;" IconCollapsePillCount="4" HasBorder="True"
                                  Visibility="{x:Bind ViewModel.HasSelectedFolder, Mode=OneWay, Converter={StaticResource VisibleIfTrueConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"></ColumnDefinition>
                    <ColumnDefinition Width="1*"></ColumnDefinition>
                    <ColumnDefinition Width="1*"></ColumnDefinition>
                    <ColumnDefinition Width="1*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <uc:WidgetStatCardControl Grid.Column="0" VisualStyle="SplitPanel" ColorVariant="ThemeAccent" Label="{x:Bind ViewModel.StatisticsImages.Extension.Title, Mode=OneWay}" Value="{x:Bind ViewModel.StatisticsImages.Extension.ValueText, Mode=OneWay}" Description="{x:Bind ViewModel.StatisticsImages.Extension.Description, Mode=OneWay}" HasBorder="False"/>
                <uc:WidgetStatCardControl Grid.Column="1" VisualStyle="SplitPanel" ColorVariant="ThemeAccent" Label="{x:Bind ViewModel.StatisticsImages.Dimensions.Title, Mode=OneWay}" Value="{x:Bind ViewModel.StatisticsImages.Dimensions.ValueText, Mode=OneWay}" Description="{x:Bind ViewModel.StatisticsImages.Dimensions.Description, Mode=OneWay}" HasBorder="False"/>
                <uc:WidgetStatCardControl Grid.Column="2" VisualStyle="SplitPanel" ColorVariant="ThemeAccent" Label="{x:Bind ViewModel.StatisticsImages.MatchedImages.Title, Mode=OneWay}" Value="{x:Bind ViewModel.StatisticsImages.MatchedImages.ValueText, Mode=OneWay}" Description="{x:Bind ViewModel.StatisticsImages.MatchedImages.Description, Mode=OneWay}" HasBorder="False"/>
                <uc:WidgetStatCardControl Grid.Column="3" VisualStyle="SplitPanel" ColorVariant="ThemeAccent" Label="{x:Bind ViewModel.StatisticsImages.MatchedGames.Title, Mode=OneWay}" Value="{x:Bind ViewModel.StatisticsImages.MatchedGames.ValueText, Mode=OneWay}" Description="{x:Bind ViewModel.StatisticsImages.MatchedGames.Description, Mode=OneWay}" HasBorder="False"/>
            </Grid>
        </uc:WidgetStatCardControl>
    </Grid>
</UserControl>

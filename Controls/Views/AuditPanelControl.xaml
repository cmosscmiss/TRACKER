<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MM4LB.Controls.Views.AuditPanelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="using:MM4LB.Controls.Views"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:template="using:MM4LB.Controls.Templates"
    xmlns:sys="using:System"
    xmlns:loc="using:MM4LB.Markup"
    xmlns:helpers="using:MM4LB.Helpers"
    mc:Ignorable="d">

    <Grid>
        <!-- Contenido -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Toolbar: AppBar buttons SUELTOS (fuera de CommandBar) para que el label salga DEBAJO del icono, con
                 separador vertical entre el "Check media" y los filtros. -->
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <AppBarButton Icon="OpenFile" Label="{loc:Str Key=AuditPanel_CheckMedia_Label}" helpers:Help.Key="AuditPanel_CheckMedia_Tooltip" Command="{x:Bind ViewModel.RunCheckCommand}"/>
                <template:SeparatorEx VerticalAlignment="Stretch" HorizontalAlignment="Center" Thickness="2" Margin="16 0" Orientation="Vertical" UseGradient="True" LineBrush="{ThemeResource AccentBrush}"/>
                <AppBarToggleButton Icon="Filter" Label="{loc:Str Key=AuditPanel_OnlyDiscrepancies_Label}" helpers:Help.Key="AuditPanel_OnlyDiscrepancies_Tooltip" IsChecked="{x:Bind ViewModel.ShowOnlyDiscrepancies, Mode=TwoWay}"/>
                <AppBarToggleButton Icon="Pictures" Label="{loc:Str Key=AuditPanel_SelectedMediaType_Label}" helpers:Help.Key="AuditPanel_SelectedMediaType_Tooltip" IsChecked="{x:Bind ViewModel.FilterBySelectedType, Mode=TwoWay}"/>
            </StackPanel>

            <!-- Separador horizontal tras la toolbar -->
            <template:SeparatorEx Grid.Row="1" Margin="0 8" VerticalAlignment="Bottom" Thickness="1" UseGradient="True"/>

            <!-- Fichero chequeado: solo el nombre, en una pill (como las Strings del GameImagesDashboard). El Value
                 usa TitleStyle, que ya recorta con ellipsis si el nombre es largo. -->
            <uc:WidgetStatCardControl Grid.Row="2" Margin="0 4" VisualStyle="LateralAccentBar" ColorVariant="ThemeAccent" Label="{loc:Str Key=AuditPanel_ImportedFile_Label}" Value="{x:Bind ViewModel.AuditedFileName, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasRun, Mode=OneWay, Converter={StaticResource VisibleIfTrueConverter}}"/>

            <!-- Avisos no fatales -->
            <InfoBar Grid.Row="3" Severity="Warning" IsClosable="True" Margin="0 0 0 6" IsOpen="{x:Bind ViewModel.HasWarnings, Mode=OneWay}" Title="{loc:Str Key=AuditPanel_Warnings_Title}" Message="{x:Bind ViewModel.Warnings, Mode=OneWay}"/>

            <!-- Tabla de resultados (formato largo: una fila por celda juego×categoría) -->
            <Grid Grid.Row="4">
                <controls:DataGrid x:Name="dgAudit" ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible" AutoGenerateColumns="False" CanUserSortColumns="True" CanUserReorderColumns="True" CanUserResizeColumns="True" ColumnHeaderHeight="40" FrozenColumnCount="1" GridLinesVisibility="Horizontal" HeadersVisibility="Column" IsReadOnly="True" SelectionMode="Single" SelectionChanged="AuditDataGrid_SelectionChanged" Sorting="AuditDataGrid_Sorting">
                    <controls:DataGrid.Columns>
                        <controls:DataGridTextColumn Width="320" Header="Game" Tag="GameTitle" Binding="{Binding GameTitle}"/>
                        <controls:DataGridTextColumn Width="200" Header="Category" Tag="CategoryName" Binding="{Binding CategoryName}"/>
                        <controls:DataGridTextColumn Header="LaunchBox" Tag="ExcelCount" Binding="{Binding ExcelCount}"/>
                        <controls:DataGridTextColumn Header="MM4LB" Tag="Mm4lbCount" Binding="{Binding Mm4lbCount}"/>
                        <controls:DataGridTextColumn Header="&#916;" Tag="Diff" Binding="{Binding Diff}"/>
                        <controls:DataGridTemplateColumn Header="Status" Tag="Status" Width="120" CanUserSort="True">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="4 0">
                                        <Ellipse Width="12" Height="12" VerticalAlignment="Center" Fill="{Binding Status, Converter={StaticResource AuditStatusToBrushConverter}}"/>
                                        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                        </controls:DataGridTemplateColumn>
                    </controls:DataGrid.Columns>
                </controls:DataGrid>

                <!-- Estado vacío -->
                <TextBlock Text="{loc:Str Key=AuditPanel_Empty_Text}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center" Foreground="{ThemeResource TextSecondaryBrush}" Visibility="{x:Bind ViewModel.HasRun, Mode=OneWay, Converter={StaticResource HiddenIfTrueConverter}}"/>
            </Grid>

            <template:SeparatorEx Grid.Row="5" Margin="0 8" VerticalAlignment="Bottom" Thickness="1" UseGradient="True" Visibility="{x:Bind ViewModel.HasRun, Mode=OneWay, Converter={StaticResource VisibleIfTrueConverter}}"/>

            <!-- Contador "Showing X of Y" (filas mostradas en la tabla / total del chequeo). -->
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{x:Bind ViewModel.HasRun, Mode=OneWay, Converter={StaticResource VisibleIfTrueConverter}}">
                <TextBlock Text="{x:Bind helpers:LocFmt.ShowingXofY(ViewModel.ShownRowsCount, ViewModel.TotalRowsCount), Mode=OneWay}" Foreground="{ThemeResource TextSecondaryBrush}"/>
            </StackPanel>

            <!-- Resumen en pills (como el resto de widgets) -->
            <uc:WidgetStatCardControl Grid.Row="7" VisualStyle="SplitPanel" ColorVariant="ThemeAccent" Glyph="&#xE9D9;" IconCollapsePillCount="5" Visibility="{x:Bind ViewModel.HasRun, Mode=OneWay, Converter={StaticResource VisibleIfTrueConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <uc:WidgetStatCardControl Grid.Column="0" VisualStyle="SplitPanel" ColorVariant="ThemeAccent" Label="{loc:Str Key=AuditPanel_Compared_Label}" Value="{x:Bind ViewModel.GamesComparedText, Mode=OneWay}" Description="{loc:Str Key=AuditPanel_Compared_Description}" HasBorder="False"/>
                    <uc:WidgetStatCardControl Grid.Column="1" VisualStyle="SplitPanel" ColorVariant="ThemeAccent" Label="{loc:Str Key=AuditPanel_Discrepancies_Label}" Value="{x:Bind ViewModel.GamesWithDiscrepanciesText, Mode=OneWay}" Description="{loc:Str Key=AuditPanel_Discrepancies_Description}" HasBorder="False"/>
                    <uc:WidgetStatCardControl Grid.Column="2" VisualStyle="SplitPanel" ColorVariant="ThemeAccent" Label="{loc:Str Key=AuditPanel_WrongFiles_Label}" Value="{x:Bind ViewModel.WrongMediaFilesText, Mode=OneWay}" Description="{loc:Str Key=AuditPanel_WrongFiles_Description}" HasBorder="False"/>
                    <uc:WidgetStatCardControl Grid.Column="3" VisualStyle="SplitPanel" ColorVariant="ThemeAccent" Label="{loc:Str Key=AuditPanel_NotMatched_Label}" Value="{x:Bind ViewModel.RowsNotMatchedText, Mode=OneWay}" Description="{loc:Str Key=AuditPanel_NotMatched_Description}" HasBorder="False"/>
                    <uc:WidgetStatCardControl Grid.Column="4" VisualStyle="SplitPanel" ColorVariant="ThemeAccent" Label="{loc:Str Key=AuditPanel_NotInExcel_Label}" Value="{x:Bind ViewModel.GamesNotInExcelText, Mode=OneWay}" Description="{loc:Str Key=AuditPanel_NotInExcel_Description}" HasBorder="False"/>
                </Grid>
            </uc:WidgetStatCardControl>
        </Grid>

        <!-- Overlay de "ocupado": cubre TODO el control durante el chequeo (atenúa, bloquea interacción, cursor de
             espera y ring centrado). Mismo patrón que la capa de ocupado de MainWindow. -->
        <template:BusyOverlayPanel Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource VisibleIfTrueConverter}}">
            <template:BusyOverlayPanel.Background>
                <SolidColorBrush Color="{ThemeResource BackgroundColor}" Opacity="0.7"/>
            </template:BusyOverlayPanel.Background>
            <ProgressRing IsActive="True" Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource AccentBrush}"/>
        </template:BusyOverlayPanel>
    </Grid>
</UserControl>

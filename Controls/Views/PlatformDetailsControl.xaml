<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MM4LB.Controls.Views.PlatformDetailsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:uc="using:MM4LB.Controls.Views"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:template="using:MM4LB.Controls.Templates"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    xmlns:loc="using:MM4LB.Markup"
    xmlns:help="using:MM4LB.Helpers"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="PlatformImagesListViewItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource GameImagesListViewItemStyle}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0 0 2 0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Rectangle Fill="{ThemeResource BackgroundLightBrush}" Opacity="0.75"/>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="480"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <!-- Fanart de fondo con máscara de opacidad vertical (estilo máscara de capa de Photoshop) WinUI3 no tiene OpacityMask, así que se resuelve por composición en TintedImage. TintColor=White con Multiply = identidad (sin tinte); Opacity atenúa el fanart como antes. -->
                <template:TintedImage Source="{x:Bind ViewModel.SharedDataService.SelectedPlatform.Fanart.File, Mode=OneWay}" TintColor="White" Opacity="0.55" FadeMaskEnabled="True" FadeStart="0.45" FadeEnd="0.9"/>
            </Grid>

            <Grid x:Name="ContentRoot" Grid.Row="1" Margin="0 -430 0 0">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="ContentTranslate"/>
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Image x:Name="PlatformLogo" Grid.Row="0" Width="320" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5" Source="{x:Bind ViewModel.SharedDataService.SelectedPlatform.Logo.Binary, Mode=OneWay}" Visibility="{x:Bind ViewModel.SharedDataService.SelectedPlatform.Logo.HasBinary, Mode=OneWay}">
                    <Image.RenderTransform>
                        <ScaleTransform x:Name="LogoScale"/>
                    </Image.RenderTransform>
                </Image>
                <TextBlock x:Name="PlatformName" Grid.Row="0" Margin="16 8" HorizontalAlignment="Center" Text="{x:Bind ViewModel.SharedDataService.SelectedPlatform.Name, Mode=OneWay}" FontSize="32" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="600" Visibility="{x:Bind ViewModel.SharedDataService.SelectedPlatform.Logo.HasBinary, Converter={StaticResource HiddenIfTrueConverter}, Mode=OneWay}"/>
                <!-- Recuadro de previsualización: muestra la imagen propia SELECCIONADA en la tira (por defecto el Fanart, o la primera disponible si no hay Fanart). -->
                <Border x:Name="PreviewFrame" Grid.Row="1" Margin="16 48 16 0" Padding="2" BorderBrush="{ThemeResource TextBrushOpacity20}" BorderThickness="2"
                    Background="Transparent" AllowDrop="True"
                    DragEnter="{x:Bind ViewModel.Preview_DragEnter}" DragOver="{x:Bind ViewModel.Preview_DragOver}" DragLeave="{x:Bind ViewModel.Preview_DragLeave}"
                    Visibility="{x:Bind ViewModel.SharedDataService.SelectedPlatform, Converter={StaticResource HiddenIfNullConverter}, Mode=OneWay}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- Imagen/vídeo seleccionado: mantiene 16:9 (la altura se deriva del ancho en el code-behind), conservando proporción y tamaño aunque debajo vaya la tira. -->
                        <Grid x:Name="PreviewImageArea" Grid.Row="0" SizeChanged="PreviewFrame_SizeChanged">
                            <!-- Imagen seleccionada, o el póster (frame extraído) del vídeo mientras carga. Se
                                 enlaza a propiedades del VM (no a SelectedOwnImage.Binary directamente) para que
                                 el recuadro se limpie de forma fiable al pasar la selección a null: x:Bind retiene
                                 el último valor del leaf cuando el intermedio SelectedOwnImage queda en null. -->
                            <Image Stretch="Uniform" Source="{x:Bind ViewModel.SelectedOwnImageBinary, Mode=OneWay}" Visibility="{x:Bind ViewModel.SelectedOwnImageHasBinary, Mode=OneWay}"/>
                            <!-- Vídeo de la plataforma: reproducción autoplay, silenciada y en bucle, sin controles. -->
                            <MediaPlayerElement x:Name="PreviewVideo" Stretch="Uniform" AreTransportControlsEnabled="False" Tapped="PreviewVideo_Tapped" Visibility="Collapsed"/>
                            <!-- Chapa de "play" mostrada cuando el vídeo está pausado (no hay controles); un toque sobre el
                                 vídeo lo reanuda. IsHitTestVisible=False para que el toque lo capte el MediaPlayerElement. -->
                            <Border x:Name="PlayBadge" Width="56" Height="56" CornerRadius="28" Background="{ThemeResource BackgroundColorOpacity80}" BorderBrush="{ThemeResource AccentBrush}" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False">
                                <FontIcon Glyph="&#xE768;" FontSize="28" Foreground="{ThemeResource TextSecondaryBrush}"/>
                            </Border>
                            <!-- Estado vacío: la plataforma aún no tiene imágenes/vídeo propios. El recuadro sigue
                                 visible para arrastrar aquí el primer fichero. Mismo lenguaje que el resto de zonas
                                 de drop (DropTargetOverlayControl): borde punteado redondeado + icono de subida y
                                 texto, en tono de reposo. Se oculta entero al entrar el puntero en la zona de drop
                                 (IsDragActive), cuando el overlay de acento toma el relevo. -->
                            <Grid Visibility="{x:Bind ViewModel.ShowEmptyDropHint, Converter={StaticResource VisibleIfTrueConverter}, Mode=OneWay}">
                                <Rectangle Margin="8" RadiusX="8" RadiusY="8" StrokeThickness="2"
                                           StrokeDashArray="4 3" StrokeDashCap="Round"
                                           Stroke="{ThemeResource TextSecondaryBrush}"/>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                    <FontIcon Glyph="&#xE710;" FontSize="48" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{loc:Str Key=PlatformDetails_DropHint_Text}" FontSize="14" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                        <!-- Tira de miniaturas seleccionable. La selección alimenta la previsualización de arriba. -->
                        <ListView Grid.Row="1" Margin="0 8 0 0" SelectionMode="Single" ItemsSource="{x:Bind ViewModel.OwnImages, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedOwnImage, Mode=TwoWay}" ItemContainerStyle="{StaticResource PlatformImagesListViewItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.VerticalScrollMode="Disabled">
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection>
                                    <NavigationThemeTransition/>
                                </TransitionCollection>
                            </ListView.ItemContainerTransitions>
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <uc:GameImageControl GameImage="{Binding}" DisplayMode="ImageOnly" Height="100"/>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Zona de drop sobre la imagen/vídeo + la tira: overlay punteado mientras se
                             arrastra, y overlay de progreso mientras se importa el fichero soltado. -->
                        <uc:DropTargetOverlayControl Grid.Row="0" Grid.RowSpan="2"
                            Visibility="{x:Bind ViewModel.IsDragActive, Converter={StaticResource VisibleIfTrueConverter}, Mode=OneWay}"
                            AllowDrop="True" DragOver="{x:Bind ViewModel.Preview_DragOver}" Drop="{x:Bind ViewModel.Preview_Drop}"/>
                        <Grid Grid.Row="0" Grid.RowSpan="2" Background="{ThemeResource AccentDarkBrushOpacity40}"
                              Visibility="{x:Bind ViewModel.IsImportingDrop, Converter={StaticResource VisibleIfTrueConverter}, Mode=OneWay}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                                <ProgressRing IsActive="True" Width="48" Height="48" Foreground="{ThemeResource AccentBrush}"/>
                                <TextBlock Text="{loc:Str Key=PlatformDetails_Importing_Text}" HorizontalAlignment="Center" Foreground="{ThemeResource TextBrush}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Ficha de la plataforma. -->
                <Grid x:Name="StatsPanel" Grid.Row="2" Margin="0 12 0 0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                    <!-- Ficha de plataforma: filas etiqueta/valor homogéneas. El orden, las etiquetas y qué
                         filas aparecen (solo las no vacías) los decide Platform.SetMetadata; aquí solo se itera.
                         El separador se dibuja entre filas (la última no lo pinta: ShowSeparator). -->
                    <ItemsControl ItemsSource="{x:Bind ViewModel.SharedDataService.SelectedPlatform.Metadata, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <!-- Binding clásico (no x:Bind): x:DataType no referencia tipos anidados como
                                 Platform.PlatformMetadataField, y el binding por reflexión es trivial para ~9 filas. -->
                            <DataTemplate>
                                <StackPanel Margin="0 8 0 0">
                                    <StackPanel Padding="20 0">
                                        <TextBlock Text="{Binding Label}" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Value}" Foreground="{ThemeResource TextBrush}" FontSize="15" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <template:SeparatorEx Margin="0 8 0 0" Thickness="1" UseGradient="True" Visibility="{Binding ShowSeparator, Converter={StaticResource VisibleIfTrueConverter}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Gráficas de cobertura de los tipos de imagen PROPIOS de las plataformas (FlipView configurable). -->
                <Grid x:Name="CoveragePanel" Grid.Row="3" Height="400" Margin="0 24 0 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- FlipView de las 4 gráficas de cobertura. -->
                    <FlipView x:Name="CoverageChartFlipView" Grid.Row="0" Background="Transparent" UseTouchAnimationsForAllNavigation="False" SelectedIndex="{x:Bind ViewModel.SelectedChartIndex, Mode=TwoWay}" Margin="8 0">
                        <!-- 1: cobertura de tipos propios por plataforma (área), con la plataforma seleccionada resaltada. -->
                        <FlipViewItem>
                            <uc:WidgetStatCardControl VisualStyle="LateralAccentBar" ColorVariant="ThemeAccent" ContentVerticalAlignment="Stretch">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{loc:Str Key=PlatformDetails_CoverageByPlatform_Title}" Margin="0 8" Style="{StaticResource TitleStyle}"/>
                                        <Button Grid.Column="1" x:Name="CoverageByPlatformHelpButton" Style="{StaticResource Button_Icon}" Click="CoverageByPlatformHelp_Click" VerticalAlignment="Center" Margin="8 8 0 0" Padding="8" help:Help.AffordanceVisible="True" help:Help.Key="Common_Help_Tooltip">
                                            <FontIcon Glyph="&#xE897;" FontSize="16"/>
                                        </Button>
                                        <TeachingTip Grid.Column="1" x:Name="CoverageByPlatformHelpTip" Target="{x:Bind CoverageByPlatformHelpButton}" IsLightDismissEnabled="True" PreferredPlacement="BottomLeft" Title="{loc:Str Key=PlatformDetails_CoverageByPlatform_Title}" Subtitle="{loc:Str Key=PlatformDetails_CoverageByPlatform_Help}"/>
                                    </Grid>
                                    <template:SeparatorEx Grid.Row="1" Margin="0 8 0 12" VerticalAlignment="Bottom" Thickness="1" UseGradient="True"/>
                                    <lvc:CartesianChart Grid.Row="2" x:Name="CoverageByPlatformChart"
                                    Series="{x:Bind ViewModel.CoverageByPlatformSeries, Mode=OneWay}"
                                    XAxes="{x:Bind ViewModel.CoverageByPlatformXAxes, Mode=OneWay}"
                                    YAxes="{x:Bind ViewModel.CoverageByPlatformYAxes, Mode=OneWay}"
                                    Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" LegendPosition="Hidden"
                                    Visibility="{x:Bind ViewModel.HasCoverageByPlatformData, Mode=OneWay, Converter={StaticResource VisibleIfTrueConverter}}"/>
                                </Grid>
                            </uc:WidgetStatCardControl>
                        </FlipViewItem>
                        <!-- 2: distribución (nº de plataformas por tramo de cobertura de tipos propios). -->
                        <FlipViewItem>
                            <uc:WidgetStatCardControl VisualStyle="LateralAccentBar" ColorVariant="ThemeAccent" ContentVerticalAlignment="Stretch">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <uc:ChartTypeSelectorControl Grid.Row="1" Title="{loc:Str Key=PlatformDetails_CoverageDistribution_Title}" HelpText="{loc:Str Key=PlatformDetails_CoverageDistribution_Help}" Values="{x:Bind ViewModel.CoverageDistributionValues, Mode=OneWay}" Labels="{x:Bind ViewModel.CoverageDistributionLabels, Mode=OneWay}" LabelsRotation="0" SelectedChartType="{x:Bind ViewModel.CoverageDistributionChart.ChartType, Mode=TwoWay}" SortOrder="{x:Bind ViewModel.CoverageDistributionChart.SortOrder, Mode=TwoWay}" TopN="{x:Bind ViewModel.CoverageDistributionChart.TopN, Mode=TwoWay}"/>
                                </Grid>
                            </uc:WidgetStatCardControl>
                        </FlipViewItem>
                        <!-- 3: % de plataformas que tienen cada tipo de imagen propia. -->
                        <FlipViewItem>
                            <uc:WidgetStatCardControl VisualStyle="LateralAccentBar" ColorVariant="ThemeAccent" ContentVerticalAlignment="Stretch">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <uc:ChartTypeSelectorControl Grid.Row="1" Title="{loc:Str Key=PlatformDetails_CoverageByType_Title}" HelpText="{loc:Str Key=PlatformDetails_CoverageByType_Help}" Values="{x:Bind ViewModel.CoverageByTypeValues, Mode=OneWay}" Labels="{x:Bind ViewModel.CoverageByTypeLabels, Mode=OneWay}" ValueSuffix="%" ValueMax="100" LabelsRotation="45" SelectedChartType="{x:Bind ViewModel.CoverageByTypeChart.ChartType, Mode=TwoWay}" SortOrder="{x:Bind ViewModel.CoverageByTypeChart.SortOrder, Mode=TwoWay}" TopN="{x:Bind ViewModel.CoverageByTypeChart.TopN, Mode=TwoWay}"/>
                                </Grid>
                            </uc:WidgetStatCardControl>
                        </FlipViewItem>
                        <!-- 4: nº total de imágenes propias por tipo en todas las plataformas (referencia = nº de plataformas). -->
                        <FlipViewItem>
                            <uc:WidgetStatCardControl VisualStyle="LateralAccentBar" ColorVariant="ThemeAccent" ContentVerticalAlignment="Stretch">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <uc:ChartTypeSelectorControl Grid.Row="1" Title="{loc:Str Key=PlatformDetails_MediaSetByType_Title}" HelpText="{loc:Str Key=PlatformDetails_MediaSetByType_Help}" Values="{x:Bind ViewModel.ImagesByTypeValues, Mode=OneWay}" Labels="{x:Bind ViewModel.ImagesByTypeLabels, Mode=OneWay}" ReferenceValue="{x:Bind ViewModel.PlatformCount, Mode=OneWay}" LabelsRotation="45" SelectedChartType="{x:Bind ViewModel.ImagesByTypeChart.ChartType, Mode=TwoWay}" SortOrder="{x:Bind ViewModel.ImagesByTypeChart.SortOrder, Mode=TwoWay}" TopN="{x:Bind ViewModel.ImagesByTypeChart.TopN, Mode=TwoWay}"/>
                                </Grid>
                            </uc:WidgetStatCardControl>
                        </FlipViewItem>
                    </FlipView>

                    <!-- Indicador del nº de gráficas y página actual del FlipView. -->
                    <PipsPager Grid.Row="1" HorizontalAlignment="Center" Margin="0 4 0 0" NumberOfPages="4" SelectedPageIndex="{x:Bind CoverageChartFlipView.SelectedIndex, Mode=TwoWay}"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

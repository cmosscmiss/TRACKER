<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MM4LB.Controls.Views.StatsGlobalControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="using:MM4LB.Controls.Views"
    xmlns:loc="using:MM4LB.Markup"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Gráficas comparativas entre plataformas (la plataforma seleccionada va resaltada) -->
        <FlipView x:Name="ChartFlipView" Grid.Row="0" Background="Transparent" UseTouchAnimationsForAllNavigation="False" SelectedIndex="{x:Bind ViewModel.SelectedChartIndex, Mode=TwoWay}">
            <!-- Gráfica 1: juegos por plataforma, tres series apiladas (colección / LaunchBox / sólo colección) -->
            <FlipViewItem>
                <uc:WidgetStatCardControl VisualStyle="LateralAccentBar" ColorVariant="ThemeAccent" ContentVerticalAlignment="Stretch">
                    <uc:ChartTypeSelectorControl Title="{loc:Str Key=StatsGlobal_GameSetCollection_Title}" HelpText="{loc:Str Key=StatsGlobal_GameSetCollection_Help}" SeriesValues="{x:Bind ViewModel.GamesAuditByPlatformSeries, Mode=OneWay}" SeriesNames="{x:Bind ViewModel.GamesAuditSeries, Mode=OneWay}" Labels="{x:Bind ViewModel.PlatformLabels, Mode=OneWay}" ValueFormat="0" ValueSuffix="%" ValueMax="100" SelectedChartType="{x:Bind ViewModel.GameSetChart.ChartType, Mode=TwoWay}" SortOrder="{x:Bind ViewModel.GameSetChart.SortOrder, Mode=TwoWay}" TopN="{x:Bind ViewModel.GameSetChart.TopN, Mode=TwoWay}"/>
                </uc:WidgetStatCardControl>
            </FlipViewItem>
            <!-- Gráfica 2: nº de juegos por plataforma -->
            <FlipViewItem>
                <uc:WidgetStatCardControl VisualStyle="LateralAccentBar" ColorVariant="ThemeAccent" ContentVerticalAlignment="Stretch">
                    <uc:ChartTypeSelectorControl Title="{loc:Str Key=StatsGlobal_GameSet_Title}" HelpText="{loc:Str Key=StatsGlobal_GameSet_Help}" Values="{x:Bind ViewModel.GamesByPlatformValues, Mode=OneWay}" Labels="{x:Bind ViewModel.PlatformLabels, Mode=OneWay}" HighlightIndex="{x:Bind ViewModel.HighlightIndex, Mode=OneWay}" SelectedChartType="{x:Bind ViewModel.GameCountChart.ChartType, Mode=TwoWay}" SortOrder="{x:Bind ViewModel.GameCountChart.SortOrder, Mode=TwoWay}" TopN="{x:Bind ViewModel.GameCountChart.TopN, Mode=TwoWay}"/>
                </uc:WidgetStatCardControl>
            </FlipViewItem>
            <!-- Gráfica 3: nº de imágenes por plataforma -->
            <FlipViewItem>
                <uc:WidgetStatCardControl VisualStyle="LateralAccentBar" ColorVariant="ThemeAccent" ContentVerticalAlignment="Stretch">
                    <uc:ChartTypeSelectorControl Title="{loc:Str Key=StatsGlobal_ImageSet_Title}" HelpText="{loc:Str Key=StatsGlobal_ImageSet_Help}" Values="{x:Bind ViewModel.ImagesByPlatformValues, Mode=OneWay}" Labels="{x:Bind ViewModel.PlatformLabels, Mode=OneWay}" HighlightIndex="{x:Bind ViewModel.HighlightIndex, Mode=OneWay}" SelectedChartType="{x:Bind ViewModel.ImageCountChart.ChartType, Mode=TwoWay}" SortOrder="{x:Bind ViewModel.ImageCountChart.SortOrder, Mode=TwoWay}" TopN="{x:Bind ViewModel.ImageCountChart.TopN, Mode=TwoWay}"/>
                </uc:WidgetStatCardControl>
            </FlipViewItem>
            <!-- Gráfica 3: tamaño en disco (GB) por plataforma -->
            <FlipViewItem>
                <uc:WidgetStatCardControl VisualStyle="LateralAccentBar" ColorVariant="ThemeAccent" ContentVerticalAlignment="Stretch">
                    <uc:ChartTypeSelectorControl Title="{loc:Str Key=StatsGlobal_ImageSetSize_Title}" HelpText="{loc:Str Key=StatsGlobal_ImageSetSize_Help}" Values="{x:Bind ViewModel.SizeByPlatformValues, Mode=OneWay}" Labels="{x:Bind ViewModel.PlatformLabels, Mode=OneWay}" HighlightIndex="{x:Bind ViewModel.HighlightIndex, Mode=OneWay}" ValueFormat="0.#" ValueSuffix=" GB" SelectedChartType="{x:Bind ViewModel.ImageSizeChart.ChartType, Mode=TwoWay}" SortOrder="{x:Bind ViewModel.ImageSizeChart.SortOrder, Mode=TwoWay}" TopN="{x:Bind ViewModel.ImageSizeChart.TopN, Mode=TwoWay}"/>
                </uc:WidgetStatCardControl>
            </FlipViewItem>            
        </FlipView>

        <!-- Indicador del nº de gráficas y página actual del FlipView -->
        <PipsPager Grid.Row="1" HorizontalAlignment="Center" Margin="0 4" NumberOfPages="4" SelectedPageIndex="{x:Bind ChartFlipView.SelectedIndex, Mode=TwoWay}"/>
        
        <!-- Pastillas: valor de la plataforma seleccionada / total de todas las plataformas -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <uc:WidgetStatCardControl Grid.Column="0" VisualStyle="SplitPanel" ColorVariant="ThemeAccent" Glyph="&#xE7FC;" IconCollapsePillCount="3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <uc:WidgetStatCardControl Grid.Column="0" VisualStyle="SplitPanel" ColorVariant="ThemeAccent" Label="{x:Bind ViewModel.GamesAuditStats.InCollection.Title, Mode=OneWay}" Value="{x:Bind ViewModel.GamesAuditStats.InCollection.ValueText, Mode=OneWay}" Description="{x:Bind ViewModel.GamesAuditStats.InCollection.Description, Mode=OneWay}" HasBorder="False"/>
                    <uc:WidgetStatCardControl Grid.Column="1" VisualStyle="SplitPanel" ColorVariant="ThemeAccent" Label="{x:Bind ViewModel.GamesAuditStats.InLaunchBox.Title, Mode=OneWay}" Value="{x:Bind ViewModel.GamesAuditStats.InLaunchBox.ValueText, Mode=OneWay}" Description="{x:Bind ViewModel.GamesAuditStats.InLaunchBox.Description, Mode=OneWay}" HasBorder="False"/>
                    <uc:WidgetStatCardControl Grid.Column="2" VisualStyle="SplitPanel" ColorVariant="ThemeAccent" Label="{x:Bind ViewModel.GamesAuditStats.NotInLaunchBox.Title, Mode=OneWay}" Value="{x:Bind ViewModel.GamesAuditStats.NotInLaunchBox.ValueText, Mode=OneWay}" Description="{x:Bind ViewModel.GamesAuditStats.NotInLaunchBox.Description, Mode=OneWay}" HasBorder="False"/>
                </Grid>
            </uc:WidgetStatCardControl>
            <uc:WidgetStatCardControl Grid.Column="1" VisualStyle="SplitPanel" ColorVariant="ThemeAccent" Glyph="&#xE8B9;" IconCollapsePillCount="3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <uc:WidgetStatCardControl Grid.Column="0" VisualStyle="SplitPanel" ColorVariant="ThemeAccent" Label="{x:Bind ViewModel.ImagePills.Images.Title, Mode=OneWay}" Value="{x:Bind ViewModel.ImagePills.Images.ValueText, Mode=OneWay}" Description="{x:Bind ViewModel.ImagePills.Images.Description, Mode=OneWay}" HasBorder="False"/>
                    <uc:WidgetStatCardControl Grid.Column="1" VisualStyle="SplitPanel" ColorVariant="ThemeAccent" Label="{x:Bind ViewModel.ImagePills.Size.Title, Mode=OneWay}" Value="{x:Bind ViewModel.ImagePills.Size.ValueText, Mode=OneWay}" Description="{x:Bind ViewModel.ImagePills.Size.Description, Mode=OneWay}" HasBorder="False"/>
                </Grid>
            </uc:WidgetStatCardControl>
        </Grid>
    </Grid>
</UserControl>

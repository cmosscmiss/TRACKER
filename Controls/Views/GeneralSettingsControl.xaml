<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Tracker.Controls.Views.GeneralSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:template="using:Tracker.Controls.Templates"
    xmlns:loc="using:Tracker.Markup"
    mc:Ignorable="d">

    <!-- Página de la categoría General. -->
    <StackPanel Spacing="14">
        <!-- INTERFAZ -->
        <StackPanel Spacing="2">
            <TextBlock Text="{loc:Str Key=GeneralSettings_InterfaceSection_Header}" Style="{StaticResource GroupHeaderStyle}"/>
            <template:SeparatorEx Margin="0 4" Thickness="2" UseGradient="True" LineBrush="{ThemeResource AccentBrush}"/>
        </StackPanel>
        <StackPanel Padding="20 0" Spacing="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Str Key=GeneralSettings_Language_Label}" Style="{StaticResource FieldLabelStyle}"/>
                <ComboBox x:Name="LanguageCombo" Grid.Column="1" MinWidth="220" HorizontalAlignment="Left" ItemsSource="{Binding LanguageOptions}" DisplayMemberPath="DisplayName" SelectionChanged="OnLanguageSelectionChanged"/>
            </Grid>
            <CheckBox IsChecked="{Binding ShowWidgetHeader, Mode=TwoWay}">
                <TextBlock Text="{loc:Str Key=GeneralSettings_ShowWidgetHeader_Label}" Style="{StaticResource FieldLabelStyle}"/>
            </CheckBox>
            <CheckBox IsChecked="{Binding FooterEventViewerAlwaysVisible, Mode=TwoWay}">
                <TextBlock Text="{loc:Str Key=GeneralSettings_FooterEventViewer_Label}" Style="{StaticResource FieldLabelStyle}"/>
            </CheckBox>
        </StackPanel>

        <!-- DATOS -->
        <StackPanel Spacing="2" Margin="0 8 0 0">
            <TextBlock Text="{loc:Str Key=GeneralSettings_DataSection_Header}" Style="{StaticResource GroupHeaderStyle}"/>
            <template:SeparatorEx Margin="0 4" Thickness="2" UseGradient="True" LineBrush="{ThemeResource AccentBrush}"/>
        </StackPanel>        
        <StackPanel Padding="20 0" Spacing="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Str Key=GeneralSettings_AutoRefreshHours_Label}" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox Grid.Column="1" MinWidth="140" HorizontalAlignment="Left" InputScope="Number" Text="{Binding AutoRefreshHoursText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Str Key=GeneralSettings_DollarsPerEuro_Label}" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox Grid.Column="1" MinWidth="140" HorizontalAlignment="Left" InputScope="Number" Text="{Binding DollarsPerEuroText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Str Key=GeneralSettings_YensPerEuro_Label}" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox Grid.Column="1" MinWidth="140" HorizontalAlignment="Left" InputScope="Number" Text="{Binding YensPerEuroText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
            <CheckBox IsChecked="{Binding ExceptionLoggingEnabled, Mode=TwoWay}">
                <TextBlock Text="{loc:Str Key=GeneralSettings_LogExceptions_Label}" Style="{StaticResource FieldLabelStyle}"/>
            </CheckBox>
        </StackPanel>

        <!-- VENTANA -->
        <StackPanel Spacing="2" Margin="0 8 0 0">
            <TextBlock Text="{loc:Str Key=GeneralSettings_WindowSection_Header}" Style="{StaticResource GroupHeaderStyle}"/>
            <template:SeparatorEx Margin="0 4" Thickness="2" UseGradient="True" LineBrush="{ThemeResource AccentBrush}"/>
        </StackPanel>
        <StackPanel Padding="20 0" Spacing="8">
            <CheckBox IsChecked="{Binding MinimizeToTray, Mode=TwoWay}">
                <TextBlock Text="{loc:Str Key=GeneralSettings_MinimizeToTray_Label}" Style="{StaticResource FieldLabelStyle}"/>
            </CheckBox>
            <CheckBox IsChecked="{Binding RestoreMaximized, Mode=TwoWay}">
                <TextBlock Text="{loc:Str Key=GeneralSettings_RestoreMaximized_Label}" Style="{StaticResource FieldLabelStyle}"/>
            </CheckBox>
            <CheckBox IsChecked="{Binding StartWithWindows, Mode=TwoWay}">
                <TextBlock Text="{loc:Str Key=GeneralSettings_StartWithWindows_Label}" Style="{StaticResource FieldLabelStyle}"/>
            </CheckBox>
            <CheckBox Margin="24 0 0 0" IsChecked="{Binding StartMinimizedOnAutoStart, Mode=TwoWay}" IsEnabled="{Binding StartWithWindows}">
                <TextBlock Text="{loc:Str Key=GeneralSettings_StartMinimized_Label}" Style="{StaticResource FieldLabelStyle}"/>
            </CheckBox>
        </StackPanel>
    </StackPanel>
</UserControl>

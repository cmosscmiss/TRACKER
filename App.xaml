<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Tracker.App"
    RequestedTheme="Dark"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Tracker.Helpers">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Resources/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Converter usado por el template de ToolbarButtonIcon (Buttons.xaml). -->
            <helpers:NullToOpacityConverter x:Key="NullToOpacityConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

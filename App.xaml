<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="MM4LB.App"
    RequestedTheme="Dark"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MM4LB.Services" xmlns:helpers="using:MM4LB.Helpers">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Resources/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <helpers:BooleanToVisibilityConverter x:Key="VisibleIfTrueConverter" />
            <helpers:BooleanToVisibilityInvertedConverter x:Key="HiddenIfTrueConverter" />
            <helpers:NullToOpacityConverter x:Key="NullToOpacityConverter" />
            <helpers:BooleanToOpacityConverter x:Key="DimIfTrueConverter" />
            <helpers:PriceTrendToBrushConverter x:Key="PriceTrendToBrushConverter" />
            <helpers:BooleanToStrikethroughConverter x:Key="StrikethroughIfTrueConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
